---
import Layout from "../layouts/Layout.astro";
import { getAllGalleryImages } from "../lib/gallery";
const PHOTOS = await getAllGalleryImages();
---

<Layout title="图集" description="图片集">
	<div class="bento">
		<div class="col-12">
			<mdui-card clickable variant="filled" class="bento-card">
				<div class="card-body" style="flex-direction: row; align-items: center; gap: 12px">
					<mdui-icon-collections--outlined style="font-size: 28px; color: rgb(var(--mdui-color-primary))"></mdui-icon-collections--outlined>
					<div>
						<div style="font-weight: 700; font-size: 1.1rem">图集</div>
						<div style="font-size: 0.8rem; color: rgb(var(--mdui-color-on-surface-variant))">
							{PHOTOS.length} 张图片 · 点击放大
						</div>
					</div>
				</div>
			</mdui-card>
		</div>
	</div>

	<div class="masonry" style="margin-top: var(--blog-gap)">
		{
			PHOTOS.map((p, i) => (
				<button
					type="button"
					class="gallery-trigger"
					data-index={i}
					style="display: block; width: 100%; border: none; background: none; padding: 0; cursor: pointer"
				>
					<mdui-card clickable variant="filled" class="masonry-card reveal" style="margin-bottom: var(--blog-gap)">
						<div style="padding: 8px">
							<img
								src={p.data.src}
								alt={p.data.alt || `图集 ${p.data.order}`}
								loading="lazy"
								class="gallery-img"
							/>
						</div>
					</mdui-card>
				</button>
			))
		}
	</div>

	<!-- 悬浮灯箱 -->
	<script type="application/json" id="lightbox-data" set:html={JSON.stringify(PHOTOS.map((p) => ({ src: p.data.src, alt: p.data.alt || `图集 ${p.data.order}` })))}></script>
	<mdui-dialog id="lightbox" class="lightbox" fullscreen style="--mdui-dialog-width: 100vw">
		<div class="lightbox-stage">
			<div class="lightbox-topbar">
				<div class="lightbox-title" id="lightbox-title"></div>
				<div class="lightbox-actions">
					<a id="lightbox-original" href="#" target="_blank" rel="noreferrer" title="在新标签打开原图">
						<mdui-icon-open-in-new--outlined style="font-size: 22px"></mdui-icon-open-in-new--outlined>
					</a>
					<button type="button" class="lightbox-close" id="lightbox-close" aria-label="关闭">
						<mdui-icon-close--outlined style="font-size: 24px"></mdui-icon-close--outlined>
					</button>
				</div>
			</div>
			<div class="lightbox-content">
				<button type="button" class="lightbox-nav prev" id="lightbox-prev" aria-label="上一张">
					<mdui-icon-chevron-left--outlined style="font-size: 32px"></mdui-icon-chevron-left--outlined>
				</button>
				<figure class="lightbox-figure">
					<img id="lightbox-img" src="" alt="" class="lightbox-img" />
					<figcaption class="lightbox-caption" id="lightbox-caption"></figcaption>
				</figure>
				<button type="button" class="lightbox-nav next" id="lightbox-next" aria-label="下一张">
					<mdui-icon-chevron-right--outlined style="font-size: 32px"></mdui-icon-chevron-right--outlined>
				</button>
			</div>
			<div class="lightbox-counter" id="lightbox-counter"></div>
		</div>
	</mdui-dialog>
</Layout>

<style>
	.lightbox {
		--mdui-dialog-width: 100vw;
		--mdui-dialog-height: 100vh;
		--mdui-dialog-border-radius: 0;
		background: rgba(0, 0, 0, 0.82);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}
	.lightbox-stage {
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
		position: relative;
	}
	.lightbox-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 24px;
		flex: none;
	}
	.lightbox-title {
		font-size: 0.95rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
	}
	.lightbox-actions {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.lightbox-actions a {
		color: rgba(255, 255, 255, 0.75);
		display: inline-flex;
		padding: 6px;
		border-radius: 50%;
		transition: color 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.lightbox-actions a:hover {
		color: #fff;
		transform: scale(1.1);
	}
	.lightbox-close {
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.75);
		cursor: pointer;
		padding: 6px;
		display: inline-flex;
		border-radius: 50%;
		transition: color 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.lightbox-close:hover {
		color: #fff;
		transform: scale(1.1);
	}
	.lightbox-content {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		min-height: 0;
		padding: 0 16px;
	}
	.lightbox-figure {
		margin: 0;
		max-width: calc(100% - 120px);
		max-height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.lightbox-img {
		max-width: 100%;
		max-height: calc(100vh - 180px);
		object-fit: contain;
		border-radius: 12px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.lightbox-caption {
		margin-top: 14px;
		font-size: 0.88rem;
		color: rgba(255, 255, 255, 0.85);
		text-align: center;
	}
	.lightbox-nav {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.12);
		color: rgba(255, 255, 255, 0.9);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s ease, color 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.lightbox-nav:hover {
		background: rgba(255, 255, 255, 0.25);
		color: #fff;
		transform: scale(1.08);
	}
	.lightbox-counter {
		flex: none;
		text-align: center;
		padding: 12px;
		font-size: 0.82rem;
		color: rgba(255, 255, 255, 0.65);
		letter-spacing: 0.05em;
	}

	@media (max-width: 640px) {
		.lightbox-content {
			gap: 4px;
			padding: 0 4px;
		}
		.lightbox-figure {
			max-width: calc(100% - 80px);
		}
		.lightbox-nav {
			width: 40px;
			height: 40px;
		}
	}
</style>

<script>
	const photos = JSON.parse(
		document.getElementById("lightbox-data")?.textContent ?? "[]",
	);
	const dialog = document.getElementById("lightbox") as any;
	const img = document.getElementById("lightbox-img") as HTMLImageElement;
	const caption = document.getElementById("lightbox-caption") as HTMLElement;
	const title = document.getElementById("lightbox-title") as HTMLElement;
	const counter = document.getElementById("lightbox-counter") as HTMLElement;
	const original = document.getElementById("lightbox-original") as HTMLAnchorElement;
	let current = 0;

	const show = (index: number) => {
		current = (index + photos.length) % photos.length;
		const p = photos[current];
		img.src = p.src;
		img.alt = p.alt || `图集 ${current + 1}`;
		caption.textContent = p.alt || "";
		title.textContent = p.alt || `图片 ${current + 1}`;
		counter.textContent = `${current + 1} / ${photos.length}`;
		original.href = p.src;
	};

	const openAt = (index: number) => {
		show(index);
		dialog.open = true;
	};

	document.querySelectorAll<HTMLElement>(".gallery-trigger").forEach((el) => {
		el.addEventListener("click", () => {
			openAt(Number(el.dataset.index));
		});
	});

	document.getElementById("lightbox-close")?.addEventListener("click", () => {
		dialog.open = false;
	});
	document.getElementById("lightbox-prev")?.addEventListener("click", () => show(current - 1));
	document.getElementById("lightbox-next")?.addEventListener("click", () => show(current + 1));

	// 键盘导航
	document.addEventListener("keydown", (e) => {
		if (!dialog.open) return;
		if (e.key === "ArrowLeft") show(current - 1);
		else if (e.key === "ArrowRight") show(current + 1);
	});
</script>
