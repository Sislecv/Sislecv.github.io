---
import Layout from "../layouts/Layout.astro";

const PHOTOS = [
	{ seed: "sislecv-1", w: 600, h: 420 },
	{ seed: "sislecv-2", w: 420, h: 560 },
	{ seed: "sislecv-3", w: 560, h: 420 },
	{ seed: "sislecv-4", w: 420, h: 420 },
	{ seed: "sislecv-5", w: 600, h: 400 },
	{ seed: "sislecv-6", w: 400, h: 600 },
	{ seed: "sislecv-7", w: 560, h: 560 },
	{ seed: "sislecv-8", w: 420, h: 320 },
	{ seed: "sislecv-9", w: 600, h: 450 },
	{ seed: "sislecv-10", w: 450, h: 450 },
	{ seed: "sislecv-11", w: 520, h: 390 },
	{ seed: "sislecv-12", w: 390, h: 520 },
];
---

<Layout title="图集" description="图片集">
	<div class="bento">
		<div class="col-12">
			<mdui-card clickable variant="filled" class="bento-card">
				<div class="card-body" style="flex-direction: row; align-items: center; gap: 12px">
					<mdui-icon-collections--outlined style="font-size: 28px; color: rgb(var(--mdui-color-primary))"></mdui-icon-collections--outlined>
					<div>
						<div style="font-weight: 700; font-size: 1.1rem">图集</div>
						<div style="font-size: 0.8rem; color: rgb(var(--mdui-color-on-surface-variant))">
							{PHOTOS.length} 张图片
						</div>
					</div>
				</div>
			</mdui-card>
		</div>
	</div>

	<div class="masonry" style="margin-top: var(--blog-gap)">
		{
			PHOTOS.map((p) => (
				<a
					href={`https://picsum.photos/seed/${p.seed}/${p.w}/${p.h}`}
					target="_blank"
					rel="noreferrer"
					style="display: block"
				>
					<mdui-card clickable variant="filled" class="masonry-card reveal" style="margin-bottom: var(--blog-gap)">
						<div style="padding: 8px">
							<img
								src={`https://picsum.photos/seed/${p.seed}/${p.w}/${p.h}`}
								alt={`图集 ${p.seed}`}
								loading="lazy"
								class="gallery-img"
								width={p.w}
								height={p.h}
							/>
						</div>
					</mdui-card>
				</a>
			))
		}
	</div>
</Layout>
