---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404">
	<div class="bento">
		<div class="col-8">
			<mdui-card clickable variant="elevated" class="bento-card">
				<div class="card-body" style="align-items: center; text-align: center; padding: 56px 20px">
					<mdui-icon-error--outlined style="font-size: 60px; color: var(--mdui-color-error)"></mdui-icon-error--outlined>
					<div style="font-size: 2.8rem; font-weight: 700; margin: 12px 0 4px">404</div>
					<p style="color: var(--mdui-color-on-surface-variant); margin: 0 0 20px">
						页面不存在或已被移动
					</p>
					<mdui-button variant="filled" href="/">返回首页</mdui-button>
				</div>
			</mdui-card>
		</div>

		<div class="col-4" style="display: flex; flex-direction: column; gap: var(--blog-gap)">
			<mdui-card clickable href="/search/" variant="filled" class="bento-card">
				<div class="card-body" style="align-items: center; text-align: center; justify-content: center; gap: 8px; padding: 28px 16px">
					<mdui-icon-search--outlined style="font-size: 32px; color: var(--mdui-color-primary)"></mdui-icon-search--outlined>
					<div style="font-weight: 600">搜索</div>
				</div>
			</mdui-card>
			<mdui-card clickable href="/archive/" variant="filled" class="bento-card">
				<div class="card-body" style="align-items: center; text-align: center; justify-content: center; gap: 8px; padding: 28px 16px">
					<mdui-icon-history--outlined style="font-size: 32px; color: var(--mdui-color-primary)"></mdui-icon-history--outlined>
					<div style="font-weight: 600">归档</div>
				</div>
			</mdui-card>
		</div>
	</div>
</Layout>
