---
import Layout from "../layouts/Layout.astro";
import { SITE, SOCIAL_LINKS, AVATAR } from "../consts";
---

<Layout title="关于" description="关于我">
	<div class="bento">
		<div class="col-8">
			<mdui-card clickable variant="filled" class="bento-card about-main-card">
				<div class="card-body" style="padding: 32px; position: relative; z-index: 2;">
					<h1 class="about-title">
						<mdui-icon-person--outlined class="about-title-icon"></mdui-icon-person--outlined>
						关于我
					</h1>
					<div class="mdui-prose about-prose">
						<p>你好，我是 <strong>{SITE.author}</strong>。欢迎来到我的个人博客。</p>
						<p>这里记录我折腾代码与数字体验的思考与实践。</p>
						<p>博客使用 Astro + MDUI (Material Design 3) 构建，Bento 极简纯色设计，部署于 GitHub Pages。</p>
					</div>
					<div style="display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap">
						{
							SOCIAL_LINKS.map((link) => (
								<a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
									<mdui-button variant="tonal">
										{
											link.label === "GitHub" && (
												<svg slot="icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
													<path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
												</svg>
											)
										}
										{
											link.label === "RSS" && (
												<mdui-icon-rss-feed--outlined slot="icon" style="font-size: 18px"></mdui-icon-rss-feed--outlined>
											)
										}
										{link.label}
									</mdui-button>
								</a>
							))
						}
					</div>
				</div>
			</mdui-card>
		</div>

		<div class="col-4" style="display: flex; flex-direction: column; gap: var(--blog-gap)">
			<mdui-card clickable variant="filled" class="bento-card about-side-profile">
				<div class="card-body" style="align-items: center; text-align: center; padding: 28px 18px; gap: 10px; position: relative; z-index: 2;">
					<img
						src={AVATAR}
						alt={SITE.author}
						width="84"
						height="84"
						class="about-avatar"
					/>
					<div class="about-profile-name">{SITE.author}</div>
					<div class="about-profile-desc">
						{SITE.description}
					</div>
				</div>
			</mdui-card>

			<mdui-card clickable href="/archive/" variant="filled" class="bento-card about-side-action">
				<div class="card-body" style="align-items: center; text-align: center; justify-content: center; gap: 8px; padding: 20px">
					<mdui-icon-edit--outlined style="font-size: 32px"></mdui-icon-edit--outlined>
					<div style="font-weight: 700; font-size: 1rem">浏览全部文章</div>
				</div>
			</mdui-card>
		</div>
	</div>
</Layout>

<style>
	.about-main-card,
	.about-side-profile,
	.about-side-action {
		position: relative;
		overflow: hidden;
		border: none !important;
		outline: none !important;
	}

	.about-watermark {
		position: absolute;
		right: 14px;
		bottom: -18px;
		font-family: var(--font-double-line), monospace;
		font-size: 5.5rem;
		font-weight: 400;
		line-height: 0.85;
		letter-spacing: 0.05em;
		opacity: 0.05;
		pointer-events: none;
		user-select: none;
		transition: opacity 0.3s ease;
	}

	.about-main-card:hover .about-watermark,
	.about-side-profile:hover .about-watermark {
		opacity: 0.09;
	}

	/* Main Card: Soft Sage / Cream */
	.about-main-card {
		background: #e5ebe4 !important;
		color: #172619 !important;
	}
	:global(.mdui-theme-dark) .about-main-card {
		background: #1c261e !important;
		color: #e5ebe4 !important;
	}
	.about-main-card .about-watermark {
		color: #172619;
	}
	:global(.mdui-theme-dark) .about-main-card .about-watermark {
		color: #e5ebe4;
	}

	.about-title {
		margin: 0 0 16px;
		font-size: 1.6rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		gap: 10px;
		letter-spacing: -0.02em;
	}
	.about-title-icon {
		font-size: 28px;
	}

	/* Side Profile Card: Soft Lilac */
	.about-side-profile {
		background: #ede7f6 !important;
		color: #2a1140 !important;
	}
	:global(.mdui-theme-dark) .about-side-profile {
		background: #241a2f !important;
		color: #ede7f6 !important;
	}
	.about-side-profile .about-watermark {
		color: #2a1140;
	}
	:global(.mdui-theme-dark) .about-side-profile .about-watermark {
		color: #ede7f6;
	}

	.about-profile-name {
		font-family: var(--font-display), var(--font-sans);
		font-weight: 800;
		font-size: 1.3rem;
		letter-spacing: -0.02em;
	}
	.about-profile-desc {
		font-size: 0.82rem;
		opacity: 0.8;
	}

	/* Side Action Card: Warm Honey */
	.about-side-action {
		background: #fef3e2 !important;
		color: #382402 !important;
	}
	:global(.mdui-theme-dark) .about-side-action {
		background: #2e2416 !important;
		color: #fef3e2 !important;
	}

	.about-avatar {
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.05);
		outline: 1px solid rgba(0, 0, 0, 0.1);
		transition: transform var(--md-duration-short, 150ms) var(--md-easing-standard, ease);
	}
	:global(.mdui-theme-dark) .about-avatar {
		background: rgba(255, 255, 255, 0.08);
		outline: 1px solid rgba(255, 255, 255, 0.15);
	}
	.about-side-profile:hover .about-avatar {
		transform: scale(1.05);
	}
</style>
