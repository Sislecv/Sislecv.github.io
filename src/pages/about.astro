---
import Layout from "../layouts/Layout.astro";
import { SITE, SOCIAL_LINKS } from "../consts";
---

<Layout title="关于" description="关于我">
	<div class="bento">
		<div class="col-8">
			<mdui-card clickable variant="elevated" class="bento-card">
				<div class="card-body" style="padding: 28px">
					<h1 style="margin: 0 0 12px; font-size: 1.5rem; display: flex; align-items: center; gap: 8px">
						<mdui-icon-person--outlined style="color: var(--mdui-color-primary)"></mdui-icon-person--outlined>
						关于我
					</h1>
					<div class="mdui-prose">
						<p>你好，我是 {SITE.author}。欢迎来到我的博客。</p>
						<p>这里记录我折腾代码与技术的过程。</p>
						<p>博客使用 Astro + MDUI (Material Design 3) 构建，Bento 卡片式布局，部署于 GitHub Pages。</p>
					</div>
					<div style="display: flex; gap: 8px; margin-top: 20px; flex-wrap: wrap">
						{
							SOCIAL_LINKS.map((link) => (
								<a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
									<mdui-button variant="tonal">
										{
											link.label === "GitHub" && (
												<svg slot="icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
													<path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
												</svg>
											)
										}
										{
											link.label === "RSS" && (
												<mdui-icon-rss-feed--outlined slot="icon" style="font-size: 18px"></mdui-icon-rss-feed--outlined>
											)
										}
										{link.label}
									</mdui-button>
								</a>
							))
						}
					</div>
				</div>
			</mdui-card>
		</div>

		<div class="col-4" style="display: flex; flex-direction: column; gap: var(--blog-gap)">
			<mdui-card clickable variant="filled" class="bento-card">
				<div class="card-body" style="align-items: center; text-align: center; padding: 24px 16px; gap: 10px">
					<img
						src="/favicon/favicon-light-192.png"
						alt={SITE.author}
						width="80"
						height="80"
						class="about-avatar"
					/>
					<div style="font-weight: 700; font-size: 1.15rem">{SITE.author}</div>
					<div style="font-size: 0.82rem; color: var(--mdui-color-on-surface-variant)">
						{SITE.description}
					</div>
				</div>
			</mdui-card>

			<mdui-card clickable href="/archive/" variant="filled" class="bento-card">
				<div class="card-body" style="align-items: center; text-align: center; justify-content: center; gap: 6px">
					<mdui-icon-edit--outlined style="font-size: 30px; color: var(--mdui-color-primary)"></mdui-icon-edit--outlined>
					<div style="font-weight: 600">浏览文章</div>
				</div>
			</mdui-card>
		</div>
	</div>
</Layout>

<style>
	.about-avatar {
		border-radius: 50%;
		background: var(--mdui-color-surface-container-highest);
		outline: 1px solid rgba(var(--mdui-color-outline), 0.2);
		transition: transform var(--md-duration-short, 150ms) var(--md-easing-standard, ease);
	}
	.bento-card:hover .about-avatar {
		transform: scale(1.04);
	}
</style>
