---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, getTags } from "../lib/posts";

const posts = await getAllPosts();
const tags = [...getTags(posts).entries()];
---

<Layout title="标签" description={`共 ${tags.length} 个标签`}>
	<div class="bento">
		{
			tags.map(([tag, count]) => (
				<div class="col-3">
					<mdui-card clickable href={`/tags/${encodeURIComponent(tag)}/`} variant="filled" class="bento-card reveal">
						<div class="card-body" style="align-items: center; text-align: center; justify-content: center; gap: 8px; padding: 20px 12px">
							<mdui-icon-tag--outlined style="font-size: 30px; color: var(--mdui-color-primary)"></mdui-icon-tag--outlined>
							<div style="font-weight: 600">{tag}</div>
							<div style="font-size: 0.75rem; color: var(--mdui-color-on-surface-variant)">
								{count} 篇
							</div>
						</div>
					</mdui-card>
				</div>
			))
		}
		{
			tags.length === 0 && (
				<div class="col-12">
					<mdui-card variant="filled">
						<div class="card-body" style="align-items: center; text-align: center; padding: 48px 20px">
							<div style="font-weight: 600">暂无标签</div>
						</div>
					</mdui-card>
				</div>
			)
		}
	</div>
</Layout>
