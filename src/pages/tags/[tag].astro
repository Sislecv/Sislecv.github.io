---
import Layout from "../../layouts/Layout.astro";
import { getAllPosts } from "../../lib/posts";
import PostCard from "../../components/PostCard.astro";
import "@mdui/icons/tag--outlined.js";

export async function getStaticPaths() {
	const posts = await getAllPosts();
	const tags = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags) tags.add(tag);
	}
	return [...tags].map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<Layout title={`标签: ${tag}`} description={`标签 ${tag} 下的文章`}>
	<div class="bento">
		<div class="col-12">
			<mdui-card clickable variant="filled" class="bento-card">
				<div class="card-body" style="flex-direction: row; align-items: center; gap: 12px">
					<mdui-icon-tag--outlined style="font-size: 28px; color: var(--mdui-color-primary)"></mdui-icon-tag--outlined>
					<div>
						<div style="font-weight: 700; font-size: 1.1rem">{tag}</div>
						<div style="font-size: 0.8rem; color: var(--mdui-color-on-surface-variant)">{posts.length} 篇</div>
					</div>
				</div>
			</mdui-card>
		</div>
		{
			posts.map((post) => (
				<div class="col-4">
					<PostCard post={post} />
				</div>
			))
		}
	</div>
</Layout>
