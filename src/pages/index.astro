---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, getCategories } from "../lib/posts";
import ProfileCard from "../components/ProfileCard.astro";
import AppearanceCard from "../components/AppearanceCard.astro";
import ContributionCard from "../components/ContributionCard.astro";
import EmojiCard from "../components/EmojiCard.astro";
import SearchCard from "../components/SearchCard.astro";
import TagCloudCard from "../components/TagCloudCard.astro";
import TechStackCard from "../components/TechStackCard.astro";
import MasonryPostCard from "../components/MasonryPostCard.astro";
import "@mdui/icons/folder--outlined.js";
import "@mdui/icons/history--outlined.js";
import "@mdui/icons/tag--outlined.js";

const posts = await getAllPosts();
const categories = [...getCategories(posts).entries()];
---

<Layout showFooterNav={false}>
	<div class="bento-8">
		<div class="span-3">
			<ProfileCard />
		</div>

		<div class="span-3">
			<AppearanceCard />
		</div>

		<div class="span-2">
			<EmojiCard />
		</div>

		<div class="span-8">
			<ContributionCard posts={posts} />
		</div>

		<div class="span-4">
			<div class="sq-group">
				<SearchCard />

				<mdui-card clickable href="/archive/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-history--outlined style="font-size: 34px; color: var(--mdui-color-primary)"></mdui-icon-history--outlined>
					</div>
				</mdui-card>

				<mdui-card clickable href="/archive/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-folder--outlined style="font-size: 34px; color: var(--mdui-color-primary)"></mdui-icon-folder--outlined>
					</div>
				</mdui-card>

				<mdui-card clickable href="/tags/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-tag--outlined style="font-size: 34px; color: var(--mdui-color-primary)"></mdui-icon-tag--outlined>
					</div>
				</mdui-card>
			</div>
		</div>

		<div class="span-2">
			<TagCloudCard posts={posts} />
		</div>

		<div class="span-2">
			<TechStackCard />
		</div>
	</div>

	{
		posts.length > 0 && (
			<div class="masonry" style="margin-top: var(--blog-gap)">
				{
					posts.map((post) => <MasonryPostCard post={post} />)
				}
			</div>
		)
	}
</Layout>
