---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, getCategories } from "../lib/posts";
import ProfileCard from "../components/ProfileCard.astro";
import AppearanceCard from "../components/AppearanceCard.astro";
import ContributionCard from "../components/ContributionCard.astro";
import EmojiCard from "../components/EmojiCard.astro";
import SearchCard from "../components/SearchCard.astro";
import TagCloudCard from "../components/TagCloudCard.astro";
import MasonryPostCard from "../components/MasonryPostCard.astro";
import "@mdui/icons/folder--outlined.js";
import "@mdui/icons/history--outlined.js";
import "@mdui/icons/tag--outlined.js";

const posts = await getAllPosts();
const categories = [...getCategories(posts).entries()];
---

<Layout showFooterNav={false}>
	<div class="bento-8">
		<div class="span-4">
			<ProfileCard />
		</div>

		<div class="span-2">
			<AppearanceCard />
		</div>

		<div class="span-2">
			<EmojiCard />
		</div>

		<div class="span-8">
			<ContributionCard posts={posts} />
		</div>

		<div class="span-4">
			<div class="sq-group">
				<SearchCard />

				<a href="/archive/" style="display: block; height: 100%">
					<mdui-card clickable variant="filled" class="bento-card sq-card">
						<div class="sq-body">
							<mdui-icon-history--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-history--outlined>
						</div>
					</mdui-card>
				</a>

				<a href="/archive/" style="display: block; height: 100%">
					<mdui-card clickable variant="filled" class="bento-card sq-card">
						<div class="sq-body">
							<mdui-icon-folder--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-folder--outlined>
						</div>
					</mdui-card>
				</a>

				<a href="/tags/" style="display: block; height: 100%">
					<mdui-card clickable variant="filled" class="bento-card sq-card">
						<div class="sq-body">
							<mdui-icon-tag--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-tag--outlined>
						</div>
					</mdui-card>
				</a>
			</div>
		</div>

		<div class="span-4">
			<TagCloudCard posts={posts} />
		</div>
	</div>

	{
		posts.length > 0 && (
			<div class="masonry" style="margin-top: var(--blog-gap)">
				{
					posts.map((post) => <MasonryPostCard post={post} />)
				}
			</div>
		)
	}
</Layout>
