---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, getCategories } from "../lib/posts";
import ProfileCard from "../components/ProfileCard.astro";
import AppearanceCard from "../components/AppearanceCard.astro";
import ContributionCard from "../components/ContributionCard.astro";
import EmojiCard from "../components/EmojiCard.astro";
import SearchCard from "../components/SearchCard.astro";
import TagCloudCard from "../components/TagCloudCard.astro";
import TechStackCard from "../components/TechStackCard.astro";
import GalleryStackCard from "../components/GalleryStackCard.astro";
import GitHubProjectsCard from "../components/GitHubProjectsCard.astro";
import CustomCard from "../components/CustomCard.astro";
import MasonryPostCard from "../components/MasonryPostCard.astro";
import { homeTiles, customCards } from "../site.config";

const posts = await getAllPosts();
const categories = [...getCategories(posts).entries()];
---

<Layout showFooterNav={false}>
	<div class="grid-toolbar">
		<mdui-button id="layout-lock" variant="tonal">
			<mdui-icon-lock-open--outlined slot="icon" id="lock-open-icon" style="display: none"></mdui-icon-lock-open--outlined>
			<mdui-icon-lock--outlined slot="icon" id="lock-icon"></mdui-icon-lock--outlined>
			<span id="lock-label">锁定布局</span>
		</mdui-button>
	</div>
	<div class="grid-stack" id="home-grid">
		{homeTiles.includes("profile") && (
		<div class="grid-stack-item" gs-id="profile" gs-x="0" gs-y="0" gs-w="3" gs-h="3">
			<div class="grid-stack-item-content"><ProfileCard /></div>
		</div>
		)}
		{homeTiles.includes("appearance") && (
		<div class="grid-stack-item" gs-id="appearance" gs-x="3" gs-y="0" gs-w="3" gs-h="3">
			<div class="grid-stack-item-content"><AppearanceCard /></div>
		</div>
		)}
		{homeTiles.includes("emoji") && (
		<div class="grid-stack-item" gs-id="emoji" gs-x="6" gs-y="0" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content"><EmojiCard /></div>
		</div>
		)}
		{homeTiles.includes("contribution") && (
		<div class="grid-stack-item" gs-id="contribution" gs-x="0" gs-y="3" gs-w="8" gs-h="2">
			<div class="grid-stack-item-content"><ContributionCard posts={posts} /></div>
		</div>
		)}
		{homeTiles.includes("search") && (
		<div class="grid-stack-item" gs-id="search" gs-x="0" gs-y="6" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content"><SearchCard /></div>
		</div>
		)}
		{homeTiles.includes("archive") && (
		<div class="grid-stack-item" gs-id="archive" gs-x="2" gs-y="6" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/archive/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-history--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-history--outlined>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("category") && (
		<div class="grid-stack-item" gs-id="category" gs-x="4" gs-y="6" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/archive/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-folder--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-folder--outlined>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("tags") && (
		<div class="grid-stack-item" gs-id="tags" gs-x="6" gs-y="6" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/tags/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-tag--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-tag--outlined>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("tagcloud") && (
		<div class="grid-stack-item" gs-id="tagcloud" gs-x="0" gs-y="9" gs-w="4" gs-h="2">
			<div class="grid-stack-item-content"><TagCloudCard posts={posts} /></div>
		</div>
		)}
		{homeTiles.includes("techstack") && (
		<div class="grid-stack-item" gs-id="techstack" gs-x="4" gs-y="9" gs-w="4" gs-h="2">
			<div class="grid-stack-item-content"><TechStackCard /></div>
		</div>
		)}
		{homeTiles.includes("gallery") && (
		<div class="grid-stack-item" gs-id="gallery" gs-x="0" gs-y="11" gs-w="8" gs-h="3">
			<div class="grid-stack-item-content"><GalleryStackCard /></div>
		</div>
		)}
		{homeTiles.includes("github") && (
		<div class="grid-stack-item" gs-id="github" gs-x="0" gs-y="13" gs-w="4" gs-h="4">
			<div class="grid-stack-item-content"><GitHubProjectsCard /></div>
		</div>
		)}
		{homeTiles.includes("talks") && (
		<div class="grid-stack-item" gs-id="talks" gs-x="4" gs-y="13" gs-w="4" gs-h="2">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/talks/" variant="filled" class="bento-card sq-card">
					<div class="sq-body">
						<mdui-icon-mode-comment--outlined style="font-size: 34px; color: rgb(var(--mdui-color-primary))"></mdui-icon-mode-comment--outlined>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{
			customCards.map((card) => (
				<div class="grid-stack-item" gs-id={card.id} gs-x={card.x} gs-y={card.y} gs-w={card.w} gs-h={card.h}>
					<div class="grid-stack-item-content"><CustomCard card={card} /></div>
				</div>
			))
		}
	</div>

	{
		posts.length > 0 && (
			<div class="masonry" style="margin-top: var(--blog-gap)">
				{
					posts.map((post) => <MasonryPostCard post={post} />)
				}
			</div>
		)
	}
</Layout>

<script>
	import { GridStack } from "gridstack";
	import "gridstack/dist/gridstack.min.css";
	import { customCards, homeTiles } from "../site.config";

	const KEY = "homeGridLayout";

	// Full default layout: every tile incl. newly added ones (gridstack load()
	// removes tiles missing from a saved layout, so merge saved onto default)
	const DEFAULT_LAYOUT = [
		{ id: "profile", x: 0, y: 0, w: 3, h: 3 },
		{ id: "appearance", x: 3, y: 0, w: 3, h: 3 },
		{ id: "emoji", x: 6, y: 0, w: 2, h: 3 },
		{ id: "contribution", x: 0, y: 3, w: 8, h: 2 },
		{ id: "search", x: 0, y: 6, w: 2, h: 3 },
		{ id: "archive", x: 2, y: 6, w: 2, h: 3 },
		{ id: "category", x: 4, y: 6, w: 2, h: 3 },
		{ id: "tags", x: 6, y: 6, w: 2, h: 3 },
		{ id: "tagcloud", x: 0, y: 9, w: 4, h: 2 },
		{ id: "techstack", x: 4, y: 9, w: 4, h: 2 },
		{ id: "gallery", x: 0, y: 11, w: 8, h: 3 },
		{ id: "github", x: 0, y: 13, w: 4, h: 4 },
		{ id: "talks", x: 4, y: 13, w: 4, h: 2 },
		...customCards.map((c) => ({ id: c.id, x: c.x, y: c.y, w: c.w, h: c.h })),
	].filter((t) => homeTiles.includes(t.id) || customCards.some((c) => c.id === t.id));

	const grid = GridStack.init({
		column: 8,
		cellHeight: 88,
		margin: 12, // uniform 24px gap (gridstack insets content)
		float: false,
		animate: true,
		columnOpts: {
			// breakpoint.w = width UPPER bound: below w -> c columns
			breakpoints: [
				{ w: 1200, c: 8 },
				{ w: 1024, c: 6 },
				{ w: 768, c: 4 },
				{ w: 480, c: 2 },
			],
			layout: "moveScale",
		},
	})!;

	// Compact cells on phones (gridstack has no cellHeight breakpoint)
	const mqSmall = window.matchMedia("(max-width: 480px)");
	const applyCellHeight = () => grid.cellHeight(mqSmall.matches ? 56 : 88);
	applyCellHeight();
	mqSmall.addEventListener("change", applyCellHeight);

	// Layout lock: prevents dragging/reordering while locked
	const LOCK_KEY = "gridLocked";
	const lockBtn = document.getElementById("layout-lock");
	const lockIcon = document.getElementById("lock-icon");
	const lockOpenIcon = document.getElementById("lock-open-icon");
	const lockLabel = document.getElementById("lock-label");
	const syncLockUI = (locked) => {
		if (lockIcon) lockIcon.style.display = locked ? "" : "none";
		if (lockOpenIcon) lockOpenIcon.style.display = locked ? "none" : "";
		if (lockLabel) lockLabel.textContent = locked ? "已锁定" : "锁定布局";
		if (lockBtn) {
			lockBtn.setAttribute("aria-label", locked ? "解锁布局" : "锁定布局");
			lockBtn.setAttribute("title", locked ? "解锁布局" : "锁定布局");
		}
	};
	const setLocked = (value) => {
		locked = value;
		grid.enableMove(!value);
		grid.enableResize(!value); // resize follows lock too
		try {
			localStorage.setItem(LOCK_KEY, locked ? "1" : "0");
		} catch { /* ignore */ }
		syncLockUI(locked);
	};
	let locked = false;
	try {
		locked = localStorage.getItem(LOCK_KEY) === "1";
	} catch { /* ignore */ }
	setLocked(locked);
	lockBtn?.addEventListener("click", () => setLocked(!locked));

	// Restore persisted layout, merging in tiles added since it was saved.
	// User positions AND sizes are kept; only missing tiles are added.
	// Stale entries (tiles removed from config, e.g. commented-out custom
	// cards) are dropped so they leave no empty placeholder on the grid.
	const validTileIds = new Set([
		...homeTiles,
		...customCards.map((c) => c.id),
	]);
	try {
		const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
		if (Array.isArray(saved) && saved.length > 0) {
			const savedIds = new Set(saved.map((n) => n.id));
			for (const d of DEFAULT_LAYOUT) {
				if (!savedIds.has(d.id)) saved.push(d);
			}
			grid.load(saved.filter((n) => validTileIds.has(n.id)));
			// persist cleaned layout so stale ids don't linger
			try {
				localStorage.setItem(KEY, JSON.stringify(grid.save(false)));
			} catch {
				/* ignore */
			}
		}
	} catch {
		/* ignore corrupt layout */
	}

	grid.on("change", () => {
		try {
			localStorage.setItem(KEY, JSON.stringify(grid.save(false)));
		} catch {
			/* ignore */
		}
	});
</script>
