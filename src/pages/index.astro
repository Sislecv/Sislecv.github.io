---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, getCategories } from "../lib/posts";
import ProfileCard from "../components/ProfileCard.astro";
import AppearanceCard from "../components/AppearanceCard.astro";
import ContributionCard from "../components/ContributionCard.astro";
import EmojiCard from "../components/EmojiCard.astro";
import SearchCard from "../components/SearchCard.astro";
import TagCloudCard from "../components/TagCloudCard.astro";
import TechStackCard from "../components/TechStackCard.astro";
import GalleryStackCard from "../components/GalleryStackCard.astro";
import GitHubProjectsCard from "../components/GitHubProjectsCard.astro";
import TalksCard from "../components/TalksCard.astro";
import CustomCard from "../components/CustomCard.astro";
import MasonryPostCard from "../components/MasonryPostCard.astro";
import { homeTiles, customCards } from "../site.config";

const posts = await getAllPosts();
const categories = [...getCategories(posts).entries()];
const uniqueTags = new Set(posts.flatMap((p) => p.data.tags || []));
---

<Layout showFooterNav={false}>
	<div class="grid-toolbar">
		<mdui-button id="layout-reset" variant="text" size="small" title="恢复官方默认布局">
			<mdui-icon-restart-alt--outlined slot="icon" style="font-size: 18px"></mdui-icon-restart-alt--outlined>
			重置布局
		</mdui-button>
		<mdui-button id="layout-lock" variant="tonal" size="small">
			<mdui-icon-lock-open--outlined slot="icon" id="lock-open-icon" style="display: none; font-size: 18px"></mdui-icon-lock-open--outlined>
			<mdui-icon-lock--outlined slot="icon" id="lock-icon" style="font-size: 18px"></mdui-icon-lock--outlined>
			<span id="lock-label">锁定布局</span>
		</mdui-button>
	</div>
	<div class="grid-stack" id="home-grid">
		{homeTiles.includes("profile") && (
		<div class="grid-stack-item" gs-id="profile" gs-x="0" gs-y="0" gs-w="4" gs-h="3">
			<div class="grid-stack-item-content"><ProfileCard /></div>
		</div>
		)}
		{homeTiles.includes("emoji") && (
		<div class="grid-stack-item" gs-id="emoji" gs-x="4" gs-y="0" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content"><EmojiCard /></div>
		</div>
		)}
		{homeTiles.includes("appearance") && (
		<div class="grid-stack-item" gs-id="appearance" gs-x="6" gs-y="0" gs-w="2" gs-h="3">
			<div class="grid-stack-item-content"><AppearanceCard /></div>
		</div>
		)}
		{homeTiles.includes("talks") && (
		<div class="grid-stack-item" gs-id="talks" gs-x="0" gs-y="3" gs-w="5" gs-h="3">
			<div class="grid-stack-item-content"><TalksCard /></div>
		</div>
		)}
		{homeTiles.includes("gallery") && (
		<div class="grid-stack-item" gs-id="gallery" gs-x="5" gs-y="3" gs-w="3" gs-h="3">
			<div class="grid-stack-item-content"><GalleryStackCard /></div>
		</div>
		)}
		{homeTiles.includes("archive") && (
		<div class="grid-stack-item" gs-id="archive" gs-x="0" gs-y="6" gs-w="2" gs-h="2">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/archive/" variant="filled" class="bento-card pixel-chart-widget chart-coral" title={`归档 · ${posts.length} 篇`}>
					<div class="chart-widget-inner">
						<div class="ring-chart-wrap">
							<svg class="ring-svg" viewBox="0 0 64 64">
								<circle class="ring-bg" cx="32" cy="32" r="26" />
								<circle class="ring-fill ring-coral-fill" cx="32" cy="32" r="26" />
							</svg>
							<div class="ring-center-stat coral-text">{posts.length}</div>
						</div>
						<div class="chart-sub-icon coral-sub">
							<mdui-icon-history--outlined></mdui-icon-history--outlined>
						</div>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("category") && (
		<div class="grid-stack-item" gs-id="category" gs-x="2" gs-y="6" gs-w="2" gs-h="2">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/archive/" variant="filled" class="bento-card pixel-chart-widget chart-mint" title={`分类 · ${categories.length} 个`}>
					<div class="chart-widget-inner">
						<div class="bars-chart-wrap">
							<span class="bar-col b1 mint-bar"></span>
							<span class="bar-col b2 mint-bar-active"></span>
							<span class="bar-col b3 mint-bar"></span>
							<div class="bars-center-stat mint-text">{categories.length}</div>
						</div>
						<div class="chart-sub-icon mint-sub">
							<mdui-icon-folder--outlined></mdui-icon-folder--outlined>
						</div>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("tags") && (
		<div class="grid-stack-item" gs-id="tags" gs-x="4" gs-y="6" gs-w="2" gs-h="2">
			<div class="grid-stack-item-content">
				<mdui-card clickable href="/tags/" variant="filled" class="bento-card pixel-chart-widget chart-amber" title={`标签 · ${uniqueTags.size} 个`}>
					<div class="chart-widget-inner">
						<div class="dots-cluster-chart">
							<span class="tag-bubble tb-amber-1"></span>
							<span class="tag-bubble tb-amber-2"></span>
							<span class="tag-bubble tb-amber-3"></span>
							<div class="tags-center-stat amber-text">{uniqueTags.size}</div>
						</div>
						<div class="chart-sub-icon amber-sub">
							<mdui-icon-tag--outlined></mdui-icon-tag--outlined>
						</div>
					</div>
				</mdui-card>
			</div>
		</div>
		)}
		{homeTiles.includes("search") && (
		<div class="grid-stack-item" gs-id="search" gs-x="6" gs-y="6" gs-w="2" gs-h="2">
			<div class="grid-stack-item-content"><SearchCard /></div>
		</div>
		)}
		{homeTiles.includes("techstack") && (
		<div class="grid-stack-item" gs-id="techstack" gs-x="0" gs-y="8" gs-w="5" gs-h="2">
			<div class="grid-stack-item-content"><TechStackCard /></div>
		</div>
		)}
		{homeTiles.includes("tagcloud") && (
		<div class="grid-stack-item" gs-id="tagcloud" gs-x="5" gs-y="8" gs-w="3" gs-h="2">
			<div class="grid-stack-item-content"><TagCloudCard posts={posts} /></div>
		</div>
		)}
		{homeTiles.includes("contribution") && (
		<div class="grid-stack-item" gs-id="contribution" gs-x="0" gs-y="10" gs-w="8" gs-h="2">
			<div class="grid-stack-item-content"><ContributionCard posts={posts} /></div>
		</div>
		)}
		{homeTiles.includes("github") && (
		<div class="grid-stack-item" gs-id="github" gs-x="0" gs-y="12" gs-w="8" gs-h="3">
			<div class="grid-stack-item-content"><GitHubProjectsCard /></div>
		</div>
		)}
		{
			customCards.map((card) => (
				<div class="grid-stack-item" gs-id={card.id} gs-x={card.x} gs-y={card.y} gs-w={card.w} gs-h={card.h}>
					<div class="grid-stack-item-content"><CustomCard card={card} /></div>
				</div>
			))
		}
	</div>

	{
		posts.length > 0 && (
			<div class="masonry" style="margin-top: var(--blog-gap)">
				{
					posts.map((post) => <MasonryPostCard post={post} />)
				}
			</div>
		)
	}
</Layout>

<style>
	/* Frosted Glass Solid Tonal Charts Widgets */
	.pixel-chart-widget {
		height: 100%;
		border-radius: var(--mdui-shape-corner-extra-large, 24px) !important;
		border: none !important;
		outline: none !important;
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            background-color var(--md-duration-short, 200ms) ease !important;
		overflow: hidden;
		user-select: none;
	}

	.pixel-chart-widget:hover {
		transform: translateY(-2px);
	}

	/* Color 1: Coral / Peach Pink Tonal Container */
	.chart-coral {
		background: rgba(255, 216, 216, 0.82) !important;
		color: #410002 !important;
	}
	:global(.mdui-theme-dark) .chart-coral {
		background: rgba(59, 34, 34, 0.8) !important;
		color: #ffdad5 !important;
	}
	.chart-coral:hover {
		background: rgba(255, 205, 205, 0.9) !important;
	}
	:global(.mdui-theme-dark) .chart-coral:hover {
		background: rgba(70, 41, 41, 0.9) !important;
	}
	.ring-coral-fill {
		stroke: #b3261e !important;
	}
	:global(.mdui-theme-dark) .ring-coral-fill {
		stroke: #ffb4ab !important;
	}
	.coral-text {
		color: #410002 !important;
	}
	:global(.mdui-theme-dark) .coral-text {
		color: #ffdad5 !important;
	}
	.coral-sub {
		color: #8c1d18 !important;
	}
	:global(.mdui-theme-dark) .coral-sub {
		color: #ffb4ab !important;
	}

	/* Color 2: Mint Green Tonal Container */
	.chart-mint {
		background: rgba(211, 248, 223, 0.82) !important;
		color: #00210c !important;
	}
	:global(.mdui-theme-dark) .chart-mint {
		background: rgba(25, 51, 37, 0.8) !important;
		color: #c4eed0 !important;
	}
	.chart-mint:hover {
		background: rgba(197, 245, 212, 0.9) !important;
	}
	:global(.mdui-theme-dark) .chart-mint:hover {
		background: rgba(32, 64, 47, 0.9) !important;
	}
	.mint-bar {
		background: rgba(27, 135, 59, 0.4) !important;
	}
	.mint-bar-active {
		background: #1b873b !important;
	}
	:global(.mdui-theme-dark) .mint-bar {
		background: rgba(123, 217, 153, 0.35) !important;
	}
	:global(.mdui-theme-dark) .mint-bar-active {
		background: #7bd999 !important;
	}
	.mint-text {
		color: #00210c !important;
	}
	:global(.mdui-theme-dark) .mint-text {
		color: #c4eed0 !important;
	}
	.mint-sub {
		color: #1b873b !important;
	}
	:global(.mdui-theme-dark) .mint-sub {
		color: #7bd999 !important;
	}

	/* Color 3: Warm Amber / Honey Yellow Tonal Container */
	.chart-amber {
		background: rgba(255, 234, 178, 0.82) !important;
		color: #261900 !important;
	}
	:global(.mdui-theme-dark) .chart-amber {
		background: rgba(51, 40, 20, 0.8) !important;
		color: #ffe088 !important;
	}
	.chart-amber:hover {
		background: rgba(255, 227, 158, 0.9) !important;
	}
	:global(.mdui-theme-dark) .chart-amber:hover {
		background: rgba(61, 48, 24, 0.9) !important;
	}
	.tb-amber-1 {
		background: rgba(178, 80, 0, 0.15) !important;
	}
	.tb-amber-2 {
		background: #b25000 !important;
	}
	.tb-amber-3 {
		background: #e28700 !important;
	}
	:global(.mdui-theme-dark) .tb-amber-1 {
		background: rgba(255, 186, 47, 0.2) !important;
	}
	:global(.mdui-theme-dark) .tb-amber-2 {
		background: #ffba2f !important;
	}
	:global(.mdui-theme-dark) .tb-amber-3 {
		background: #ffd073 !important;
	}
	.amber-text {
		color: #261900 !important;
	}
	:global(.mdui-theme-dark) .amber-text {
		color: #ffe088 !important;
	}
	.amber-sub {
		color: #7e5700 !important;
	}
	:global(.mdui-theme-dark) .amber-sub {
		color: #ffba2f !important;
	}

	.chart-widget-inner {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 12px;
		box-sizing: border-box;
		position: relative;
	}

	.chart-widget-inner.flex-row {
		flex-direction: row;
		gap: 20px;
	}

	/* Circular Ring */
	.ring-chart-wrap {
		position: relative;
		width: 58px;
		height: 58px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ring-svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}

	.ring-bg {
		fill: none;
		stroke: rgba(0, 0, 0, 0.08);
		stroke-width: 5.5;
	}
	:global(.mdui-theme-dark) .ring-bg {
		stroke: rgba(255, 255, 255, 0.1);
	}

	.ring-fill {
		fill: none;
		stroke-width: 5.5;
		stroke-linecap: round;
		stroke-dasharray: 163.36;
		stroke-dashoffset: 45;
		transition: stroke-dashoffset var(--md-duration-medium, 300ms) ease;
	}

	.pixel-chart-widget:hover .ring-fill {
		stroke-dashoffset: 20;
	}

	.ring-center-stat {
		position: absolute;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.5px;
	}

	/* Bars */
	.bars-chart-wrap {
		position: relative;
		width: 58px;
		height: 58px;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 4px;
		padding-bottom: 2px;
	}

	.bar-col {
		width: 7px;
		border-radius: 9999px;
		transition: height var(--md-duration-short, 200ms) ease;
	}

	.b1 { height: 28px; }
	.b2 { height: 46px; }
	.b3 { height: 34px; }

	.bars-center-stat {
		position: absolute;
		top: 2px;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.5px;
	}

	/* Dots Cluster */
	.dots-cluster-chart {
		position: relative;
		width: 60px;
		height: 58px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tag-bubble {
		position: absolute;
		border-radius: 50%;
		transition: transform var(--md-duration-short, 200ms) ease;
	}

	.tb-amber-1 { width: 44px; height: 44px; }
	.tb-amber-2 { width: 14px; height: 14px; top: 2px; right: 2px; }
	.tb-amber-3 { width: 10px; height: 10px; bottom: 4px; left: 4px; }

	.pixel-chart-widget:hover .tag-bubble {
		transform: scale(1.08);
	}

	.tags-center-stat {
		position: relative;
		z-index: 2;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.5px;
	}

	/* Sub-icon */
	.chart-sub-icon {
		font-size: 18px;
		opacity: 0.85;
		transition: transform var(--md-duration-short, 150ms) ease;
	}

	.pixel-chart-widget:hover .chart-sub-icon {
		transform: scale(1.15);
	}
	/* 电脑布局显著拉开贡献日历与项目展示的上下呼吸感间距 (50px+ 物理视觉隔离) */
	@media (min-width: 641px) {
		:global(.grid-stack-item[gs-id="github"] > .grid-stack-item-content) {
			margin-top: 36px !important;
			height: calc(100% - 36px) !important;
		}
		:global(.grid-stack-item[gs-id="contribution"] > .grid-stack-item-content) {
			margin-bottom: 8px !important;
			height: calc(100% - 8px) !important;
		}
	}

	/* 手机端一列通栏微调，图表小部件与状态卡片横向自适应排开 */
	@media (max-width: 640px) {
		.chart-widget-inner {
			flex-direction: row !important;
			gap: 28px !important;
			justify-content: center !important;
		}
	}
</style>

<script>
	import { GridStack } from "gridstack";
	import "gridstack/dist/gridstack.min.css";
	import { customCards, homeTiles } from "../site.config";

	const KEY = "homeGridLayout_v9";

	// 桌面端 8 列黄金比例便当网格
	const DEFAULT_LAYOUT = [
		{ id: "profile", x: 0, y: 0, w: 4, h: 3 },
		{ id: "emoji", x: 4, y: 0, w: 2, h: 3 },
		{ id: "appearance", x: 6, y: 0, w: 2, h: 3 },
		{ id: "talks", x: 0, y: 3, w: 5, h: 3 },
		{ id: "gallery", x: 5, y: 3, w: 3, h: 3 },
		{ id: "archive", x: 0, y: 6, w: 2, h: 2 },
		{ id: "category", x: 2, y: 6, w: 2, h: 2 },
		{ id: "tags", x: 4, y: 6, w: 2, h: 2 },
		{ id: "search", x: 6, y: 6, w: 2, h: 2 },
		{ id: "techstack", x: 0, y: 8, w: 5, h: 2 },
		{ id: "tagcloud", x: 5, y: 8, w: 3, h: 2 },
		{ id: "contribution", x: 0, y: 10, w: 8, h: 2 },
		{ id: "github", x: 0, y: 12, w: 8, h: 4 },
		...customCards.map((c) => ({ id: c.id, x: c.x, y: c.y, w: c.w, h: c.h })),
	].filter((t) => homeTiles.includes(t.id) || customCards.some((c) => c.id === t.id));

	// 手机移动端 100% 满宽纯单列流式布局 (Single Column Flow)
	const MOBILE_LAYOUT = [
		{ id: "profile", x: 0, y: 0, w: 1, h: 4 },
		{ id: "talks", x: 0, y: 4, w: 1, h: 3 },
		{ id: "emoji", x: 0, y: 7, w: 1, h: 2 },
		{ id: "appearance", x: 0, y: 9, w: 1, h: 2 },
		{ id: "search", x: 0, y: 11, w: 1, h: 2 },
		{ id: "gallery", x: 0, y: 13, w: 1, h: 3 },
		{ id: "archive", x: 0, y: 16, w: 1, h: 2 },
		{ id: "category", x: 0, y: 18, w: 1, h: 2 },
		{ id: "tags", x: 0, y: 20, w: 1, h: 2 },
		{ id: "techstack", x: 0, y: 22, w: 1, h: 2 },
		{ id: "tagcloud", x: 0, y: 24, w: 1, h: 2 },
		{ id: "contribution", x: 0, y: 26, w: 1, h: 2 },
		{ id: "github", x: 0, y: 28, w: 1, h: 5 },
		...customCards.map((c) => ({ id: c.id, x: 0, y: 33, w: 1, h: c.h })),
	].filter((t) => homeTiles.includes(t.id) || customCards.some((c) => c.id === t.id));

	const isMobileViewport = () => window.innerWidth < 640;

	const grid = GridStack.init({
		column: isMobileViewport() ? 1 : 8,
		cellHeight: isMobileViewport() ? 84 : 88,
		margin: isMobileViewport() ? 12 : 14,
		float: false,
		animate: true,
	})!;

	// Lock state management
	const LOCK_KEY = "gridLocked";
	const lockBtn = document.getElementById("layout-lock");
	const lockIcon = document.getElementById("lock-icon");
	const lockOpenIcon = document.getElementById("lock-open-icon");
	const lockLabel = document.getElementById("lock-label");
	const resetBtn = document.getElementById("layout-reset");

	const syncLockUI = (isLocked: boolean) => {
		if (lockIcon) lockIcon.style.display = isLocked ? "" : "none";
		if (lockOpenIcon) lockOpenIcon.style.display = isLocked ? "none" : "";
		if (lockLabel) lockLabel.textContent = isLocked ? "已锁定" : "锁定布局";
		if (lockBtn) {
			lockBtn.setAttribute("aria-label", isLocked ? "解锁布局" : "锁定布局");
			lockBtn.setAttribute("title", isLocked ? "解锁布局" : "锁定布局");
		}
	};

	let locked = false;
	const setLocked = (value: boolean) => {
		locked = value;
		// 移动端始终禁止拖拽以保障原生滑动浏览，桌面端听从锁状态
		const allowMove = !isMobileViewport() && !value;
		grid.enableMove(allowMove);
		grid.enableResize(allowMove);
		try {
			localStorage.setItem(LOCK_KEY, locked ? "1" : "0");
		} catch { /* ignore */ }
		syncLockUI(locked);
	};

	try {
		locked = localStorage.getItem(LOCK_KEY) === "1";
	} catch { /* ignore */ }
	setLocked(locked);
	lockBtn?.addEventListener("click", () => setLocked(!locked));

	// Safe layout persistence: ONLY save when in 8-column desktop mode and not locked!
	let saveTimer: any = null;
	const saveCurrentLayout = () => {
		if (grid.getColumn() === 8 && !locked) {
			const nodes = grid.engine.nodes;
			if (!nodes || nodes.length === 0) return;
			const layoutData = nodes
				.map((n) => ({
					id: n.id,
					x: n.x,
					y: n.y,
					w: n.w,
					h: n.h,
				}))
				.filter((n) => Boolean(n.id));
			try {
				localStorage.setItem(KEY, JSON.stringify(layoutData));
			} catch {
				/* ignore */
			}
		}
	};

	const scheduleSave = () => {
		clearTimeout(saveTimer);
		saveTimer = setTimeout(saveCurrentLayout, 150);
	};

	grid.on("dragstop resizestop", scheduleSave);
	grid.on("change", () => {
		if (grid.getColumn() === 8 && !locked) {
			scheduleSave();
		}
	});

	const applyLayout = (layoutItems: Array<{ id?: string; x?: number; y?: number; w?: number; h?: number }>) => {
		grid.batchUpdate();
		layoutItems.forEach((item) => {
			if (!item.id) return;
			const el = document.querySelector(`.grid-stack > .grid-stack-item[gs-id="${item.id}"]`) as HTMLElement | null;
			if (el) {
				grid.update(el, {
					x: item.x,
					y: item.y,
					w: item.w,
					h: item.h,
				});
			}
		});
		grid.batchUpdate(false);
	};

	// Reset layout button: restore desktop default layout cleanly
	resetBtn?.addEventListener("click", () => {
		try {
			localStorage.removeItem(KEY);
		} catch { /* ignore */ }
		applyLayout(isMobileViewport() ? MOBILE_LAYOUT : DEFAULT_LAYOUT);
	});

	// Load initial layout based on current viewport
	if (isMobileViewport()) {
		applyLayout(MOBILE_LAYOUT);
	} else {
		try {
			const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
			if (Array.isArray(saved) && saved.length > 0) {
				applyLayout(saved);
			} else {
				applyLayout(DEFAULT_LAYOUT);
			}
		} catch {
			applyLayout(DEFAULT_LAYOUT);
		}
	}

	// Handle window resize dynamically across breakpoints without losing desktop persistence
	let currentMode: "mobile" | "desktop" = isMobileViewport() ? "mobile" : "desktop";
	let resizeTimer: any = null;
	window.addEventListener("resize", () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(() => {
			const mobile = isMobileViewport();
			if (mobile && currentMode !== "mobile") {
				currentMode = "mobile";
				grid.column(1, "none");
				grid.cellHeight(84);
				grid.margin(12);
				grid.enableMove(false);
				grid.enableResize(false);
				applyLayout(MOBILE_LAYOUT);
			} else if (!mobile && currentMode !== "desktop") {
				currentMode = "desktop";
				grid.column(8, "none");
				grid.cellHeight(88);
				grid.margin(14);
				grid.enableMove(!locked);
				grid.enableResize(!locked);
				try {
					const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
					applyLayout(Array.isArray(saved) && saved.length > 0 ? saved : DEFAULT_LAYOUT);
				} catch {
					applyLayout(DEFAULT_LAYOUT);
				}
			}
		}, 120);
	});
</script>
