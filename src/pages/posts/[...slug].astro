---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Toc from "../../components/Toc.astro";
import Utterances from "../../components/Utterances.astro";
import { getAllPosts, formatDate, getPostSlug, getPostUrl, getReadingTime } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post, i) => ({
		params: { slug: getPostSlug(post) },
		props: {
			post,
			prev: posts[i + 1] ?? null,
			next: posts[i - 1] ?? null,
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<div class="article-grid">
		<article>
			<mdui-card variant="elevated">
				<div class="article-body">
					<header class="article-header">
						<div class="post-meta" style="margin-bottom: 12px">
							<span>
								<mdui-icon-event--outlined style="font-size: 16px; vertical-align: -3px"></mdui-icon-event--outlined>
								{formatDate(post.data.published)}
							</span>
							<span>·</span>
							<span>
								<mdui-icon-schedule--outlined style="font-size: 16px; vertical-align: -3px"></mdui-icon-schedule--outlined>
								{getReadingTime(post)}
							</span>
							{
								post.data.category && (
									<a href={`/archive/#cat-${encodeURIComponent(post.data.category)}`} style="color: rgb(var(--mdui-color-primary))">
										{post.data.category}
									</a>
								)
							}
						</div>
						<h1 class="article-title">{post.data.title}</h1>
						<div class="tag-cloud">
							{
								post.data.tags.map((tag) => (
									<a href={`/tags/${encodeURIComponent(tag)}/`}>
										<mdui-chip variant="assist">{tag}</mdui-chip>
									</a>
								))
							}
						</div>
					</header>

					<div class="mdui-prose">
						<Content />
					</div>

					<Utterances />
				</div>
			</mdui-card>

			<div style="display: flex; gap: 16px; margin-top: 16px">
				{
					prev ? (
						<mdui-card clickable href={getPostUrl(getPostSlug(prev))} variant="filled" style="flex: 1">
							<div class="card-body" style="padding: 16px 20px">
								<div style="font-size: 0.8rem; color: rgb(var(--mdui-color-on-surface-variant)); display: flex; align-items: center; gap: 4px">
									<mdui-icon-chevron-left--outlined></mdui-icon-chevron-left--outlined>
									上一篇
								</div>
								<div style="font-weight: 600; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
									{prev.data.title}
								</div>
							</div>
						</mdui-card>
					) : (
						<div style="flex: 1"></div>
					)
				}
				{
					next ? (
						<mdui-card clickable href={getPostUrl(getPostSlug(next))} variant="filled" style="flex: 1">
							<div class="card-body" style="padding: 16px 20px; text-align: right">
								<div style="font-size: 0.8rem; color: rgb(var(--mdui-color-on-surface-variant)); display: flex; align-items: center; justify-content: flex-end; gap: 4px">
									下一篇
									<mdui-icon-chevron-right--outlined></mdui-icon-chevron-right--outlined>
								</div>
								<div style="font-weight: 600; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
									{next.data.title}
								</div>
							</div>
						</mdui-card>
					) : (
						<div style="flex: 1"></div>
					)
				}
			</div>
		</article>

		<aside>
			<Toc headings={headings} />
		</aside>
	</div>
</Layout>
