---
// Google Pixel Material You Squiggly Waveform Media Widget for Talks
import { getAllTalks } from "../lib/talks";

const talks = await getAllTalks();
const latestTalk = talks.length > 0 ? talks[0] : null;

let snippet = "那时候我还会古法编程，手搓博客雏形...";
if (latestTalk) {
	const raw = latestTalk.body || "";
	snippet = raw
		.replace(/!\[.*?\]\(.*?\)/g, "")
		.replace(/\[(.*?)\]\(.*?\)/g, "$1")
		.trim();
	if (snippet.length > 60) {
		snippet = snippet.slice(0, 58) + "...";
	}
}
---

<mdui-card clickable href="/talks/" variant="filled" class="bento-card pixel-media-talks-card">
	<div class="media-card-inner">
		<!-- Top header: Badge + date -->
		<div class="media-card-header">
			<span class="media-pill-tag">
				<mdui-icon-mode-comment--outlined class="tag-icon"></mdui-icon-mode-comment--outlined>
				Talks · 动态碎语
			</span>
			<span class="media-now-playing-dot" title="最新记录"></span>
		</div>

		<!-- Middle text snippet -->
		<div class="media-body-text">
			<p class="media-snippet-quote">“{snippet}”</p>
		</div>

		<!-- Signature Android 13 Squiggly Waveform Progress Bar -->
		<div class="squiggly-progress-wrap" aria-hidden="true">
			<svg class="squiggly-svg" viewBox="0 0 300 24" preserveAspectRatio="none">
				<!-- Background straight line -->
				<path class="wave-bg-line" d="M 0 12 L 300 12" />
				<!-- Animated squiggly wave active portion (0 to 180) -->
				<path
					class="squiggly-wave-path"
					d="M 0 12 Q 15 2, 30 12 T 60 12 T 90 12 T 120 12 T 150 12 T 180 12"
				/>
				<!-- Playhead scrubber dot -->
				<circle cx="180" cy="12" r="5" class="scrubber-dot" />
			</svg>
			<div class="progress-timestamps">
				<span>0:45</span>
				<span>共 {talks.length} 条</span>
			</div>
		</div>

		<!-- Bottom controls matching Pixel Media Widget -->
		<div class="media-controls-row">
			<div class="control-btn-circle" title="前一条">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
					<path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/>
				</svg>
			</div>

			<div class="control-btn-play" title="浏览说说">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
					<path d="M8 5v14l11-7z" />
				</svg>
			</div>

			<div class="control-btn-circle" title="后一条">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
					<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
				</svg>
			</div>

			<span class="media-open-label">查看全部 →</span>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-media-talks-card {
		position: relative;
		overflow: hidden;
		background: #251b2e !important;
		color: #ffffff !important;
		border-radius: var(--mdui-shape-corner-extra-large, 28px) !important;
		border: 1px solid rgba(255, 255, 255, 0.08) !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            box-shadow var(--md-duration-short, 200ms) ease !important;
	}

	:global(.mdui-theme-dark) .pixel-media-talks-card {
		background: #1c1524 !important;
		border-color: rgba(255, 255, 255, 0.06) !important;
	}

	.pixel-media-talks-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(37, 27, 46, 0.35);
	}

	.media-card-inner {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 16px 20px;
		box-sizing: border-box;
	}

	.media-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.media-pill-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 12px;
		border-radius: 9999px;
		background: rgba(232, 222, 248, 0.15);
		border: 1px solid rgba(232, 222, 248, 0.25);
		font-size: 0.76rem;
		font-weight: 600;
		color: #e8def8;
	}

	.tag-icon {
		font-size: 14px;
	}

	.media-now-playing-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d0bcff;
		box-shadow: 0 0 8px #d0bcff;
		animation: pulseDot 2s infinite ease-in-out;
	}

	@keyframes pulseDot {
		0%, 100% { opacity: 0.6; transform: scale(0.9); }
		50% { opacity: 1; transform: scale(1.15); }
	}

	.media-body-text {
		margin: auto 0;
		padding: 4px 0;
	}

	.media-snippet-quote {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.45;
		font-weight: 500;
		color: #f5eff7;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Signature Android 13 Squiggly Waveform */
	.squiggly-progress-wrap {
		width: 100%;
		margin: 6px 0 2px;
	}

	.squiggly-svg {
		width: 100%;
		height: 20px;
		display: block;
	}

	.wave-bg-line {
		stroke: rgba(255, 255, 255, 0.2);
		stroke-width: 3.5;
		stroke-linecap: round;
	}

	.squiggly-wave-path {
		fill: none;
		stroke: #d0bcff;
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
		animation: waveSway 2.5s ease-in-out infinite alternate;
	}

	@keyframes waveSway {
		0% {
			d: path("M 0 12 Q 15 3, 30 12 T 60 12 T 90 12 T 120 12 T 150 12 T 180 12");
		}
		50% {
			d: path("M 0 12 Q 15 21, 30 12 T 60 12 T 90 12 T 120 12 T 150 12 T 180 12");
		}
		100% {
			d: path("M 0 12 Q 15 5, 30 12 T 60 12 T 90 12 T 120 12 T 150 12 T 180 12");
		}
	}

	.scrubber-dot {
		fill: #ffffff;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
	}

	.progress-timestamps {
		display: flex;
		justify-content: space-between;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.55);
		margin-top: 2px;
	}

	/* Bottom controls */
	.media-controls-row {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 6px;
	}

	.control-btn-circle {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #e8def8;
		transition: background var(--md-duration-short, 150ms) ease;
	}

	.pixel-media-talks-card:hover .control-btn-circle {
		background: rgba(255, 255, 255, 0.18);
	}

	.control-btn-play {
		width: 44px;
		height: 34px;
		border-radius: 18px;
		background: #d0bcff;
		color: #381e72;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
		transition: transform var(--md-duration-short, 150ms) ease;
	}

	.pixel-media-talks-card:hover .control-btn-play {
		transform: scale(1.08);
	}

	.media-open-label {
		margin-left: auto;
		font-size: 0.78rem;
		font-weight: 600;
		color: #d0bcff;
		opacity: 0.85;
		transition: opacity var(--md-duration-short, 150ms) ease;
	}

	.pixel-media-talks-card:hover .media-open-label {
		opacity: 1;
	}
</style>
