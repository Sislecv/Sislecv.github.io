---
import { NAV_LINKS } from "../consts";
import "@mdui/icons/home--outlined.js";
import "@mdui/icons/archive--outlined.js";
import "@mdui/icons/tag--outlined.js";
import "@mdui/icons/person--outlined.js";
import "@mdui/icons/search--outlined.js";
import "@mdui/icons/light-mode--outlined.js";
import "@mdui/icons/dark-mode--outlined.js";

const { pathname } = Astro.url;
---

<mdui-card variant="filled" class="nav-card">
	{
		NAV_LINKS.map((link) => (
			<a
				href={link.href}
				class="nav-link"
				aria-current={pathname === link.href || pathname.startsWith(link.href + "/") ? "page" : undefined}
			>
				{
					link.icon === "home" && <mdui-icon-home--outlined></mdui-icon-home--outlined>
				}
				{
					link.icon === "archive" && <mdui-icon-archive--outlined></mdui-icon-archive--outlined>
				}
				{
					link.icon === "tag" && <mdui-icon-tag--outlined></mdui-icon-tag--outlined>
				}
				{
					link.icon === "person" && <mdui-icon-person--outlined></mdui-icon-person--outlined>
				}
				{
					link.icon === "search" && <mdui-icon-search--outlined></mdui-icon-search--outlined>
				}
				<span>{link.label}</span>
			</a>
		))
	}
	<div style="flex: 1"></div>
	<mdui-icon-button id="footer-theme-toggle" aria-label="切换主题" title="切换主题">
		<mdui-icon-dark-mode--outlined id="footer-icon-dark" style="display: none"></mdui-icon-dark-mode--outlined>
		<mdui-icon-light-mode--outlined id="footer-icon-light" style="display: none"></mdui-icon-light-mode--outlined>
	</mdui-icon-button>
</mdui-card>

<script is:inline>
	const btn = document.getElementById("footer-theme-toggle");
	if (btn) {
		const iconDark = document.getElementById("footer-icon-dark");
		const iconLight = document.getElementById("footer-icon-light");

		const isDark = () =>
			document.documentElement.classList.contains("mdui-theme-dark") ||
			(!document.documentElement.classList.contains("mdui-theme-light") &&
				window.matchMedia("(prefers-color-scheme: dark)").matches);

		const syncIcon = () => {
			const dark = isDark();
			iconDark.style.display = dark ? "" : "none";
			iconLight.style.display = dark ? "none" : "";
		};

		btn.addEventListener("click", () => {
			const html = document.documentElement;
			if (isDark()) {
				html.classList.remove("mdui-theme-dark");
				html.classList.add("mdui-theme-light");
				localStorage.setItem("theme", "light");
			} else {
				html.classList.remove("mdui-theme-light");
				html.classList.add("mdui-theme-dark");
				localStorage.setItem("theme", "dark");
			}
			syncIcon();
		});

		window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncIcon);
		syncIcon();
	}
</script>
