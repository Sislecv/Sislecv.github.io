---
import { NAV_LINKS } from "../consts";

const { pathname } = Astro.url;
---

<mdui-card variant="filled" class="nav-card">
	{
		NAV_LINKS.map((link) =>
			link.icon === "search" ? (
				<button type="button" class="nav-link" id="footer-search-trigger">
					<mdui-icon-search--outlined></mdui-icon-search--outlined>
					<span>{link.label}</span>
				</button>
			) : (
				<a
					href={link.href}
					class="nav-link"
					aria-current={pathname === link.href || pathname.startsWith(link.href + "/") ? "page" : undefined}
				>
					{
						link.icon === "home" && <mdui-icon-home--outlined></mdui-icon-home--outlined>
					}
					{
						link.icon === "archive" && <mdui-icon-archive--outlined></mdui-icon-archive--outlined>
					}
					{
						link.icon === "tag" && <mdui-icon-tag--outlined></mdui-icon-tag--outlined>
					}
					{
						link.icon === "collections" && <mdui-icon-collections--outlined></mdui-icon-collections--outlined>
					}
					{
						link.icon === "person" && <mdui-icon-person--outlined></mdui-icon-person--outlined>
					}
					<span>{link.label}</span>
				</a>
			),
		)
	}
	<div style="flex: 1"></div>
	<mdui-icon-button id="footer-theme-toggle" aria-label="切换主题" title="切换主题">
		<mdui-icon-dark-mode--outlined id="footer-icon-dark" style="display: none"></mdui-icon-dark-mode--outlined>
		<mdui-icon-light-mode--outlined id="footer-icon-light" style="display: none"></mdui-icon-light-mode--outlined>
	</mdui-icon-button>
</mdui-card>

<script>
	import { isDark, setAppTheme } from "../lib/theme";

	const btn = document.getElementById("footer-theme-toggle");
	if (btn) {
		const iconDark = document.getElementById("footer-icon-dark");
		const iconLight = document.getElementById("footer-icon-light");

		const syncIcon = () => {
			const dark = isDark();
			if (iconDark) iconDark.style.display = dark ? "" : "none";
			if (iconLight) iconLight.style.display = dark ? "none" : "";
		};

		btn.addEventListener("click", () => {
			setAppTheme(isDark() ? "light" : "dark");
		});

		window.addEventListener("app:theme-changed", syncIcon);
		window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
			if (!localStorage.getItem("theme")) {
				syncIcon();
			}
		});
		syncIcon();
	}
</script>
