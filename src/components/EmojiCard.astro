---
// Google Pixel Material You Pure Graphical Clock & Weather Widget
---

<mdui-card
	clickable
	variant="elevated"
	class="bento-card pixel-graphic-clock-card"
	id="pixel-clock-widget"
	title="点击切换四叶草 / 12瓣时钟形态与配色"
>
	<div class="clock-graphic-container">
		<!-- Main Shape Clock (Toggles between 4-Leaf Clover and 12-Point Scallop Flower) -->
		<div class="clock-badge-interactive" id="clock-shape-badge">
			<svg class="clock-main-svg" viewBox="0 0 100 100" aria-hidden="true">
				<!-- Path 1: 4-Leaf Clover (Default) -->
				<path
					id="clover-clock-path"
					class="clock-bg-shape"
					d="M 50.00 4.00 C 62.00 4.00, 72.00 14.00, 72.00 26.00 C 72.00 34.00, 66.00 40.00, 60.00 44.00 C 66.00 40.00, 74.00 34.00, 86.00 34.00 C 94.00 34.00, 96.00 42.00, 96.00 50.00 C 96.00 58.00, 94.00 66.00, 86.00 66.00 C 74.00 66.00, 66.00 60.00, 60.00 56.00 C 66.00 60.00, 72.00 66.00, 72.00 74.00 C 72.00 86.00, 62.00 96.00, 50.00 96.00 C 38.00 96.00, 28.00 86.00, 28.00 74.00 C 28.00 66.00, 34.00 60.00, 40.00 56.00 C 34.00 60.00, 26.00 66.00, 14.00 66.00 C 6.00 66.00, 4.00 58.00, 4.00 50.00 C 4.00 42.00, 6.00 34.00, 14.00 34.00 C 26.00 34.00, 34.00 40.00, 40.00 44.00 C 34.00 40.00, 28.00 34.00, 28.00 26.00 C 28.00 14.00, 38.00 4.00, 50.00 4.00 Z"
				/>
				<!-- Clock Hands (Real-time tracking) -->
				<line id="clock-hour-hand" x1="50" y1="50" x2="50" y2="30" stroke-linecap="round" />
				<line id="clock-minute-hand" x1="50" y1="50" x2="68" y2="60" stroke-linecap="round" />
				<circle cx="50" cy="50" r="3.5" class="clock-pivot" />
				<circle cx="36" cy="62" r="3" class="clock-accent-dot" />
			</svg>
		</div>

		<!-- Companion Graphic: Pixel 72° Sun Weather Capsule -->
		<div class="weather-graphic-capsule" aria-hidden="true">
			<svg class="sun-flower-svg" viewBox="0 0 24 24" width="16" height="16">
				<path fill="#fbbc04" d="M12 2l1.5 2.5 2.8-.8.5 2.9 2.9.7-.5 2.9 2.5 1.5-1.5 2.5.8 2.8-2.9.5-.7 2.9-2.9-.5-1.5 2.5-1.5-2.5-2.8.8-.5-2.9-2.9-.7.5-2.9-2.5-1.5 1.5-2.5-.8-2.8 2.9-.5.7-2.9 2.9.5z"/>
			</svg>
			<span class="weather-temp-num">72°</span>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-graphic-clock-card {
		height: 100%;
		border-radius: var(--mdui-shape-corner-extra-large, 28px) !important;
		border: none !important;
		outline: none !important;
		padding: 0 !important;
		overflow: hidden;
		background: #ebdcf9 !important;
		color: #4a2875 !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            background-color var(--md-duration-medium, 300ms) ease !important;
		user-select: none;
		position: relative;
	}

	.pixel-graphic-clock-card:hover {
		transform: translateY(-2px);
	}

	.clock-graphic-container {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		padding: 14px;
		box-sizing: border-box;
	}

	.clock-badge-interactive {
		width: 96px;
		height: 96px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform var(--md-duration-medium, 300ms) var(--md-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
	}

	.pixel-graphic-clock-card:hover .clock-badge-interactive {
		transform: scale(1.08) rotate(6deg);
	}

	.clock-main-svg {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 6px 14px rgba(103, 58, 183, 0.22));
	}

	.clock-bg-shape {
		fill: #673ab7;
		transition: fill var(--md-duration-short, 200ms) ease;
	}

	#clock-hour-hand,
	#clock-minute-hand,
	.clock-pivot,
	.clock-accent-dot {
		stroke: #ffb4ab;
		fill: #ffb4ab;
	}

	#clock-hour-hand {
		stroke-width: 6.5px;
	}

	#clock-minute-hand {
		stroke-width: 5.5px;
	}

	/* Theme 2: Coral Pink */
	.pixel-graphic-clock-card.theme-coral {
		background: #ffd8d8 !important;
	}
	.pixel-graphic-clock-card.theme-coral .clock-bg-shape {
		fill: #2c1b18;
	}
	.pixel-graphic-clock-card.theme-coral #clock-hour-hand,
	.pixel-graphic-clock-card.theme-coral #clock-minute-hand,
	.pixel-graphic-clock-card.theme-coral .clock-pivot,
	.pixel-graphic-clock-card.theme-coral .clock-accent-dot {
		stroke: #ffdad5;
		fill: #ffdad5;
	}

	/* Theme 3: Dark Forest Green (from reference image) */
	.pixel-graphic-clock-card.theme-forest {
		background: #1c3328 !important;
	}
	.pixel-graphic-clock-card.theme-forest .clock-bg-shape {
		fill: #34a853;
	}
	.pixel-graphic-clock-card.theme-forest #clock-hour-hand,
	.pixel-graphic-clock-card.theme-forest #clock-minute-hand,
	.pixel-graphic-clock-card.theme-forest .clock-pivot,
	.pixel-graphic-clock-card.theme-forest .clock-accent-dot {
		stroke: #c4eed0;
		fill: #c4eed0;
	}

	/* Weather graphical badge in bottom corner */
	.weather-graphic-capsule {
		position: absolute;
		bottom: 12px;
		right: 14px;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 9px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.45);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	:global(.mdui-theme-dark) .weather-graphic-capsule {
		background: rgba(0, 0, 0, 0.45);
	}

	.weather-temp-num {
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: -0.5px;
		color: #1d1b20;
	}

	:global(.mdui-theme-dark) .weather-temp-num {
		color: #ffffff;
	}
</style>

<script>
	const clockCard = document.getElementById("pixel-clock-widget");
	const hourHand = document.getElementById("clock-hour-hand");
	const minuteHand = document.getElementById("clock-minute-hand");
	const shapePath = document.getElementById("clover-clock-path");

	const CLOVER_D = "M 50.00 4.00 C 62.00 4.00, 72.00 14.00, 72.00 26.00 C 72.00 34.00, 66.00 40.00, 60.00 44.00 C 66.00 40.00, 74.00 34.00, 86.00 34.00 C 94.00 34.00, 96.00 42.00, 96.00 50.00 C 96.00 58.00, 94.00 66.00, 86.00 66.00 C 74.00 66.00, 66.00 60.00, 60.00 56.00 C 66.00 60.00, 72.00 66.00, 72.00 74.00 C 72.00 86.00, 62.00 96.00, 50.00 96.00 C 38.00 96.00, 28.00 86.00, 28.00 74.00 C 28.00 66.00, 34.00 60.00, 40.00 56.00 C 34.00 60.00, 26.00 66.00, 14.00 66.00 C 6.00 66.00, 4.00 58.00, 4.00 50.00 C 4.00 42.00, 6.00 34.00, 14.00 34.00 C 26.00 34.00, 34.00 40.00, 40.00 44.00 C 34.00 40.00, 28.00 34.00, 28.00 26.00 C 28.00 14.00, 38.00 4.00, 50.00 4.00 Z";
	const FLOWER_D = "M 50.00 6.00C 53.06 6.00, 56.06 13.32, 59.58 14.26C 63.10 15.20, 69.35 10.36, 72.00 11.89C 74.65 13.43, 73.59 21.26, 76.16 23.84C 78.74 26.41, 86.57 25.35, 88.11 28.00C 89.64 30.65, 84.80 36.90, 85.74 40.42C 86.68 43.94, 94.00 46.94, 94.00 50.00C 94.00 53.06, 86.68 56.06, 85.74 59.58C 84.80 63.10, 89.64 69.35, 88.11 72.00C 86.57 74.65, 78.74 73.59, 76.16 76.16C 73.59 78.74, 74.65 86.57, 72.00 88.11C 69.35 89.64, 63.10 84.80, 59.58 85.74C 56.06 86.68, 53.06 94.00, 50.00 94.00C 46.94 94.00, 43.94 86.68, 40.42 85.74C 36.90 84.80, 30.65 89.64, 28.00 88.11C 25.35 86.57, 26.41 78.74, 23.84 76.16C 21.26 73.59, 13.43 74.65, 11.89 72.00C 10.36 69.35, 15.20 63.10, 14.26 59.58C 13.32 56.06, 6.00 53.06, 6.00 50.00C 6.00 46.94, 13.32 43.94, 14.26 40.42C 15.20 36.90, 10.36 30.65, 11.89 28.00C 13.43 25.35, 21.26 26.41, 23.84 23.84C 26.41 21.26, 25.35 13.43, 28.00 11.89C 30.65 10.36, 36.90 15.20, 40.42 14.26C 43.94 13.32, 46.94 6.00, 50.00 6.00Z";

	function updateClock() {
		const now = new Date();
		const hours = now.getHours();
		const minutes = now.getMinutes();

		const minuteAngle = (minutes / 60) * 360;
		const hourAngle = ((hours % 12) + minutes / 60) * 30;

		const cx = 50, cy = 50;
		const radH = ((hourAngle - 90) * Math.PI) / 180;
		hourHand?.setAttribute("x2", (cx + 18 * Math.cos(radH)).toFixed(2));
		hourHand?.setAttribute("y2", (cy + 18 * Math.sin(radH)).toFixed(2));

		const radM = ((minuteAngle - 90) * Math.PI) / 180;
		minuteHand?.setAttribute("x2", (cx + 25 * Math.cos(radM)).toFixed(2));
		minuteHand?.setAttribute("y2", (cy + 25 * Math.sin(radM)).toFixed(2));
	}

	updateClock();
	setInterval(updateClock, 1000 * 30);

	const themes = ["", "theme-coral", "theme-forest"];
	let stateIdx = 0;
	clockCard?.addEventListener("click", () => {
		if (!clockCard || !shapePath) return;
		clockCard.classList.remove(themes[stateIdx % themes.length]);
		stateIdx++;
		const theme = themes[stateIdx % themes.length];
		if (theme) clockCard.classList.add(theme);

		shapePath.setAttribute("d", stateIdx % 2 === 0 ? CLOVER_D : FLOWER_D);
	});
</script>
