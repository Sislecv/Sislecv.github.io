---
// Google Material You Dynamic Status & Noto Emoji Widget
import { status } from "../site.config";
---

<mdui-card clickable variant="elevated" class="bento-card">
	<div class="card-body status-card-body">
		<!-- Top Row: Optional Status Badges -->
		<div class="status-badges-row">
			{
				status.text && (
					<span class="status-pill-text">
						<span class="status-live-dot"></span>
						{status.text}
					</span>
				)
			}
			{
				status.showWeather && (
					<span class="status-pill-weather">
						<svg class="sun-icon-svg" viewBox="0 0 24 24" width="13" height="13" fill="#fbbc04">
							<path d="M12 2l1.5 2.5 2.8-.8.5 2.9 2.9.7-.5 2.9 2.5 1.5-1.5 2.5.8 2.8-2.9.5-.7 2.9-2.9-.5-1.5 2.5-1.5-2.5-2.8.8-.5-2.9-2.9-.7.5-2.9-2.5-1.5 1.5-2.5-.8-2.8 2.9-.5.7-2.9 2.9.5z"/>
						</svg>
						<span>{status.weatherText}</span>
					</span>
				)
			}
			{
				status.showTime && (
					<span class="status-pill-time" id="dynamic-time-pill">
						--:--
					</span>
				)
			}
		</div>

		<!-- Center: Google Material Noto Animated Emoji Hero -->
		<div class="status-emoji-hero-wrap">
			<img
				src={status.emoji}
				alt="Status Emoji"
				width="68"
				height="68"
				loading="lazy"
				class="material-noto-emoji"
			/>
		</div>
	</div>
</mdui-card>

<style>
	.status-card-body {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-sizing: border-box;
		user-select: none;
	}

	@media (max-width: 640px) {
		.status-card-body {
			flex-direction: row !important;
			align-items: center !important;
			justify-content: space-between !important;
			padding: 14px 18px !important;
		}
		.material-noto-emoji {
			width: 58px !important;
			height: 58px !important;
		}
	}

	.status-badges-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		z-index: 2;
	}

	.status-pill-text,
	.status-pill-weather,
	.status-pill-time {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 3px 10px;
		border-radius: 9999px;
		background: rgb(var(--mdui-color-surface-container-high));
		color: rgb(var(--mdui-color-on-surface-variant));
		font-size: 0.74rem;
		font-weight: 500;
	}

	.status-live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #34a853;
		box-shadow: 0 0 6px #34a853;
	}

	.sun-icon-svg {
		display: block;
	}

	.status-emoji-hero-wrap {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-bottom: 2px;
	}

	.material-noto-emoji {
		width: 68px;
		height: 68px;
		object-fit: contain;
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
	}

	.bento-card:hover .material-noto-emoji {
		transform: scale(1.1) rotate(4deg);
	}
</style>

<script>
	const timeEl = document.getElementById("dynamic-time-pill");
	if (timeEl) {
		const updateTime = () => {
			const d = new Date();
			const h = String(d.getHours()).padStart(2, "0");
			const m = String(d.getMinutes()).padStart(2, "0");
			timeEl.textContent = `${h}:${m}`;
		};
		updateTime();
		setInterval(updateTime, 1000 * 30);
	}
</script>
