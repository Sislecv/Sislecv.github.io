---
// Google Material You Dynamic Status & Noto Emoji Widget
import { status } from "../site.config";
---

<mdui-card
	clickable
	href={status.link}
	target="_blank"
	rel="noreferrer"
	variant="elevated"
	class="bento-card pixel-status-card"
	title="查看状态"
>
	<div class="status-card-inner">
		<!-- Top Row: Optional Status Badges -->
		<div class="status-badges-row">
			{
				status.text && (
					<span class="status-pill-text">
						<span class="status-live-dot"></span>
						{status.text}
					</span>
				)
			}
			{
				status.showWeather && (
					<span class="status-pill-weather">
						<svg class="sun-icon-svg" viewBox="0 0 24 24" width="14" height="14" fill="#fbbc04">
							<path d="M12 2l1.5 2.5 2.8-.8.5 2.9 2.9.7-.5 2.9 2.5 1.5-1.5 2.5.8 2.8-2.9.5-.7 2.9-2.9-.5-1.5 2.5-1.5-2.5-2.8.8-.5-2.9-2.9-.7.5-2.9-2.5-1.5 1.5-2.5-.8-2.8 2.9-.5.7-2.9 2.9.5z"/>
						</svg>
						<span>{status.weatherText}</span>
					</span>
				)
			}
			{
				status.showTime && (
					<span class="status-pill-time" id="dynamic-time-pill">
						--:--
					</span>
				)
			}
		</div>

		<!-- Center: Google Material Noto Animated Emoji Hero -->
		<div class="status-emoji-hero-wrap">
			<img
				src={status.emoji}
				alt="Status Emoji"
				width="72"
				height="72"
				loading="lazy"
				class="material-noto-emoji"
			/>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-status-card {
		height: 100%;
		border-radius: var(--mdui-shape-corner-extra-large, 28px) !important;
		border: none !important;
		outline: none !important;
		padding: 0 !important;
		overflow: hidden;
		background: rgba(235, 220, 249, 0.82) !important;
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            box-shadow var(--md-duration-short, 200ms) ease !important;
		user-select: none;
	}

	:global(.mdui-theme-dark) .pixel-status-card {
		background: rgba(43, 38, 51, 0.8) !important;
	}

	.pixel-status-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(103, 80, 164, 0.22);
	}

	.status-card-inner {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 14px 16px;
		box-sizing: border-box;
	}

	@media (max-width: 640px) {
		.status-card-inner {
			padding: 10px 12px;
		}
		.material-noto-emoji {
			width: 56px !important;
			height: 56px !important;
		}
	}

	.status-badges-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		z-index: 2;
	}

	.status-pill-text {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 3px 10px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		font-size: 0.74rem;
		font-weight: 600;
		color: #4a2875;
		letter-spacing: 0.1px;
	}

	:global(.mdui-theme-dark) .status-pill-text {
		background: rgba(255, 255, 255, 0.12);
		color: #e8def8;
	}

	.status-live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #34a853;
		box-shadow: 0 0 6px #34a853;
	}

	.status-pill-weather,
	.status-pill-time {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 8px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.6);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		font-size: 0.72rem;
		font-weight: 600;
		color: #381e72;
	}

	:global(.mdui-theme-dark) .status-pill-weather,
	:global(.mdui-theme-dark) .status-pill-time {
		background: rgba(255, 255, 255, 0.1);
		color: #e8def8;
	}

	.status-emoji-hero-wrap {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-bottom: 4px;
	}

	.material-noto-emoji {
		width: 68px;
		height: 68px;
		object-fit: contain;
		filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.15));
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
	}

	.pixel-status-card:hover .material-noto-emoji {
		transform: scale(1.12) rotate(5deg);
	}
</style>

<script>
	const timeEl = document.getElementById("dynamic-time-pill");
	if (timeEl) {
		const updateTime = () => {
			const d = new Date();
			const h = String(d.getHours()).padStart(2, "0");
			const m = String(d.getMinutes()).padStart(2, "0");
			timeEl.textContent = `${h}:${m}`;
		};
		updateTime();
		setInterval(updateTime, 1000 * 30);
	}
</script>
