---
import "@mdui/icons/emoji-emotions--outlined.js";
---

<mdui-card variant="elevated" class="bento-card emoji-card">
	<div class="card-body" style="align-items: center; justify-content: center; padding: 16px">
		<img
			src="/emoji/partying-face.webp"
			alt="🥳"
			width="72"
			height="72"
			loading="lazy"
			class="emoji-img emoji-hero"
		/>
	</div>
</mdui-card>
