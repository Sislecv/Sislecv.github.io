---
import { getStats, type Post } from "../lib/posts";

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const stats = getStats(posts);
---

<mdui-card variant="elevated" class="bento-card">
	<div class="card-body">
		<h2 class="card-title">
			<mdui-icon name="description"></mdui-icon>
			站点统计
		</h2>
		<div class="stats-grid">
			<div class="stat-item">
				<div class="stat-number">{stats.postCount}</div>
				<div class="stat-label">文章</div>
			</div>
			<div class="stat-item">
				<div class="stat-number">{stats.tagCount}</div>
				<div class="stat-label">标签</div>
			</div>
			<div class="stat-item">
				<div class="stat-number">{(stats.totalWords / 1000).toFixed(1)}k</div>
				<div class="stat-label">总字数</div>
			</div>
			<div class="stat-item">
				<div class="stat-number">
					{new Date().getFullYear() - Math.min(...posts.map((p) => new Date(p.data.published).getFullYear()))}
				</div>
				<div class="stat-label">写龄(年)</div>
			</div>
		</div>
	</div>
</mdui-card>
