---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

const repo = "Sislecv/sislecv.github.io";
---

<div id="utterances-container" class="mt-8 w-full">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
        {i18n(I18nKey.comments)}
    </h2>
    <div id="utterances"></div>
</div>

<script is:inline>
    function isDark() {
        return document.documentElement.classList.contains("dark");
    }

    function themeFor() {
        return isDark() ? "github-dark" : "github-light";
    }

    function loadUtterances() {
        const container = document.getElementById("utterances");
        if (!container) return;

        container.innerHTML = "";
        const script = document.createElement("script");
        script.src = "https://utteranc.es/client.js";
        script.setAttribute("repo", "Sislecv/sislecv.github.io");
        script.setAttribute("issue-term", "pathname");
        script.setAttribute("theme", themeFor());
        script.crossOrigin = "anonymous";
        script.async = true;
        container.appendChild(script);
    }

    // Follow Fuwari's light/dark switch via the `dark` class on <html>
    function observeTheme() {
        let frame = null;
        const syncTheme = () => {
            frame =
                frame ||
                document.querySelector(
                    ".utterances-frame, iframe[title='comments']",
                );
            if (frame?.contentWindow) {
                frame.contentWindow.postMessage(
                    { type: "set-theme", theme: themeFor() },
                    "https://utteranc.es",
                );
            }
        };
        const observer = new MutationObserver(syncTheme);
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
        // Re-resolve the iframe after utterances finishes mounting
        const poll = setInterval(() => {
            if (document.querySelector(".utterances-frame, iframe[title='comments']")) {
                frame = null;
                syncTheme();
                clearInterval(poll);
            }
        }, 1000);
        setTimeout(() => clearInterval(poll), 30000);
    }

    loadUtterances();
    observeTheme();

    // Swup replaces the DOM on navigation; re-mount after transitions
    document.addEventListener("swup:content-replaced", () => loadUtterances());
</script>
