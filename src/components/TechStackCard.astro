---
const STACK = [
	{ name: "Python", icon: "/stack/python.svg", url: "https://www.python.org/" },
	{ name: "Node.js", icon: "/stack/nodedotjs.svg", url: "https://nodejs.org/" },
	{ name: "Astro", icon: "/stack/astro.svg", url: "https://astro.build/" },
	{ name: "OMP", icon: "/stack/omp.png", url: "https://opencode.ai/" },
];

// Repeat the track 4x so its width exceeds 2x the viewport,
// making the -50% loop seamless.
const TRACK_ITEMS = [...STACK, ...STACK, ...STACK, ...STACK];
---

<mdui-card clickable variant="filled" class="bento-card">
	<div class="card-body" style="padding: 14px; justify-content: center">
		<div class="stack-viewport">
			<div class="stack-track">
				{
					TRACK_ITEMS.map((s, i) => (
						<a
							class="stack-item"
							href={s.url}
							target="_blank"
							rel="noreferrer"
							title={s.name}
							aria-hidden={i >= STACK.length ? "true" : undefined}
							tabindex={i >= STACK.length ? -1 : undefined}
						>
							<img src={s.icon} alt={i < STACK.length ? s.name : ""} loading="lazy" class="stack-icon" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</mdui-card>
