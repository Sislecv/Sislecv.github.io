---
// TechStackCard.astro: Clean Minimalist Infinite Marquee (Zero background distractions or text)
import { techStack } from "../site.config";
const STACK = techStack;

// Repeat 4x per track group for seamless continuous loop
const GROUP_A = [...STACK, ...STACK, ...STACK, ...STACK];
---

<mdui-card clickable variant="filled" class="bento-card pixel-tech-grid-card">
	<div class="tech-card-content">
		<!-- True Seamless Infinite Tech Icon Marquee -->
		<div class="stack-viewport">
			<div class="stack-marquee-slider">
				<!-- Group 1 -->
				<div class="track-group">
					{
						GROUP_A.map((s) => (
							<a
								class="stack-item"
								href={s.url}
								target="_blank"
								rel="noreferrer"
								title={s.name}
							>
								<img src={s.icon} alt={s.name} loading="lazy" class="stack-icon" />
							</a>
						))
					}
				</div>
				<!-- Duplicate Group 2 for 100% Seamless Loop -->
				<div class="track-group" aria-hidden="true">
					{
						GROUP_A.map((s) => (
							<a
								class="stack-item"
								href={s.url}
								target="_blank"
								rel="noreferrer"
								tabindex="-1"
							>
								<img src={s.icon} alt="" loading="lazy" class="stack-icon" />
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-tech-grid-card {
		position: relative;
		overflow: hidden;
		background: #201e29 !important;
		color: #ffffff !important;
		border-radius: 9999px !important; /* Smooth Continuous Capsule */
		border: none !important;
		outline: none !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease) !important;
	}

	:global(.mdui-theme-dark) .pixel-tech-grid-card {
		background: #191722 !important;
	}

	.pixel-tech-grid-card:hover {
		transform: translateY(-2px);
	}

	/* Content Layer */
	.tech-card-content {
		position: relative;
		z-index: 2;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 28px;
		box-sizing: border-box;
	}

	.stack-viewport {
		overflow: hidden;
		width: 100%;
		position: relative;
		mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
	}

	.stack-marquee-slider {
		display: flex;
		width: max-content;
		animation: seamlessMarquee 32s linear infinite;
		will-change: transform;
	}

	.pixel-tech-grid-card:hover .stack-marquee-slider {
		animation-play-state: paused;
	}

	.track-group {
		display: flex;
		align-items: center;
		gap: 32px;
		padding-right: 32px;
	}

	.stack-item {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform var(--md-duration-short, 150ms) ease;
	}

	.stack-item:hover {
		transform: scale(1.15);
	}

	.stack-icon {
		width: 38px;
		height: 38px;
		display: block;
		object-fit: contain;
		filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
		transition: filter 0.2s ease;
	}

	.stack-item:hover .stack-icon {
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55));
	}

	@keyframes seamlessMarquee {
		0% {
			transform: translate3d(0, 0, 0);
		}
		100% {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@media (max-width: 640px) {
		.stack-icon {
			width: 32px;
			height: 32px;
		}
		.track-group {
			gap: 22px;
			padding-right: 22px;
		}
		.tech-card-content {
			padding: 0 18px;
		}
	}
</style>
