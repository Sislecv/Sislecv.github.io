---
import "@mdui/icons/rocket-launch--outlined.js";
---

<mdui-card clickable variant="filled" class="bento-card">
	<div class="card-body" style="padding: 12px 14px; gap: 6px">
		<div style="font-size: 0.78rem; font-weight: 600; color: var(--mdui-color-on-surface-variant); display: flex; align-items: center; gap: 6px">
			<mdui-icon-rocket-launch--outlined style="font-size: 16px; color: var(--mdui-color-primary)"></mdui-icon-rocket-launch--outlined>
			技术栈
		</div>
		<div class="stack-scroll">
			<a class="stack-item" href="https://www.python.org/" target="_blank" rel="noreferrer" title="Python">
				<img src="/stack/python.svg" alt="Python" loading="lazy" class="stack-icon" />
				<span>Python</span>
			</a>
			<a class="stack-item" href="https://nodejs.org/" target="_blank" rel="noreferrer" title="Node.js">
				<img src="/stack/nodedotjs.svg" alt="Node.js" loading="lazy" class="stack-icon" />
				<span>Node.js</span>
			</a>
			<a class="stack-item" href="https://astro.build/" target="_blank" rel="noreferrer" title="Astro">
				<img src="/stack/astro.svg" alt="Astro" loading="lazy" class="stack-icon" />
				<span>Astro</span>
			</a>
			<a class="stack-item" href="https://opencode.ai/" target="_blank" rel="noreferrer" title="Oh My Pi">
				<img src="/stack/omp.svg" alt="Oh My Pi" loading="lazy" class="stack-icon" />
				<span>OMP</span>
			</a>
		</div>
	</div>
</mdui-card>
