---
// TechStackCard.astro: Clean Minimalist Tiled Tech Stack Icons (Spacious, large, centered, zero background or text)
import { techStack } from "../site.config";
const STACK = techStack;
---

<mdui-card clickable variant="filled" class="bento-card pixel-tech-grid-card">
	<div class="tech-tiled-content">
		{
			STACK.map((s) => (
				<a
					class="stack-tiled-item"
					href={s.url}
					target="_blank"
					rel="noreferrer"
					title={s.name}
					aria-label={s.name}
				>
					<img src={s.icon} alt={s.name} loading="lazy" class="stack-tiled-icon" />
				</a>
			))
		}
	</div>
</mdui-card>

<style>
	.pixel-tech-grid-card {
		position: relative;
		overflow: hidden;
		background: #201e29 !important;
		color: #ffffff !important;
		border-radius: 9999px !important; /* Smooth Continuous Capsule */
		border: none !important;
		outline: none !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease) !important;
	}

	:global(.mdui-theme-dark) .pixel-tech-grid-card {
		background: #191722 !important;
	}

	.pixel-tech-grid-card:hover {
		transform: translateY(-2px);
	}

	/* Spacious Tiled Layout (平铺大图标) */
	.tech-tiled-content {
		position: relative;
		z-index: 2;
		height: 100%;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-evenly;
		padding: 0 36px;
		box-sizing: border-box;
	}

	.stack-tiled-item {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10px;
		border-radius: 18px;
		transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
		outline: none;
	}

	.stack-tiled-item:hover {
		transform: scale(1.22);
	}

	.stack-tiled-icon {
		width: 56px;
		height: 56px;
		max-width: 100%;
		max-height: 100%;
		display: block;
		object-fit: contain;
		filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.45));
		transition: filter 0.2s ease;
	}

	.stack-tiled-item:hover .stack-tiled-icon {
		filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.65));
	}

	@media (max-width: 640px) {
		.tech-tiled-content {
			padding: 0 16px;
		}
		.stack-tiled-icon {
			width: 44px;
			height: 44px;
		}
		.stack-tiled-item {
			padding: 6px;
		}
	}
</style>
