---
// TechStackCard.astro: Truly Seamless Infinite Marquee with Unified Large Icons
import { techStack } from "../site.config";

// Duplicate icons to ensure the marquee group is wider than any modern screen
const BASE_STACK = techStack;
const MARQUEE_SET = [...BASE_STACK, ...BASE_STACK];
---

<mdui-card clickable variant="filled" class="bento-card tech-stack-marquee-card">
	<div class="tech-marquee-wrapper">
		<div class="marquee-track">
			<!-- Part 1 -->
			<div class="marquee-set">
				{
					MARQUEE_SET.map((s) => (
						<a
							class="tech-badge-item"
							href={s.url}
							target="_blank"
							rel="noreferrer"
							title={s.name}
							aria-label={s.name}
						>
							<div class="tech-badge-inner">
								<img src={s.icon} alt={s.name} loading="lazy" class="tech-icon-img" />
							</div>
						</a>
					))
				}
			</div>

			<!-- Part 2 (Exact duplicate for seamless mathematical 50% loop) -->
			<div class="marquee-set" aria-hidden="true">
				{
					MARQUEE_SET.map((s) => (
						<a
							class="tech-badge-item"
							href={s.url}
							target="_blank"
							rel="noreferrer"
							tabindex="-1"
							title={s.name}
							aria-label={s.name}
						>
							<div class="tech-badge-inner">
								<img src={s.icon} alt={s.name} loading="lazy" class="tech-icon-img" />
							</div>
						</a>
					))
				}
			</div>
		</div>
	</div>
</mdui-card>

<style>
	.tech-stack-marquee-card {
		position: relative;
		overflow: hidden;
		background: #201e29 !important;
		color: #ffffff !important;
		border-radius: 9999px !important; /* Smooth Playful Capsule */
		border: none !important;
		outline: none !important;
		padding: 0 !important;
		height: 100%;
		display: flex;
		align-items: center;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease) !important;
	}

	:global(.mdui-theme-dark) .tech-stack-marquee-card {
		background: #191722 !important;
	}

	.tech-stack-marquee-card:hover {
		transform: translateY(-2px);
	}

	/* Marquee Container with smooth fading edges */
	.tech-marquee-wrapper {
		position: relative;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
	}

	/* Whole track moves smoothly by 50% (exactly 1 set width) */
	.marquee-track {
		display: flex;
		width: max-content;
		align-items: center;
		animation: techSeamlessMarquee 26s linear infinite;
		will-change: transform;
	}

	.tech-marquee-wrapper:hover .marquee-track {
		animation-play-state: paused;
	}

	@keyframes techSeamlessMarquee {
		0% {
			transform: translate3d(0, 0, 0);
		}
		100% {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.marquee-set {
		display: flex;
		align-items: center;
		gap: 28px;
		padding-right: 28px; /* Must match gap for gap-perfect seamlessness */
		flex-shrink: 0;
	}

	/* Unified Icon Style: Consistent shape, size, proportion, and elevation */
	.tech-badge-item {
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		outline: none;
		border-radius: 18px;
		transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
		flex-shrink: 0;
	}

	.tech-badge-item:hover {
		transform: scale(1.15);
	}

	.tech-badge-inner {
		width: 54px;
		height: 54px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.tech-badge-item:hover .tech-badge-inner {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.25);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
	}

	.tech-icon-img {
		width: 32px;
		height: 32px;
		max-width: 100%;
		max-height: 100%;
		display: block;
		object-fit: contain;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
		transition: filter 0.2s ease;
	}

	.tech-badge-item:hover .tech-icon-img {
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55));
	}

	@media (max-width: 640px) {
		.marquee-set {
			gap: 18px;
			padding-right: 18px;
		}
		.tech-badge-inner {
			width: 44px;
			height: 44px;
			border-radius: 14px;
		}
		.tech-icon-img {
			width: 26px;
			height: 26px;
		}
	}
</style>
