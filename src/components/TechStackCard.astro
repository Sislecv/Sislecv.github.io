---
const STACK = [
	{ name: "Python", icon: "/stack/python.svg", url: "https://www.python.org/" },
	{ name: "Node.js", icon: "/stack/nodedotjs.svg", url: "https://nodejs.org/" },
	{ name: "Astro", icon: "/stack/astro.svg", url: "https://astro.build/" },
	{ name: "OMP", icon: "/stack/omp.png", url: "https://opencode.ai/" },
];
---

<mdui-card clickable variant="filled" class="bento-card">
	<div class="card-body" style="padding: 12px 14px; gap: 6px">
		<div class="stack-viewport">
			<div class="stack-track">
				{
					STACK.map((s) => (
						<a class="stack-item" href={s.url} target="_blank" rel="noreferrer" title={s.name}>
							<img src={s.icon} alt={s.name} loading="lazy" class="stack-icon" />
							<span>{s.name}</span>
						</a>
					))
				}
				{
					STACK.map((s) => (
						<a class="stack-item" href={s.url} target="_blank" rel="noreferrer" title={s.name} aria-hidden="true" tabindex="-1">
							<img src={s.icon} alt="" loading="lazy" class="stack-icon" />
							<span>{s.name}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</mdui-card>
