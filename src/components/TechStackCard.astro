---
// Google I/O Perspective Grid & Tech Stack Widget
import { techStack } from "../site.config";
const STACK = techStack;

const TRACK_ITEMS = [...STACK, ...STACK, ...STACK, ...STACK];
---

<mdui-card clickable variant="filled" class="bento-card pixel-tech-grid-card">
	<!-- Google I/O 3D Horizon Perspective Grid -->
	<div class="perspective-horizon" aria-hidden="true">
		<div class="grid-plane grid-top"></div>
		<div class="grid-plane grid-bottom"></div>
		<!-- Floating Code Capsule < > -->
		<div class="floating-code-capsule">
			<span class="code-pill cp-red"></span>
			<span class="code-pill cp-blue"></span>
		</div>
	</div>

	<div class="tech-card-content">
		<!-- Minimal top indicator -->
		<div class="tech-top-indicator">
			<span class="tech-status-dot"></span>
			<span class="tech-label-code">&lt;stack/&gt;</span>
		</div>

		<!-- Smooth infinite tech icon track -->
		<div class="stack-viewport">
			<div class="stack-track">
				{
					TRACK_ITEMS.map((s, i) => (
						<a
							class="stack-item"
							href={s.url}
							target="_blank"
							rel="noreferrer"
							title={s.name}
							aria-hidden={i >= STACK.length ? "true" : undefined}
							tabindex={i >= STACK.length ? -1 : undefined}
						>
							<img src={s.icon} alt={i < STACK.length ? s.name : ""} loading="lazy" class="stack-icon" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-tech-grid-card {
		position: relative;
		overflow: hidden;
		background: #18191b !important;
		color: #ffffff !important;
		border-radius: var(--mdui-shape-corner-extra-large, 24px) !important;
		border: 1px solid rgba(255, 255, 255, 0.08) !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            border-color var(--md-duration-short, 200ms) ease !important;
	}

	.pixel-tech-grid-card:hover {
		transform: translateY(-2px);
		border-color: rgba(255, 255, 255, 0.22) !important;
	}

	/* 3D Horizon Perspective Grid from Google I/O 2023 */
	.perspective-horizon {
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 55%;
		pointer-events: none;
		perspective: 260px;
		overflow: hidden;
		opacity: 0.4;
		mask-image: linear-gradient(to right, transparent 0%, black 35%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 35%);
		transition: opacity var(--md-duration-short, 200ms) ease;
	}

	.pixel-tech-grid-card:hover .perspective-horizon {
		opacity: 0.6;
	}

	.grid-plane {
		position: absolute;
		left: 0;
		right: 0;
		height: 100%;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.16) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
		background-size: 28px 20px;
	}

	.grid-bottom {
		bottom: 0;
		transform-origin: center bottom;
		transform: rotateX(65deg);
	}

	.grid-top {
		top: 0;
		transform-origin: center top;
		transform: rotateX(-65deg);
	}

	/* Floating colorful bracket < */
	.floating-code-capsule {
		position: absolute;
		right: 24px;
		top: 50%;
		transform: translateY(-50%);
		width: 28px;
		height: 34px;
		z-index: 2;
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
		transition: transform var(--md-duration-short, 200ms) ease;
	}

	.pixel-tech-grid-card:hover .floating-code-capsule {
		transform: translateY(-50%) scale(1.1);
	}

	.code-pill {
		position: absolute;
		width: 9px;
		height: 22px;
		border-radius: 9999px;
	}

	.cp-red {
		background: #ea4335;
		top: 0;
		right: 6px;
		transform: rotate(-35deg);
		transform-origin: bottom center;
	}

	.cp-blue {
		background: #4285f4;
		bottom: 0;
		right: 6px;
		transform: rotate(35deg);
		transform-origin: top center;
	}

	/* Content Layer */
	.tech-card-content {
		position: relative;
		z-index: 3;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 12px 18px;
		box-sizing: border-box;
	}

	.tech-top-indicator {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.tech-status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #34a853;
		box-shadow: 0 0 6px #34a853;
	}

	.tech-label-code {
		font-family: monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.6);
		letter-spacing: 0.5px;
	}

	.stack-viewport {
		overflow: hidden;
		width: 100%;
		mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
		margin: auto 0;
	}

	.stack-track {
		display: flex;
		align-items: center;
		gap: 16px;
		width: max-content;
		animation: stack-marquee 24s linear infinite;
	}

	.pixel-tech-grid-card:hover .stack-track {
		animation-play-state: paused;
	}

	.stack-item {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 6px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		transition: transform var(--md-duration-short, 150ms) ease,
		            background var(--md-duration-short, 150ms) ease;
	}

	.stack-item:hover {
		transform: scale(1.15) translateY(-2px);
		background: rgba(255, 255, 255, 0.16);
	}

	.stack-icon {
		width: 26px;
		height: 26px;
		object-fit: contain;
		display: block;
	}

	@keyframes stack-marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
</style>
