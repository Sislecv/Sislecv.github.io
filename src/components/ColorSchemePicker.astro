---
import "@mdui/icons/palette.js";

const SCHEMES = [
	{ name: "蓝", color: "#0b57d0" },
	{ name: "靛蓝", color: "#2f3aa8" },
	{ name: "紫", color: "#9334e6" },
	{ name: "粉", color: "#c2185b" },
	{ name: "红", color: "#b3261e" },
	{ name: "橙", color: "#b25000" },
	{ name: "绿", color: "#1b873b" },
	{ name: "青", color: "#006a6a" },
];
---

<mdui-dropdown id="scheme-dropdown" trigger="click" placement="bottom-end">
	<mdui-icon-button slot="trigger" aria-label="主题色" title="动态配色">
		<mdui-icon-palette></mdui-icon-palette>
	</mdui-icon-button>
	<div class="scheme-picker">
		<div class="scheme-title">主题色</div>
		<div class="scheme-grid">
			{
				SCHEMES.map((s) => (
					<button
						type="button"
						class="scheme-dot"
						style={`background: ${s.color}`}
						data-color={s.color}
						aria-label={s.name}
						title={s.name}
					></button>
				))
			}
		</div>
		<label class="scheme-custom">
			<mdui-icon-palette style="font-size: 18px"></mdui-icon-palette>
			<input type="color" id="scheme-custom-input" value="#0b57d0" aria-label="自定义颜色" />
		</label>
	</div>
</mdui-dropdown>

<script>
	import { setColorScheme } from "mdui";
	import "@mdui/icons/palette.js";

	const dropdown = document.getElementById("scheme-dropdown");
	if (dropdown) {
		const apply = (color: string) => {
			try {
				setColorScheme(color);
				localStorage.setItem("scheme", color);
			} catch {
				/* ignore */
			}
		};

		dropdown.addEventListener("click", (e: Event) => {
			const target = e.target as HTMLElement;
			const dot = target.closest(".scheme-dot") as HTMLElement | null;
			if (dot?.dataset.color) {
				apply(dot.dataset.color);
			}
		});

		const custom = document.getElementById("scheme-custom-input") as HTMLInputElement | null;
		custom?.addEventListener("input", () => apply(custom.value));
	}
</script>
