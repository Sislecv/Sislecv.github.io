---
import { githubProjects } from "../site.config";
const PROJECTS = githubProjects;

const langColor = (lang: string): string => {
	const map: Record<string, string> = {
		TypeScript: "#3178c6",
		JavaScript: "#f1e05a",
		Python: "#3572A5",
		Astro: "#ff5d01",
		Shell: "#89e051",
		HTML: "#e34c26",
		CSS: "#663399",
	};
	return map[lang] ?? "#8b949e";
};
---

<mdui-card variant="elevated" class="bento-card">
	<div class="card-body note-grid">
		{
			PROJECTS.map((p, i) => (
				<mdui-card
					clickable
					href={p.url}
					target="_blank"
					rel="noreferrer"
					variant="elevated"
					class="note-item"
					title={p.name}
					style={`--note-rot: ${i % 2 === 0 ? "-1.5deg" : "1deg"}`}
				>
					<div class="note-body">
						<div class="note-title">{p.name}</div>
						<div class="note-desc">{p.description}</div>
						<div class="note-meta">
							<span class="note-lang-dot" style={`--lang-color: ${langColor(p.lang)}`}></span>
							<span class="note-lang">{p.lang}</span>
							<span class="note-stars">
								<mdui-icon-star--outlined style="font-size: 14px; color: rgb(var(--mdui-color-primary))"></mdui-icon-star--outlined>
								{p.stars}
							</span>
						</div>
					</div>
				</mdui-card>
			))
		}
	</div>
</mdui-card>

<style>
	.note-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 12px;
		padding: 14px;
		height: 100%;
	}
	.note-item {
		width: 100%;
		height: 100%;
		transform: rotate(var(--note-rot, 0deg));
		transition: transform var(--md-duration-medium, 200ms) var(--md-easing-emphasized-decelerate, ease);
	}
	.note-item:hover {
		transform: rotate(0deg) translateY(-3px) !important;
	}
	.note-body {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 14px 14px 12px;
		box-sizing: border-box;
	}
	.note-title {
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
		color: rgb(var(--mdui-color-on-surface));
	}
	.note-desc {
		font-size: 0.72rem;
		line-height: 1.5;
		margin-top: 3px;
		color: rgb(var(--mdui-color-on-surface-variant));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.note-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: auto;
		padding-top: 8px;
		font-size: 0.68rem;
		color: rgb(var(--mdui-color-on-surface-variant));
	}
	.note-lang-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--lang-color, #3178c6);
	}
	.note-stars {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 2px;
	}
</style>
