---
import { githubProjects } from "../site.config";
const PROJECTS = githubProjects;

const langColor = (lang: string): string => {
	const map: Record<string, string> = {
		TypeScript: "#3178c6",
		JavaScript: "#f1e05a",
		Python: "#3572A5",
		Astro: "#ff5d01",
		Shell: "#89e051",
		HTML: "#e34c26",
		CSS: "#663399",
	};
	return map[lang] ?? "#8b949e";
};
---

<mdui-card variant="elevated" class="bento-card">
	<div class="card-body note-grid">
		{
			PROJECTS.map((p, i) => (
				<a
					class="note-item"
					class:list={[`note-tone-${i % 4}`]}
					href={p.url}
					target="_blank"
					rel="noreferrer"
					title={p.name}
					style={`${p.color ? `--note-bg: ${p.color}; ` : ""}--note-rot: ${i % 2 === 0 ? "-1.5deg" : "1deg"}`}
				>
					<span class="note-tape" aria-hidden="true"></span>
					<span class="note-fold" aria-hidden="true"></span>
					<span class="note-title">{p.name}</span>
					<span class="note-desc">{p.description}</span>
					<span class="note-meta">
						<span class="note-lang-dot" style={`--lang-color: ${langColor(p.lang)}`}></span>
						<span class="note-lang">{p.lang}</span>
						<span class="note-stars">
							<mdui-icon-star--outlined style="font-size: 14px; color: rgb(var(--mdui-color-primary))"></mdui-icon-star--outlined>
							{p.stars}
						</span>
					</span>
				</a>
			))
		}
	</div>
</mdui-card>

<style>
	.note-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 12px;
		padding: 14px;
		height: 100%;
	}
	.note-item {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 14px 14px 12px;
		/* MD3 surface tones: custom color overrides, else adaptive surface */
		background: var(--note-bg, rgb(var(--mdui-color-surface-container)));
		border-radius: var(--mdui-shape-corner-medium);
		box-shadow: var(--mdui-elevation-level1);
		transform: rotate(var(--note-rot, 0deg));
		transition:
			transform var(--md-duration-medium, 200ms) var(--md-easing-emphasized-decelerate, ease),
			box-shadow var(--md-duration-medium, 200ms) ease;
		text-decoration: none;
		overflow: hidden;
	}
	.note-tone-0 { --note-bg: rgb(var(--mdui-color-surface-container-low)); }
	.note-tone-1 { --note-bg: rgb(var(--mdui-color-surface-container)); }
	.note-tone-2 { --note-bg: rgb(var(--mdui-color-surface-container-high)); }
	.note-tone-3 { --note-bg: rgb(var(--mdui-color-surface-container-highest)); }
	.note-item:hover {
		transform: rotate(0deg) translateY(-3px) !important;
		box-shadow: var(--mdui-elevation-level3);
	}
	/* 胶带:primary-container 半透明,MD3 贴纸质感 */
	.note-tape {
		position: absolute;
		top: -6px;
		left: 50%;
		transform: translateX(-50%) rotate(-2deg);
		width: 56px;
		height: 14px;
		border-radius: 2px;
		background: color-mix(in srgb, rgb(var(--mdui-color-primary-container)) 75%, transparent);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	}
	/* 折角:on-surface 阴影色,深浅色自适应 */
	.note-fold {
		position: absolute;
		top: 0;
		right: 0;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0 16px 16px 0;
		border-color: transparent color-mix(in srgb, rgb(var(--mdui-color-on-surface)) 16%, transparent) transparent transparent;
	}
	.note-title {
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
		color: rgb(var(--mdui-color-on-surface));
	}
	.note-desc {
		font-size: 0.72rem;
		line-height: 1.5;
		margin-top: 3px;
		color: rgb(var(--mdui-color-on-surface-variant));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.note-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: auto;
		padding-top: 8px;
		font-size: 0.68rem;
		color: rgb(var(--mdui-color-on-surface-variant));
	}
	.note-lang-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--lang-color, #3178c6);
	}
	.note-stars {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 2px;
	}
</style>
