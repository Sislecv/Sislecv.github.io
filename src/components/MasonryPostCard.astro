---
import { formatDate, type Post } from "../lib/posts";
import { resolveMediaUrl } from "../lib/media";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const url = `/posts/${post.id.replace(/\.(md|mdx)$/i, "")}/`;
const coverImage = resolveMediaUrl(post.data.image);
---

<mdui-card clickable href={url} variant="filled" class="masonry-card reveal">
	{
		coverImage && (
			<div class="masonry-media-wrap">
				<img src={coverImage} alt={post.data.title} loading="lazy" class="masonry-cover" />
			</div>
		)
	}
	<div class="card-body">
		<h3 class="masonry-title">{post.data.title}</h3>
		<div class="post-meta">
			<mdui-icon-event--outlined style="font-size: 13px"></mdui-icon-event--outlined>
			<span>{formatDate(post.data.published)}</span>
			{post.data.category && (
				<span>·</span>
				<span>{post.data.category}</span>
			)}
		</div>
		{post.data.description && <p class="masonry-desc">{post.data.description}</p>}
	</div>
</mdui-card>

<style>
	.masonry-card {
		overflow: hidden;
	}
	.masonry-media-wrap {
		width: 100%;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: rgba(var(--mdui-color-surface-container-highest), 0.35);
		border-top-left-radius: inherit;
		border-top-right-radius: inherit;
	}
	.masonry-cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--md-duration-medium, 250ms) var(--md-easing-emphasized-decelerate, ease);
	}
	.masonry-card:hover .masonry-cover {
		transform: scale(1.03);
	}
	.masonry-title {
		transition: color 0.2s ease;
	}
	.masonry-card:hover .masonry-title {
		color: rgb(var(--mdui-color-primary));
	}
</style>
