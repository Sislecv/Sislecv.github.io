---
import { formatDate, type Post } from "../lib/posts";
import { resolveMediaUrl } from "../lib/media";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const url = `/posts/${post.id.replace(/\.(md|mdx)$/i, "")}/`;
const coverImage = resolveMediaUrl(post.data.image);
---

<mdui-card clickable href={url} variant="filled" class="masonry-card reveal">
	<!-- Subtle Monoton Double-line Article Watermark -->
	<div class="masonry-watermark" aria-hidden="true">STORY</div>
	{
		coverImage && (
			<div class="masonry-media-wrap">
				<img src={coverImage} alt={post.data.title} loading="lazy" class="masonry-cover" />
			</div>
		)
	}
	<div class="card-body">
		<h3 class="masonry-title">{post.data.title}</h3>
		<div class="post-meta">
			<mdui-icon-event--outlined style="font-size: 13px"></mdui-icon-event--outlined>
			<span>{formatDate(post.data.published)}</span>
			{post.data.category && (
				<span>·</span>
				<span>{post.data.category}</span>
			)}
		</div>
		{post.data.description && <p class="masonry-desc">{post.data.description}</p>}
	</div>
</mdui-card>

<style>
	.masonry-card {
		position: relative;
		overflow: hidden;
		border: none !important;
		outline: none !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease) !important;
	}

	.masonry-watermark {
		position: absolute;
		right: 10px;
		bottom: -12px;
		font-family: var(--font-double-line), monospace;
		font-size: 3.8rem;
		font-weight: 400;
		line-height: 0.85;
		color: currentColor;
		opacity: 0.045;
		letter-spacing: 0.05em;
		pointer-events: none;
		user-select: none;
		transition: opacity 0.3s ease;
	}
	.masonry-card:hover .masonry-watermark {
		opacity: 0.08;
	}

	/* Soft Minimal Solid Card Color Rhythm */
	.masonry-card:nth-child(4n + 1) {
		background: #fcf8f2 !important;
		color: #31261d !important;
	}
	:global(.mdui-theme-dark) .masonry-card:nth-child(4n + 1) {
		background: #251f19 !important;
		color: #fcf8f2 !important;
	}

	.masonry-card:nth-child(4n + 2) {
		background: #f1f7f3 !important;
		color: #172b1e !important;
	}
	:global(.mdui-theme-dark) .masonry-card:nth-child(4n + 2) {
		background: #19261e !important;
		color: #f1f7f3 !important;
	}

	.masonry-card:nth-child(4n + 3) {
		background: #f7f3fa !important;
		color: #271a33 !important;
	}
	:global(.mdui-theme-dark) .masonry-card:nth-child(4n + 3) {
		background: #231a29 !important;
		color: #f7f3fa !important;
	}

	.masonry-card:nth-child(4n + 4) {
		background: #f3f6fa !important;
		color: #162533 !important;
	}
	:global(.mdui-theme-dark) .masonry-card:nth-child(4n + 4) {
		background: #17222c !important;
		color: #f3f6fa !important;
	}

	.card-body {
		position: relative;
		z-index: 2;
	}
	.masonry-media-wrap {
		width: 100%;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: rgba(var(--mdui-color-surface-container-highest), 0.35);
		border-top-left-radius: inherit;
		border-top-right-radius: inherit;
	}
	.masonry-cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--md-duration-medium, 250ms) var(--md-easing-emphasized-decelerate, ease);
	}
	.masonry-card:hover .masonry-cover {
		transform: scale(1.03);
	}
	.masonry-title {
		transition: color 0.2s ease;
	}
	.masonry-card:hover .masonry-title {
		color: rgb(var(--mdui-color-primary));
	}
</style>
