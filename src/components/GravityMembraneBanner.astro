---
// GravityMembraneBanner.astro: Fixed-Grid Active Fluid Reservoir Banner
// Features:
// - Fine fullscreen fixed-position square MDUI cards (smaller size, perfectly square)
// - Baseline fluid depth at rest strictly occupies 1/5 (20%) of banner height
// - Highly realistic stochastic fluid dynamics: wave crest collisions, wave breaking, and physical airborne splashes that lift, arc and fall
// - Colors strictly appear ONLY where water exists (submerged body or airborne splashes); empty air has zero color reaction
// - Lighter, translucent, elegant Material Theme color palette
// - Physical mouse flicking and clicking creates vigorous splashing and droplets
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating active fluid card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%; /* Upper area open for custom titles/badges/cards */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let mouseSpeed = 0;
		let isHovered = false;

		// Interactive expanding ripples (only affect submerged water)
		const ripples = [];

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		// All cell positions (cx, cy) and dimensions (cardSize) are 100% strictly SQUARE and fixed
		let cols = 0;
		let rows = 0;
		let step = 24; // Smaller, refined square cell step
		let cardSize = 20; // Exact square dimension (width == height)
		let cardRadius = 4;
		let gridStartX = 0;
		let gridStartY = 0;

		// Water configuration:
		// Baseline fluid depth: strictly 1/5 (20%) of height at rest
		let baseSurfaceY = 0;
		let surfaceOffsets = [];
		let surfaceVelocities = [];

		// Physical splash droplet particles (lift, arc, fall, and splash into water)
		const splashes = [];

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Baseline water depth: strictly 1/5 (20%) of banner height
			const waterDepth = height * 0.20;
			baseSurfaceY = height - waterDepth; // y = 0.80 * height

			// Square cell sizing: slightly smaller, crisp square cards
			step = width < 640 ? 20 : (width < 1100 ? 23 : 25);
			cardSize = Math.round(step * 0.82);
			cardRadius = Math.max(2, Math.round(cardSize * 0.20));

			cols = Math.ceil(width / step);
			rows = Math.ceil(height / step);

			// Center the grid symmetrically
			gridStartX = (width - cols * step) * 0.5;
			gridStartY = (height - rows * step) * 0.5;

			surfaceOffsets = new Float32Array(cols);
			surfaceVelocities = new Float32Array(cols);

			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				const cy = gridStartY + r * step + step * 0.5;

				for (let c = 0; c < cols; c++) {
					// Initially only cells in the bottom 1/5 are submerged
					if (cy >= baseSurfaceY - step * 0.25) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}

			ripples.length = 0;
			splashes.length = 0;
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Theme Color and Gradient Palette:
		// Lighter, more translucent, vibrant Material water tone
		function getThemeGradientColor(energyRatio, depthRatio) {
			const [pr, pg, pb] = primaryColor;

			// Lighter base tone at the container bed (boosted with white/ambient light)
			const deepR = Math.round(pr * 0.55 + (255 - pr) * 0.35);
			const deepG = Math.round(pg * 0.55 + (255 - pg) * 0.35);
			const deepB = Math.round(pb * 0.55 + (255 - pb) * 0.45);

			// Medium vibrant primary light
			const midR = Math.round(pr * 0.75 + (255 - pr) * 0.50);
			const midG = Math.round(pg * 0.75 + (255 - pg) * 0.50);
			const midB = Math.round(pb * 0.75 + (255 - pb) * 0.60);

			// Radiant, pale crest & splash highlight (bright pastel crest)
			const crestR = Math.round(pr * 0.30 + 255 * 0.70);
			const crestG = Math.round(pg * 0.30 + 255 * 0.70);
			const crestB = Math.round(pb * 0.20 + 255 * 0.80);

			// t blends depth with energy excitation
			const t = Math.max(0, Math.min(1.0, (1.0 - depthRatio) * 0.50 + energyRatio * 0.65));

			let r, g, b;
			if (t < 0.5) {
				const subT = t / 0.5;
				r = Math.round(deepR + (midR - deepR) * subT);
				g = Math.round(deepG + (midG - deepG) * subT);
				b = Math.round(deepB + (midB - deepB) * subT);
			} else {
				const subT = (t - 0.5) / 0.5;
				r = Math.round(midR + (crestR - midR) * subT);
				g = Math.round(midG + (crestG - midG) * subT);
				b = Math.round(midB + (crestB - midB) * subT);
			}

			return [r, g, b];
		}

		// Draw fixed-position, non-rotating SQUARE MDUI Card tile
		function drawCardTile(cx, cy, size, r, g, b, alpha, outlineAlpha) {
			const half = size * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - half, cy - half, size, size, cr);
			} else {
				ctx.moveTo(cx - half + cr, cy - half);
				ctx.lineTo(cx + half - cr, cy - half);
				ctx.quadraticCurveTo(cx + half, cy - half, cx + half, cy - half + cr);
				ctx.lineTo(cx + half, cy + half - cr);
				ctx.quadraticCurveTo(cx + half, cy + half, cx + half - cr, cy + half);
				ctx.lineTo(cx - half + cr, cy + half);
				ctx.quadraticCurveTo(cx - half, cy + half, cx - half, cy + half - cr);
				ctx.lineTo(cx - half, cy - half + cr);
				ctx.quadraticCurveTo(cx - half, cy - half, cx - half + cr, cy - half);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Clean, light Material stroke
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updatePhysics() {
			time += 0.011;

			// Mouse tracking
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mouseSpeed = mouseSpeed * 0.8 + dist * 0.2;
				mouseVx = (mouseX - prevMouseX) * 0.7;
				mouseVy = (mouseY - prevMouseY) * 0.7;

				// Spawn water ripples ONLY if mouse is near or in the water
				if (mouseY > baseSurfaceY - 80 && mouseSpeed > 3.0 && Math.random() < 0.4) {
					ripples.push({
						x: mouseX,
						y: Math.max(mouseY, baseSurfaceY),
						radius: 6,
						strength: Math.min(1.0, mouseSpeed * 0.12),
						decay: 0.024
					});
					if (ripples.length > 20) ripples.shift();
				}

				// Vigorously flicking/lifting out of water creates bursts of airborne splashes
				if (mouseY > baseSurfaceY - 60 && mouseVy < -2.4 && Math.random() < 0.45) {
					const burstCount = 3 + Math.floor(Math.random() * 5);
					for (let k = 0; k < burstCount; k++) {
						const isHigh = Math.random() < 0.22; // Some burst high up across the screen
						splashes.push({
							x: mouseX + (Math.random() - 0.5) * 32,
							y: Math.max(mouseY, baseSurfaceY - 30),
							vx: mouseVx * 0.35 + (Math.random() - 0.5) * 7.5,
							vy: isHigh ? -(12.0 + Math.random() * 7.0) : -(5.5 + Math.random() * 5.0),
							life: 1.0
						});
					}
				}
			} else {
				mouseSpeed *= 0.88;
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Update water ripples
			for (let i = ripples.length - 1; i >= 0; i--) {
				const rp = ripples[i];
				rp.radius += 4.5;
				rp.strength -= rp.decay;
				if (rp.strength <= 0) {
					ripples.splice(i, 1);
				}
			}

			// 1. Natural, Stochastic Wave & Water Sloshing Physics
			// Enhanced autonomous wave sloshing amplitude without mouse interaction
			const waveNoise1 = Math.sin(time * 0.65) * Math.cos(time * 0.32);
			const waveNoise2 = Math.sin(time * 1.25 + 0.8) * 0.45;
			const currentSlosh = (waveNoise1 + waveNoise2) * 1.35; // Larger natural sloshing swing

			const maxWaveClimb = height * 0.42; // Substantially larger wave climb along container walls
			const tension = 0.042;
			const springK = 0.018;
			const damping = 0.978;

			for (let c = 0; c < cols; c++) {
				const colNorm = (c / (cols - 1)) * 2.0 - 1.0; // [-1.0, 1.0]
				const absCol = Math.abs(colNorm);

				// Fluid wall run-up & dynamic slamming reflection
				const wallSide = colNorm < 0 ? -1.0 : 1.0;
				const isPushingWall = (wallSide * currentSlosh) < 0;

				let wallTarget = 0;
				if (isPushingWall) {
					const surgeProfile = Math.pow(absCol, 2.2);
					wallTarget = -Math.abs(currentSlosh) * maxWaveClimb * surgeProfile;
				} else {
					const drawProfile = Math.pow(absCol, 1.3);
					wallTarget = Math.abs(currentSlosh) * (height * 0.12) * drawProfile;
				}

				// Cross traveling swells & turbulence across the reservoir
				const swell1 = Math.sin(c * 0.18 - time * 1.9 + waveNoise2) * (height * 0.032);
				const swell2 = Math.cos(c * 0.32 + time * 1.5) * (height * 0.022);
				const swell3 = Math.sin(c * 0.10 + time * 0.9) * (height * 0.026);

				const targetWaveOffset = wallTarget + swell1 + swell2 + swell3;

				const left = c > 0 ? surfaceOffsets[c - 1] : surfaceOffsets[c];
				const right = c < cols - 1 ? surfaceOffsets[c + 1] : surfaceOffsets[c];

				// Discrete wave equation with restoring force
				const waveForce = -springK * (surfaceOffsets[c] - targetWaveOffset) + tension * (left + right - 2.0 * surfaceOffsets[c]);
				surfaceVelocities[c] = (surfaceVelocities[c] + waveForce) * damping;
			}

			// Integrate wave velocities & generate realistic wall crash bursts
			for (let c = 0; c < cols; c++) {
				surfaceOffsets[c] += surfaceVelocities[c];

				// Ceiling clamp for main water body
				const minOffset = -(height * 0.46);
				if (surfaceOffsets[c] < minOffset) {
					surfaceOffsets[c] = minOffset;
					surfaceVelocities[c] = 0;
				}

				// Optimized Wall Collision Splash Ejection:
				// When surging wave hits left or right screen boundary, cast generous spray clusters inward!
				const isWall = c <= 4 || c >= cols - 5;
				const isCrestSurge = surfaceVelocities[c] < -1.4 || surfaceOffsets[c] < -(height * 0.18);

				if (isWall && isCrestSurge && Math.random() < 0.22) {
					// Substantial burst of flying droplets
					const sprayCount = 4 + Math.floor(Math.random() * 8);
					const inwardDir = c <= 4 ? 1 : -1;
					for (let k = 0; k < sprayCount; k++) {
						const isHigh = Math.random() < 0.26; // High spray arcs up across the screen
						splashes.push({
							x: c * step + (Math.random() - 0.5) * step,
							y: baseSurfaceY + surfaceOffsets[c] - Math.random() * 10,
							vx: inwardDir * (2.0 + Math.random() * 6.5), // Project inward into the reservoir
							vy: isHigh ? -(13.0 + Math.random() * 8.0) : -(6.0 + Math.random() * 6.0),
							life: 1.0
						});
					}
				}
			}

			// 2. Physical mouse disturbance on water surface
			if (isHovered && mouseY > baseSurfaceY - 60) {
				const mouseCol = Math.max(0, Math.min(cols - 1, Math.round(mouseX / step)));
				const influenceRadius = Math.max(2, Math.round(3 + mouseSpeed * 0.35));

				for (let dc = -influenceRadius; dc <= influenceRadius; dc++) {
					const c = mouseCol + dc;
					if (c >= 0 && c < cols) {
						const factor = 1.0 - Math.abs(dc) / influenceRadius;
						surfaceVelocities[c] += (mouseVy * 0.28) * factor;
					}
				}
			}

			// 3. Update physical splashes (Ballistic parabolic trajectory: rise, arc, fall, splash into water)
			for (let i = splashes.length - 1; i >= 0; i--) {
				const sp = splashes[i];
				sp.vy += 0.48; // Realistic gravity acceleration
				sp.vx *= 0.992; // Air drag
				sp.x += sp.vx;
				sp.y += sp.vy;
				sp.life -= 0.014;

				const spCol = Math.floor(sp.x / step);
				const waterLevel = (spCol >= 0 && spCol < cols) ? (baseSurfaceY + surfaceOffsets[spCol]) : baseSurfaceY;

				// Land back into water: splashing down!
				if (sp.y >= waterLevel && sp.vy > 0) {
					if (spCol >= 0 && spCol < cols) {
						surfaceVelocities[spCol] += Math.min(2.8, sp.vy * 0.22); // Impact impulse on water surface

						// Secondary rebound spray
						if (sp.vy > 8.0 && Math.random() < 0.25) {
							splashes.push({
								x: sp.x + (Math.random() - 0.5) * 16,
								y: waterLevel - 4,
								vx: (Math.random() - 0.5) * 4.0,
								vy: -(2.5 + Math.random() * 3.5),
								life: 0.6
							});
						}
					}
					splashes.splice(i, 1);
				} else if (sp.life <= 0 || sp.x < 0 || sp.x > width) {
					splashes.splice(i, 1);
				}
			}
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			// Spatial occupancy map for physical splash droplets
			const splashOccupancy = new Uint8Array(rows * cols);
			for (let i = 0; i < splashes.length; i++) {
				const sp = splashes[i];
				const c = Math.floor((sp.x - gridStartX) / step);
				const r = Math.floor((sp.y - gridStartY) / step);
				if (c >= 0 && c < cols && r >= 0 && r < rows) {
					splashOccupancy[r * cols + c] = 1;
				}
			}

			// Render the fixed grid matrix:
			// STRICT RULE: Color changes occur ONLY where water exists. No water = zero color change.
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * step + step * 0.5;
				// Depth ratio relative to full reservoir
				const depthRatio = Math.max(0, Math.min(1.0, (cy - height * 0.35) / (height * 0.65)));

				for (let c = 0; c < cols; c++) {
					const cx = gridStartX + c * step + step * 0.5;

					// Dynamic surface Y at this column (sloshing + wall climb)
					const currentSurfaceY = baseSurfaceY + surfaceOffsets[c];

					// Check if this cell contains water (submerged in physical wave or occupied by flying splash)
					const isSubmerged = cy >= (currentSurfaceY - step * 0.30);
					const hasSplash = splashOccupancy[r * cols + c] === 1;
					const hasWater = isSubmerged || hasSplash;

					if (!hasWater) {
						// STRICT: Empty air cell. Zero color reaction, no mouse hover glow.
						cellAlpha[r][c] += (0.0 - cellAlpha[r][c]) * 0.32;
						cellEnergy[r][c] = 0.0;
					} else {
						// 1. Natural internal fluid convection currents
						const naturalFlow = Math.sin(r * 0.45 + time * 1.5) * 0.35 + Math.cos(c * 0.35 - time * 1.2) * 0.35;
						const surfaceMovement = Math.abs(surfaceVelocities[c]) * 0.20;
						let kineticEnergy = Math.min(0.85, surfaceMovement + Math.abs(naturalFlow) * 0.35 + (hasSplash ? 0.90 : 0.0));

						// 2. Interactive mouse color excitement (ONLY applies to water-filled cells)
						let interactionEnergy = 0;
						if (isHovered) {
							const dx = cx - mouseX;
							const dy = cy - mouseY;
							const dist = Math.hypot(dx, dy);
							const mouseRadius = 140;

							if (dist < mouseRadius) {
								const proximity = 1.0 - dist / mouseRadius;
								interactionEnergy += Math.pow(proximity, 1.4) * (0.65 + mouseSpeed * 0.08);
							}
						}

						// Ripples propagating inside water
						for (let j = 0; j < ripples.length; j++) {
							const rp = ripples[j];
							const d = Math.hypot(cx - rp.x, cy - rp.y);
							const diff = Math.abs(d - rp.radius);
							if (diff < 42) {
								const ring = Math.cos((diff / 42) * Math.PI * 0.5) * rp.strength;
								interactionEnergy += ring * 0.75;
							}
						}

						const totalEnergy = Math.max(0, Math.min(1.0, kineticEnergy + interactionEnergy));

						cellAlpha[r][c] += (1.0 - cellAlpha[r][c]) * 0.45;
						cellEnergy[r][c] += (totalEnergy - cellEnergy[r][c]) * 0.22;
					}

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						// Lighter, translucent Material tone
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = Math.max(0.52, Math.min(0.88, currentA));
						const outlineA = Math.max(0.14, Math.min(0.40, 0.14 + cellEnergy[r][c] * 0.26));

						// Strictly fixed square position and shape
						drawCardTile(cx, cy, cardSize, cr, cg, cb, cardAlpha, outlineA);
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				const rect = root.getBoundingClientRect();
				const clickX = e.clientX - rect.left;
				const clickY = e.clientY - rect.top;

				// Click produces vigorous splash burst when hitting water
				if (clickY > baseSurfaceY - 60) {
					ripples.push({
						x: clickX,
						y: Math.max(clickY, baseSurfaceY),
						radius: 8,
						strength: 1.3,
						decay: 0.02
					});

					const c = Math.max(0, Math.min(cols - 1, Math.round(clickX / step)));
					surfaceVelocities[c] -= 14.0;

					const count = 8 + Math.floor(Math.random() * 8);
					for (let k = 0; k < count; k++) {
						const isHigh = Math.random() < 0.28;
						splashes.push({
							x: clickX + (Math.random() - 0.5) * 36,
							y: Math.max(clickY, baseSurfaceY - 30),
							vx: (Math.random() - 0.5) * 9.0,
							vy: isHigh ? -(13.0 + Math.random() * 7.0) : -(5.5 + Math.random() * 5.5),
							life: 1.0
						});
					}
				}
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;

				if (mouseY > baseSurfaceY - 60) {
					ripples.push({
						x: mouseX,
						y: Math.max(mouseY, baseSurfaceY),
						radius: 8,
						strength: 1.3,
						decay: 0.02
					});
					const c = Math.max(0, Math.min(cols - 1, Math.round(mouseX / step)));
					surfaceVelocities[c] -= 14.0;

					const count = 7 + Math.floor(Math.random() * 7);
					for (let k = 0; k < count; k++) {
						const isHigh = Math.random() < 0.28;
						splashes.push({
							x: mouseX + (Math.random() - 0.5) * 36,
							y: Math.max(mouseY, baseSurfaceY - 30),
							vx: (Math.random() - 0.5) * 9.0,
							vy: isHigh ? -(13.0 + Math.random() * 7.0) : -(5.5 + Math.random() * 5.5),
							life: 1.0
						});
					}
				}
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>