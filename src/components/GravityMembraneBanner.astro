---
// GravityMembraneBanner.astro: Material Card-based 2D Fluid Dynamics Simulation
// Features: Discrete mini MDUI-card tiles, real-time incompressible fluid vorticity,
// kinetic size scaling, chromatic flow orientation mapping, and organic non-filling boundary.
---

<div class="fluid-banner-hero" id="fluid-hero-container">
	<div class="fluid-hero-viewport" id="fluid-banner-root">
		<canvas id="fluid-banner-canvas" aria-hidden="true"></canvas>

		<!-- Subtle technical telemetry -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">FLUID·SIM // DYNAMICS: VORTICITY // KINETIC: 1.00 // EQUILIBRIUM</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="fluid-scroll-down" id="fluid-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-glyph-wrap">
				<span class="glyph-bar"></span>
				<mdui-icon-keyboard-arrow-down--outlined class="glyph-chevron"></mdui-icon-keyboard-arrow-down--outlined>
			</div>
		</button>
	</div>
</div>

<style>
	.fluid-banner-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		/* Comfortable hero height: does not cover the entire screen, allowing content peek */
		height: 480px;
		max-height: 520px;
		min-height: 380px;
		margin-top: -20px; /* Align to top navigation flush */
		margin-bottom: 24px;
		overflow: hidden;
	}

	.fluid-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 50%, rgba(26, 28, 38, 0.95) 0%, rgba(13, 14, 20, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.16);
		user-select: none;
		-webkit-user-select: none;
		cursor: grab;
		overflow: hidden;
	}

	.fluid-hero-viewport:active {
		cursor: grabbing;
	}

	:global(.mdui-theme-dark) .fluid-hero-viewport {
		background: radial-gradient(circle at 50% 50%, rgba(20, 22, 32, 0.96) 0%, rgba(8, 9, 14, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#fluid-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 18px;
		right: 24px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 2;
	}

	.fluid-hero-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: #38bdf8;
		text-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
	}

	/* Minimalist scroll down indicator */
	.fluid-scroll-down {
		position: absolute;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 8px 12px;
		cursor: pointer;
		color: #38bdf8;
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 2;
		outline: none;
	}

	.fluid-scroll-down:hover {
		opacity: 1;
		color: #67e8f9;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-glyph-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		animation: fluid-bob 2.2s ease-in-out infinite;
	}

	.glyph-bar {
		width: 2px;
		height: 12px;
		background: currentColor;
		border-radius: 9999px;
		margin-bottom: -4px;
		opacity: 0.8;
	}

	.glyph-chevron {
		font-size: 20px;
	}

	@keyframes fluid-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.55;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 640px) {
		.fluid-banner-hero {
			height: 350px;
			min-height: 320px;
			margin-bottom: 16px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 10px;
			right: 12px;
		}
		.fluid-scroll-down {
			bottom: 10px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("fluid-banner-root");
		const canvas = document.getElementById("fluid-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("fluid-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll indicator interaction
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("fluid-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let isPressed = false;
		let pressScale = 0;

		// Fluid Grid Configuration
		let COLS = 44;
		let ROWS = 22;

		class MiniCardNode {
			constructor(gx, gy) {
				this.gx = gx; // Grid normalized [-1, 1]
				this.gy = gy; // Grid normalized [-1, 1]
				this.originX = 0;
				this.originY = 0;
				this.x = 0;
				this.y = 0;
				this.vx = 0;
				this.vy = 0;
				this.speed = 0;
				this.angle = 0;
				this.energy = 0;
				this.baseSize = 12;
				this.falloff = 1; // Radial edge fade factor
			}
		}

		let nodes = [];

		function initGrid() {
			nodes = [];
			for (let r = 0; r < ROWS; r++) {
				const gy = (r / (ROWS - 1)) * 2 - 1; // [-1, 1]
				for (let c = 0; c < COLS; c++) {
					const gx = (c / (COLS - 1)) * 2 - 1; // [-1, 1]
					const node = new MiniCardNode(gx, gy);
					nodes.push(node);
				}
			}
			updateNodePositions();
		}

		function updateNodePositions() {
			const centerX = width * 0.5;
			const centerY = height * 0.5;
			// Keep fluid centered and bounded with generous organic margins
			const fluidWidth = Math.min(width * 0.88, 1160);
			const fluidHeight = Math.min(height * 0.84, 400);

			for (let i = 0; i < nodes.length; i++) {
				const n = nodes[i];
				n.originX = centerX + n.gx * (fluidWidth * 0.5);
				n.originY = centerY + n.gy * (fluidHeight * 0.5);
				n.x = n.originX;
				n.y = n.originY;

				// Smooth elliptical falloff: does NOT touch banner edges, fades out softly
				const normDistX = Math.abs(n.gx);
				const normDistY = Math.abs(n.gy);
				const distSq = Math.pow(normDistX, 2.2) + Math.pow(normDistY, 2.2);
				
				// Smoothstep radial fade
				if (distSq >= 1) {
					n.falloff = 0;
				} else {
					const t = 1 - distSq;
					n.falloff = Math.pow(Math.max(0, Math.min(1, t)), 0.85);
				}
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			if (width < 640) {
				COLS = 28;
				ROWS = 15;
			} else if (width < 1024) {
				COLS = 36;
				ROWS = 18;
			} else {
				COLS = 46;
				ROWS = 22;
			}

			initGrid();
		}

		// Palette interpolation for multi-colored Material 3 Cards
		// 4-Quadrant fluid direction + energy chromatics
		// Quadrant 1 (Emerald/Mint): [16, 185, 129]
		// Quadrant 2 (Ocean/Cyan):   [6, 182, 212]
		// Quadrant 3 (Indigo/Lilac): [99, 102, 241]
		// Quadrant 4 (Coral/Peach):  [244, 63, 94]
		// High kinetic surge:       [251, 191, 36] (Amber gold)
		function getFluidColor(angle, speedRatio, isHighEnergy) {
			let normAngle = (angle + Math.PI) / (Math.PI * 2); // [0, 1]
			normAngle = (normAngle + 0.15) % 1; // slight pleasant offset

			let r, g, b;
			if (normAngle < 0.25) {
				const t = normAngle / 0.25;
				// Mint to Cyan
				r = Math.round(16 + (6 - 16) * t);
				g = Math.round(185 + (182 - 185) * t);
				b = Math.round(129 + (212 - 129) * t);
			} else if (normAngle < 0.5) {
				const t = (normAngle - 0.25) / 0.25;
				// Cyan to Indigo
				r = Math.round(6 + (99 - 6) * t);
				g = Math.round(182 + (102 - 182) * t);
				b = Math.round(212 + (241 - 212) * t);
			} else if (normAngle < 0.75) {
				const t = (normAngle - 0.5) / 0.25;
				// Indigo to Coral
				r = Math.round(99 + (244 - 99) * t);
				g = Math.round(102 + (63 - 102) * t);
				b = Math.round(241 + (94 - 241) * t);
			} else {
				const t = (normAngle - 0.75) / 0.25;
				// Coral to Mint
				r = Math.round(244 + (16 - 244) * t);
				g = Math.round(63 + (185 - 63) * t);
				b = Math.round(94 + (129 - 94) * t);
			}

			// If excited with high energy/speed, blend toward bright amber/gold
			if (isHighEnergy) {
				const t = Math.min(1, (speedRatio - 0.4) * 1.6);
				r = Math.round(r + (251 - r) * t);
				g = Math.round(g + (191 - g) * t);
				b = Math.round(b + (36 - b) * t);
			}

			return [r, g, b];
		}

		// Helper to draw a sleek rounded rectangular mini-card
		function drawMiniCard(cx, cy, w, h, radius, rotAngle, r, g, b, alpha) {
			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(rotAngle);

			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = Math.min(radius, halfW, halfH);

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(-halfW, -halfH, w, h, cr);
			} else {
				// Fallback roundRect
				ctx.moveTo(-halfW + cr, -halfH);
				ctx.lineTo(halfW - cr, -halfH);
				ctx.quadraticCurveTo(halfW, -halfH, halfW, -halfH + cr);
				ctx.lineTo(halfW, halfH - cr);
				ctx.quadraticCurveTo(halfW, halfH, halfW - cr, halfH);
				ctx.lineTo(-halfW + cr, halfH);
				ctx.quadraticCurveTo(-halfW, halfH, -halfW, halfH - cr);
				ctx.lineTo(-halfW, -halfH + cr);
				ctx.quadraticCurveTo(-halfW, -halfH, -halfW + cr, -halfH);
				ctx.closePath();
			}

			// MDUI Solid Card Surface Fill
			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Subtle Card Outline for Material Design definition
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${Math.min(0.28, alpha * 0.35)})`;
			ctx.stroke();

			ctx.restore();
		}

		let time = 0;

		function render() {
			time += 0.016;

			// Track mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.45;
				mouseVy = (mouseY - prevMouseY) * 0.45;
			} else {
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			if (isPressed) {
				pressScale += (1 - pressScale) * 0.14;
			} else {
				pressScale += (0 - pressScale) * 0.08;
			}

			ctx.clearRect(0, 0, width, height);

			let maxFlowSpeed = 0;
			let totalKinetic = 0;

			// Base continuous harmonic fluid vorticity field
			const k1 = 1.6;
			const k2 = 2.4;

			for (let i = 0; i < nodes.length; i++) {
				const n = nodes[i];
				if (n.falloff <= 0.005) continue;

				// Incompressible 2D streamfunction velocity (natural swirl convection)
				const fluidVx = Math.sin(n.gy * k1 + time * 0.75) * 1.8 + Math.cos(n.gx * k2 - time * 0.4) * 0.9;
				const fluidVy = Math.cos(n.gx * k1 + time * 0.75) * 1.8 - Math.sin(n.gy * k2 - time * 0.4) * 0.9;

				// Mouse push & vortex injection
				let mouseImpulseX = 0;
				let mouseImpulseY = 0;
				if (isHovered) {
					const dx = n.x - mouseX;
					const dy = n.y - mouseY;
					const dist = Math.hypot(dx, dy);
					const mouseRadius = 140 + pressScale * 60;

					if (dist < mouseRadius && dist > 1) {
						const proximity = 1 - dist / mouseRadius;
						// Direct push along mouse velocity + gentle swirl around mouse center
						const pushMag = proximity * (18 + pressScale * 35);
						const tangentX = -dy / dist;
						const tangentY = dx / dist;

						mouseImpulseX = mouseVx * proximity * 0.8 + tangentX * pushMag * 0.45;
						mouseImpulseY = mouseVy * proximity * 0.8 + tangentY * pushMag * 0.45;
					}
				}

				// Total target velocity
				const targetVx = fluidVx + mouseImpulseX;
				const targetVy = fluidVy + mouseImpulseY;

				// Damped fluid acceleration
				n.vx += (targetVx - n.vx) * 0.16;
				n.vy += (targetVy - n.vy) * 0.16;

				// Elastic displacement from anchor point (maintains grid structure while allowing fluid drift)
				const spring = 0.12;
				const damping = 0.84;
				const dispX = n.x - n.originX;
				const dispY = n.y - n.originY;
				n.x += n.vx * 1.4 - dispX * spring;
				n.y += n.vy * 1.4 - dispY * spring;

				// Kinetic metrics
				const curSpeed = Math.hypot(n.vx, n.vy);
				n.speed = curSpeed;
				n.angle = Math.atan2(n.vy, n.vx);
				n.energy += (curSpeed - n.energy) * 0.12;

				if (curSpeed > maxFlowSpeed) maxFlowSpeed = curSpeed;
				totalKinetic += curSpeed;

				// Dynamic Size scaling based on local speed and energy:
				// Calm: ~8px Mini Card
				// Fast / Turbulent: ~18px-24px Expanded Card Tile
				const speedRatio = Math.min(1.0, curSpeed / 4.5);
				const isHigh = speedRatio > 0.45;

				// Stretch along flow direction
				const cardLen = (8 + speedRatio * 14 + pressScale * 4) * n.falloff;
				const cardBreadth = (7 + speedRatio * 7 + pressScale * 2) * n.falloff;
				const cardRadius = Math.min(cardLen, cardBreadth) * 0.3;

				// Dynamic Chromatics
				const [cr, cg, cb] = getFluidColor(n.angle, speedRatio, isHigh);
				const cardAlpha = Math.max(0.18, Math.min(0.92, (0.35 + speedRatio * 0.6) * n.falloff));

				// Draw mini MDUI-card tile
				drawMiniCard(
					n.x,
					n.y,
					cardLen,
					cardBreadth,
					cardRadius,
					n.angle,
					cr,
					cg,
					cb,
					cardAlpha
				);
			}

			// Telemetry Update
			if (telemetry) {
				const avgKinetic = (totalKinetic / Math.max(1, nodes.length)).toFixed(2);
				const statusTag = isPressed ? "COMPRESSED" : (isHovered && mouseSpeed > 2 ? "TURBULENT" : "EQUILIBRIUM");
				telemetry.textContent = `FLUID·SIM // DYNAMICS: VORTICITY // KINETIC: ${avgKinetic} // ${statusTag}`;
			}

			requestAnimationFrame(render);
		}

		// Event listeners
		let mouseSpeed = 0;
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
			mouseSpeed = Math.hypot(mouseVx, mouseVy);
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			isPressed = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				isPressed = true;
			}
		});

		window.addEventListener("mouseup", () => {
			isPressed = false;
		});

		// Mobile touch interaction
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				isPressed = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isPressed = false;
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		resize();
		requestAnimationFrame(render);
	})();
</script>
