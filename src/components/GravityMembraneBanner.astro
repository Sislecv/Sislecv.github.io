---
// GravityMembraneBanner.astro: Fixed-Grid Solid Fluid Reservoir Banner
// Features:
// - Deep, solid multi-layered water body filling 3/5 (60%) of the banner height
// - Zero initial scattering/bursting: instantly settled in natural equilibrium on load
// - Absolutely fixed-position MDUI card grid (zero jitter/rotation/warping)
// - Cells toggle on/off like ASCII terminal characters: adding/removing cards express waves, wall collision climb, and splashes
// - Perpetual, organic fluid sloshing & convection even without interaction
// - Strict Material Theme color & gradient transitions from deep abyss to surface highlights
// - Upper 40% open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating the thick solid fluid card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Subtle technical telemetry at bottom corner -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">FLUID·VOXEL // RESERVOIR: 60% (3/5) // SOLID BODY // EQUILIBRIUM</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%; /* Upper 38% open for custom titles/badges/cards */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 5;
	}

	.gravity-hero-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		text-shadow: 0 0 10px rgba(var(--mdui-color-primary, 11, 87, 208), 0.35);
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let splashTrigger = false;

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		// All cell positions (cx, cy) and dimensions (cardW, cardH) are 100% invariant
		let cols = 0;
		let rows = 0;
		let stepX = 46;
		let stepY = 38;
		let cardW = 38;
		let cardH = 30;
		let cardRadius = 8;
		let gridStartY = 0;

		// Fluid Surface Heightfield: Exactly 3/5 (60%) of the Banner is filled with water
		let baseSurfaceY = 0;
		let surfaceOffsets = [];
		let surfaceVelocities = [];

		// Free airborne splash droplets (triggered by clicks or high-speed agitation)
		const droplets = [];

		// Smoothed cell alpha and energy matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Water fills exactly 3/5 (60%) of the container height from bottom
			const waterDepth = height * 0.60;
			baseSurfaceY = height - waterDepth; // Surface rests at y = 40% height

			// Grid starts higher (at ~22% height) to allow splashing and wall impact waves to climb up
			gridStartY = height * 0.22;
			const totalActiveH = height - gridStartY - 12;

			const targetStepX = width < 640 ? 36 : (width < 1100 ? 44 : 48);
			const targetStepY = width < 640 ? 30 : 36;

			cols = Math.floor(width / targetStepX);
			stepX = width / cols;
			cardW = Math.round(stepX * 0.82);

			rows = Math.max(10, Math.floor(totalActiveH / targetStepY));
			stepY = totalActiveH / rows;
			cardH = Math.round(stepY * 0.82);
			cardRadius = Math.round(Math.min(cardW, cardH) * 0.28);

			// Initialize wave state: perfectly settled in equilibrium from the very first frame (NO scattering/bursting)
			surfaceOffsets = new Float32Array(cols);
			surfaceVelocities = new Float32Array(cols);

			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				const cy = gridStartY + r * stepY + stepY * 0.5;

				// Instant solid pre-fill below the 3/5 surface line
				for (let c = 0; c < cols; c++) {
					if (cy >= baseSurfaceY - stepY * 0.3) {
						aRow[c] = 1.0; // Solid fluid cell pre-filled immediately
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}

			droplets.length = 0;
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Theme Color and Gradient Palette:
		// Strict Material Design primary progression:
		// - Deep Bottom Abyss: Rich dark primary shade
		// - Mid Solid Body: Pure vibrant Material primary
		// - Surface Crest / Splash: Tinted luminous primary highlight
		function getThemeGradientColor(energyRatio, depthRatio) {
			const [pr, pg, pb] = primaryColor;

			// Base deep tone at the container bed
			const deepR = Math.round(pr * 0.38);
			const deepG = Math.round(pg * 0.42);
			const deepB = Math.round(pb * 0.58);

			// Bright crest/splash highlight
			const crestR = Math.round(pr + (255 - pr) * 0.68);
			const crestG = Math.round(pg + (255 - pg) * 0.68);
			const crestB = Math.round(pb + (255 - pb) * 0.82);

			// depthRatio: 1.0 at container bottom (deepest), 0.0 at water surface
			// Combined illumination factor
			const t = Math.max(0, Math.min(1.0, (1.0 - depthRatio) * 0.68 + energyRatio * 0.55));

			let r, g, b;
			if (t < 0.5) {
				const subT = t / 0.5;
				r = Math.round(deepR + (pr - deepR) * subT);
				g = Math.round(deepG + (pg - deepG) * subT);
				b = Math.round(deepB + (pb - deepB) * subT);
			} else {
				const subT = (t - 0.5) / 0.5;
				r = Math.round(pr + (crestR - pr) * subT);
				g = Math.round(pg + (crestG - pg) * subT);
				b = Math.round(pb + (crestB - pb) * subT);
			}

			return [r, g, b];
		}

		// Draw fixed-position, non-rotating MDUI Card tile
		function drawCardTile(cx, cy, w, h, r, g, b, alpha, outlineAlpha) {
			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - halfW, cy - halfH, w, h, cr);
			} else {
				ctx.moveTo(cx - halfW + cr, cy - halfH);
				ctx.lineTo(cx + halfW - cr, cy - halfH);
				ctx.quadraticCurveTo(cx + halfW, cy - halfH, cx + halfW, cy - halfH + cr);
				ctx.lineTo(cx + halfW, cy + halfH - cr);
				ctx.quadraticCurveTo(cx + halfW, cy + halfH, cx + halfW - cr, cy + halfH);
				ctx.lineTo(cx - halfW + cr, cy + halfH);
				ctx.quadraticCurveTo(cx - halfW, cy + halfH, cx - halfW, cy + halfH - cr);
				ctx.lineTo(cx - halfW, cy - halfH + cr);
				ctx.quadraticCurveTo(cx - halfW, cy - halfH, cx - halfW + cr, cy - halfH);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Clean Material 1px stroke
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updatePhysics() {
			time += 0.016;

			// Mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.7;
				mouseVy = (mouseY - prevMouseY) * 0.7;
			} else {
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// 1. Perpetual Natural Wave Dynamics (gentle left-right fluid sloshing & convection)
			// Slosh drift that creates continuous natural tide and wall reflection
			const naturalSlosh = Math.sin(time * 1.25) * 4.5;
			const crossHarmonic = Math.cos(time * 1.8) * 2.2;

			// 2. Wave Equation along water surface columns
			const tension = 0.042;
			const springK = 0.028;
			const damping = 0.955;

			for (let c = 0; c < cols; c++) {
				const left = c > 0 ? surfaceOffsets[c - 1] : surfaceOffsets[c] * 1.15; // Wall reflect & pile up
				const right = c < cols - 1 ? surfaceOffsets[c + 1] : surfaceOffsets[c] * 1.15;

				// Sloshing driver
				const colRatio = (c / (cols - 1)) * 2 - 1; // [-1, 1]
				const ambientDriver = colRatio * naturalSlosh + Math.sin(colRatio * Math.PI + time) * crossHarmonic;

				const force = -springK * surfaceOffsets[c] + tension * (left + right - 2 * surfaceOffsets[c]) + ambientDriver * 0.08;
				surfaceVelocities[c] = (surfaceVelocities[c] + force) * damping;
			}

			for (let c = 0; c < cols; c++) {
				surfaceOffsets[c] += surfaceVelocities[c];
			}

			// 3. Mouse agitation & splashes
			if (isHovered && mouseY > baseSurfaceY - 80) {
				const mouseCol = Math.max(0, Math.min(cols - 1, Math.round(mouseX / stepX)));
				const mouseSpeed = Math.hypot(mouseVx, mouseVy);
				const splashRadius = Math.max(2, Math.round(3 + mouseSpeed * 0.35));

				for (let dc = -splashRadius; dc <= splashRadius; dc++) {
					const c = mouseCol + dc;
					if (c >= 0 && c < cols) {
						const factor = 1 - Math.abs(dc) / splashRadius;
						// Push down or pull up water
						surfaceVelocities[c] += (mouseVy * 0.25) * factor;

						if (splashTrigger) {
							// Push water down hard and create splash wave
							surfaceVelocities[c] -= 8.5 * factor;
						}
					}
				}

				// Click triggers airborne droplet splashes
				if (splashTrigger) {
					const dropCount = Math.min(18, Math.round(8 + mouseSpeed * 0.6));
					for (let k = 0; k < dropCount; k++) {
						droplets.push({
							x: mouseX + (Math.random() - 0.5) * 36,
							y: Math.max(baseSurfaceY - 20, mouseY) + (Math.random() - 0.5) * 16,
							vx: mouseVx * 0.4 + (Math.random() - 0.5) * 12,
							vy: - (8 + Math.random() * 14 + Math.abs(mouseVy) * 0.3),
							life: 1.0
						});
					}
				}
			}

			// 4. Update airborne droplets
			for (let i = droplets.length - 1; i >= 0; i--) {
				const d = droplets[i];
				d.vy += 0.55; // Gravity
				d.x += d.vx;
				d.y += d.vy;
				d.life -= 0.015;

				// Land back in water
				const dCol = Math.floor(d.x / stepX);
				const surfAtX = dCol >= 0 && dCol < cols ? (baseSurfaceY + surfaceOffsets[dCol]) : baseSurfaceY;

				if (d.y >= surfAtX && d.vy > 0) {
					if (dCol >= 0 && dCol < cols) {
						surfaceVelocities[dCol] += 1.8;
					}
					droplets.splice(i, 1);
				} else if (d.life <= 0 || d.x < 0 || d.x > width) {
					droplets.splice(i, 1);
				}
			}

			splashTrigger = false;
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			let activeCardsCount = 0;

			// Droplet spatial occupancy map
			const dropletMap = new Uint8Array(rows * cols);
			for (let i = 0; i < droplets.length; i++) {
				const d = droplets[i];
				const c = Math.floor(d.x / stepX);
				const r = Math.floor((d.y - gridStartY) / stepY);
				if (c >= 0 && c < cols && r >= 0 && r < rows) {
					dropletMap[r * cols + c] = 1;
				}
			}

			// Render the fixed grid matrix:
			// The water body is SOLID and THICK: every cell from the dynamic surface down to the container bottom is solid fluid!
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * stepY + stepY * 0.5;
				// Depth ratio: 0.0 at surface, 1.0 at the container bed
				const depthRatio = Math.max(0, Math.min(1.0, (cy - (baseSurfaceY - 40)) / (height - baseSurfaceY)));

				for (let c = 0; c < cols; c++) {
					const cx = c * stepX + stepX * 0.5;

					// Dynamic surface line at this column (including sloshing & wall climb)
					const currentSurfaceY = baseSurfaceY + surfaceOffsets[c];

					// Check if this cell is submerged in the thick solid water body, or holds an airborne splash droplet
					const isSubmerged = cy >= (currentSurfaceY - stepY * 0.45);
					const hasDroplet = dropletMap[r * cols + c] === 1;

					const targetA = (isSubmerged || hasDroplet) ? 1.0 : 0.0;
					const localEnergy = Math.min(1.0, Math.abs(surfaceVelocities[c]) * 0.25 + (hasDroplet ? 0.7 : 0.0));

					// Smooth appearance transition
					cellAlpha[r][c] += (targetA - cellAlpha[r][c]) * 0.28;
					cellEnergy[r][c] += (localEnergy - cellEnergy[r][c]) * 0.2;

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						activeCardsCount++;
						// Dynamic theme color: deep rich base at bottom -> vibrant primary -> light crest
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = Math.max(0.48, Math.min(0.98, currentA));
						const outlineA = Math.max(0.12, Math.min(0.36, currentA * 0.36));

						// Strictly fixed position and shape (no rotation, no warping)
						drawCardTile(cx, cy, cardW, cardH, cr, cg, cb, cardAlpha, outlineA);
					} else {
						// Subtle ghost baseline card slot outline for elegant Material structural matrix
						ctx.beginPath();
						if (typeof ctx.roundRect === "function") {
							ctx.roundRect(cx - cardW * 0.5, cy - cardH * 0.5, cardW, cardH, cardRadius);
						}
						ctx.lineWidth = 1;
						ctx.strokeStyle = "rgba(255, 255, 255, 0.025)";
						ctx.stroke();
					}
				}
			}

			// Telemetry status
			if (telemetry) {
				const waveAmp = Math.abs(surfaceOffsets[0]).toFixed(1);
				const statusTag = isHovered && mouseSpeed > 3 ? "TURBULENT SURGE" : (Math.abs(surfaceVelocities[0]) > 0.5 ? "SLOSHING & CLIMBING" : "STEADY TIDE");
				telemetry.textContent = `FLUID·VOXEL // RESERVOIR: 60% (3/5) // SOLID BODY // ACTIVE: ${activeCardsCount} // ${statusTag}`;
			}

			let mouseSpeed = Math.hypot(mouseVx, mouseVy);

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				splashTrigger = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				splashTrigger = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
