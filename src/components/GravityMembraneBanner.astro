---
// GravityMembraneBanner.astro: Material Card-based Fluid Reservoir Banner
// Acts as a spacious half-filled container: fluid sits entirely at the bottom,
// leaving the upper spacious half open for custom user content (via default slot).
---

<div class="fluid-reservoir-hero" id="fluid-hero-container">
	<div class="fluid-reservoir-viewport" id="fluid-banner-root">
		<!-- Canvas simulating fluid at container bottom -->
		<canvas id="fluid-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper Spacious Zone: Reserved for user-defined content / slot -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Subtle technical telemetry at bottom corner -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">CONTAINER: 48% CAPACITY // KINETIC: 1.00 // SURFACE: CALM</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="fluid-scroll-down" id="fluid-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-glyph-wrap">
				<span class="glyph-bar"></span>
				<mdui-icon-keyboard-arrow-down--outlined class="glyph-chevron"></mdui-icon-keyboard-arrow-down--outlined>
			</div>
		</button>
	</div>
</div>

<style>
	.fluid-reservoir-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		/* Large spacious container height */
		height: 520px;
		max-height: 580px;
		min-height: 420px;
		margin-top: -20px; /* Align to top navigation flush */
		margin-bottom: 24px;
		overflow: hidden;
	}

	.fluid-reservoir-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 30%, rgba(26, 28, 38, 0.95) 0%, rgba(12, 13, 18, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.16);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .fluid-reservoir-viewport {
		background: radial-gradient(circle at 50% 30%, rgba(18, 20, 30, 0.96) 0%, rgba(8, 9, 14, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#fluid-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 52%; /* Upper half open for titles, badges, etc. */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 3;
		padding: 24px;
		box-sizing: border-box;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 16px;
		right: 24px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 4;
	}

	.fluid-reservoir-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: #38bdf8;
		text-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
	}

	/* Minimalist scroll down indicator */
	.fluid-scroll-down {
		position: absolute;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 8px 12px;
		cursor: pointer;
		color: #38bdf8;
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 4;
		outline: none;
	}

	.fluid-scroll-down:hover {
		opacity: 1;
		color: #67e8f9;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-glyph-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		animation: fluid-bob 2.2s ease-in-out infinite;
	}

	.glyph-bar {
		width: 2px;
		height: 12px;
		background: currentColor;
		border-radius: 9999px;
		margin-bottom: -4px;
		opacity: 0.8;
	}

	.glyph-chevron {
		font-size: 20px;
	}

	@keyframes fluid-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.55;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 640px) {
		.fluid-reservoir-hero {
			height: 380px;
			min-height: 340px;
			margin-bottom: 16px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 10px;
			right: 12px;
		}
		.fluid-scroll-down {
			bottom: 10px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("fluid-banner-root");
		const canvas = document.getElementById("fluid-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("fluid-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll indicator interaction
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("fluid-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let isPressed = false;
		let pressScale = 0;

		// Fluid Grid Configuration: bottom-filled reservoir
		let COLS = 54;
		let ROWS = 13;

		// Free surface 1D wave heights and velocities for water sloshing
		let surfaceOffsets = [];
		let surfaceVelocities = [];

		class ReservoirCardNode {
			constructor(c, r) {
				this.c = c; // column [0, COLS-1]
				this.r = r; // row [0, ROWS-1], 0 is surface, ROWS-1 is container bed
				this.originX = 0;
				this.originY = 0;
				this.x = 0;
				this.y = 0;
				this.vx = 0;
				this.vy = 0;
				this.speed = 0;
				this.angle = 0;
				this.energy = 0;
			}
		}

		let nodes = [];

		function initGrid() {
			nodes = [];
			surfaceOffsets = new Array(COLS).fill(0);
			surfaceVelocities = new Array(COLS).fill(0);

			for (let r = 0; r < ROWS; r++) {
				for (let c = 0; c < COLS; c++) {
					const node = new ReservoirCardNode(c, r);
					nodes.push(node);
				}
			}
			updateNodePositions();
		}

		function updateNodePositions() {
			// Water level starts at ~52% height of the container, filling downwards to 100%
			const surfaceBaseY = height * 0.52;
			const fluidDepth = height - surfaceBaseY - 12; // 12px bottom padding
			const colWidth = width / (COLS - 1);

			for (let i = 0; i < nodes.length; i++) {
				const n = nodes[i];
				n.originX = n.c * colWidth;
				const rowT = n.r / (ROWS - 1); // 0 (surface) to 1 (bed)
				n.originY = surfaceBaseY + rowT * fluidDepth;
				n.x = n.originX;
				n.y = n.originY;
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			if (width < 640) {
				COLS = 34;
				ROWS = 10;
			} else if (width < 1024) {
				COLS = 46;
				ROWS = 12;
			} else {
				COLS = 58;
				ROWS = 14;
			}

			initGrid();
		}

		// Palette interpolation for mini Material 3 cards
		// Reflects depth (abyss to surface) + kinetic vorticity
		// Deep bed: Deep ocean navy/indigo -> Mid water: Turquoise/Cyan -> Surface: Mint/Emerald/Coral
		function getFluidColor(depthRatio, speedRatio, angle) {
			// depthRatio: 0 (surface) to 1 (container bottom bed)
			// Angle influence for swirl variation
			const angleHueShift = Math.sin(angle) * 0.18;
			const effectiveDepth = Math.max(0, Math.min(1, depthRatio + angleHueShift));

			let r, g, b;
			if (effectiveDepth > 0.65) {
				// Deep Bed: Deep Navy & Indigo
				const t = (effectiveDepth - 0.65) / 0.35;
				r = Math.round(14 + (30 - 14) * t);
				g = Math.round(56 + (41 - 56) * t);
				b = Math.round(122 + (99 - 122) * t);
			} else if (effectiveDepth > 0.3) {
				// Mid Water: Bright Cyan to Ocean Blue
				const t = (effectiveDepth - 0.3) / 0.35;
				r = Math.round(6 + (14 - 6) * t);
				g = Math.round(182 + (56 - 182) * t);
				b = Math.round(212 + (122 - 212) * t);
			} else {
				// Surface Layer: Mint / Coral / Amber
				const t = effectiveDepth / 0.3;
				if (speedRatio > 0.4) {
					// High agitation: Warm Coral & Golden Amber
					r = Math.round(244 + (251 - 244) * speedRatio);
					g = Math.round(63 + (191 - 63) * speedRatio);
					b = Math.round(94 + (36 - 94) * speedRatio);
				} else {
					// Calm surface: Vibrant Mint / Aquamarine
					r = Math.round(16 + (6 - 16) * t);
					g = Math.round(185 + (182 - 185) * t);
					b = Math.round(129 + (212 - 129) * t);
				}
			}

			return [r, g, b];
		}

		// Helper to draw a sleek rounded rectangular mini-card
		function drawMiniCard(cx, cy, w, h, radius, rotAngle, r, g, b, alpha) {
			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(rotAngle);

			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = Math.min(radius, halfW, halfH);

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(-halfW, -halfH, w, h, cr);
			} else {
				ctx.moveTo(-halfW + cr, -halfH);
				ctx.lineTo(halfW - cr, -halfH);
				ctx.quadraticCurveTo(halfW, -halfH, halfW, -halfH + cr);
				ctx.lineTo(halfW, halfH - cr);
				ctx.quadraticCurveTo(halfW, halfH, halfW - cr, halfH);
				ctx.lineTo(-halfW + cr, halfH);
				ctx.quadraticCurveTo(-halfW, halfH, -halfW, halfH - cr);
				ctx.lineTo(-halfW, -halfH + cr);
				ctx.quadraticCurveTo(-halfW, -halfH, -halfW + cr, -halfH);
				ctx.closePath();
			}

			// MDUI Solid Card Surface Fill
			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Subtle Card Outline for Material Design definition
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${Math.min(0.24, alpha * 0.3)})`;
			ctx.stroke();

			ctx.restore();
		}

		let time = 0;

		function render() {
			time += 0.016;

			// Mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.5;
				mouseVy = (mouseY - prevMouseY) * 0.5;
			} else {
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			if (isPressed) {
				pressScale += (1 - pressScale) * 0.14;
			} else {
				pressScale += (0 - pressScale) * 0.08;
			}

			// 1. Solve 1D Free Water Surface Sloshing Wave Equation (Spring-mass mesh)
			const surfaceBaseY = height * 0.52;
			const tension = 0.035;
			const springK = 0.045;
			const damping = 0.94;

			for (let c = 0; c < COLS; c++) {
				const left = c > 0 ? surfaceOffsets[c - 1] : surfaceOffsets[c];
				const right = c < COLS - 1 ? surfaceOffsets[c + 1] : surfaceOffsets[c];
				
				// Wave propagation acceleration
				const force = -springK * surfaceOffsets[c] + tension * (left + right - 2 * surfaceOffsets[c]);
				surfaceVelocities[c] = (surfaceVelocities[c] + force) * damping;
			}

			// Apply surface offsets
			for (let c = 0; c < COLS; c++) {
				surfaceOffsets[c] += surfaceVelocities[c];
			}

			// Mouse interaction with fluid surface & body
			if (isHovered) {
				const colWidth = width / (COLS - 1);
				const mouseCol = Math.round(mouseX / colWidth);

				// If mouse crosses or is near the water line, excite sloshing wave
				if (mouseY > surfaceBaseY - 60 && mouseY < height) {
					const mouseSpeed = Math.hypot(mouseVx, mouseVy);
					const splashRadius = Math.max(2, Math.round(3 + mouseSpeed * 0.4));
					
					for (let dc = -splashRadius; dc <= splashRadius; dc++) {
						const c = mouseCol + dc;
						if (c >= 0 && c < COLS) {
							const factor = 1 - Math.abs(dc) / splashRadius;
							// Push water down or pull up with mouse velocity
							surfaceVelocities[c] += (mouseVy * 0.15 + (isPressed ? 1.5 : 0.2)) * factor;
						}
					}
				}
			}

			ctx.clearRect(0, 0, width, height);

			let maxFlowSpeed = 0;
			let totalKinetic = 0;

			// Internal fluid vorticity frequencies
			const kx = 1.8;
			const ky = 3.2;

			for (let i = 0; i < nodes.length; i++) {
				const n = nodes[i];
				const depthT = n.r / (ROWS - 1); // 0 (surface) to 1 (bed)

				// Surface wave displacement transmitted downwards
				// Attenuates with depth (deep water barely feels the sloshing surface)
				const depthDecay = Math.pow(1 - depthT, 1.4);
				const surfaceDisplacement = surfaceOffsets[n.c] * depthDecay;

				// 2D Incompressible streamfunction velocity in the reservoir
				const normX = (n.c / (COLS - 1)) * 2 - 1; // [-1, 1]
				const normY = depthT; // [0, 1]
				
				// Gentle natural internal convection in the liquid
				const fluidVx = Math.sin(normY * ky + time * 0.9) * (1.2 * (1 - depthT * 0.5)) + Math.cos(normX * kx - time * 0.6) * 0.6;
				const fluidVy = Math.cos(normX * kx + time * 0.9) * 0.8 * depthDecay;

				// Mouse agitation inside fluid
				let mousePushX = 0;
				let mousePushY = 0;
				if (isHovered && mouseY > surfaceBaseY - 40) {
					const dx = n.x - mouseX;
					const dy = n.y - mouseY;
					const dist = Math.hypot(dx, dy);
					const radius = 120 + pressScale * 60;

					if (dist < radius && dist > 1) {
						const proximity = 1 - dist / radius;
						// Tangential swirl + linear drag
						const tangentX = -dy / dist;
						const tangentY = dx / dist;
						const pushMag = proximity * (16 + pressScale * 25);

						mousePushX = mouseVx * proximity * 0.7 + tangentX * pushMag * 0.4;
						mousePushY = mouseVy * proximity * 0.7 + tangentY * pushMag * 0.4;
					}
				}

				// Target velocity
				const targetVx = fluidVx + mousePushX;
				const targetVy = fluidVy + mousePushY;

				n.vx += (targetVx - n.vx) * 0.18;
				n.vy += (targetVy - n.vy) * 0.18;

				// Spring anchoring to stay within the bottom-filled grid lattice
				const spring = 0.14;
				const dispX = n.x - n.originX;
				const dispY = n.y - (n.originY + surfaceDisplacement);

				n.x += n.vx * 1.3 - dispX * spring;
				n.y += n.vy * 1.3 - dispY * spring;

				// Keep within container horizontal & bottom bounds
				if (n.y > height - 6) n.y = height - 6;

				const curSpeed = Math.hypot(n.vx, n.vy);
				n.speed = curSpeed;
				n.angle = Math.atan2(n.vy, n.vx);
				n.energy += (curSpeed - n.energy) * 0.14;

				if (curSpeed > maxFlowSpeed) maxFlowSpeed = curSpeed;
				totalKinetic += curSpeed;

				// Card size scaling:
				// Surface & high energy: Large (~14px to 20px)
				// Deep water / calm bed: Compact (~9px to 12px)
				const speedRatio = Math.min(1.0, curSpeed / 4.0);
				const baseW = 9 + (1 - depthT * 0.4) * 4 + speedRatio * 7;
				const baseH = 8 + (1 - depthT * 0.4) * 3 + speedRatio * 4;
				const cardRadius = Math.min(baseW, baseH) * 0.28;

				// Color from fluid depth and kinetic activity
				const [cr, cg, cb] = getFluidColor(depthT, speedRatio, n.angle);
				const cardAlpha = Math.max(0.25, Math.min(0.92, 0.4 + (1 - depthT * 0.25) * 0.35 + speedRatio * 0.25));

				// Draw mini MDUI-card tile
				drawMiniCard(
					n.x,
					n.y,
					baseW,
					baseH,
					cardRadius,
					n.angle * 0.4, // subtle inclination
					cr,
					cg,
					cb,
					cardAlpha
				);
			}

			// Telemetry info update
			if (telemetry) {
				const avgKinetic = (totalKinetic / Math.max(1, nodes.length)).toFixed(2);
				const surfState = Math.abs(surfaceVelocities[Math.floor(COLS / 2)]) > 0.8 ? "WAVY" : "CALM";
				telemetry.textContent = `CONTAINER: 48% CAPACITY // KINETIC: ${avgKinetic} // SURFACE: ${surfState}`;
			}

			requestAnimationFrame(render);
		}

		// Event listeners
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			isPressed = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				isPressed = true;
			}
		});

		window.addEventListener("mouseup", () => {
			isPressed = false;
		});

		// Touch interaction
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				isPressed = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isPressed = false;
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		resize();
		requestAnimationFrame(render);
	})();
</script>
