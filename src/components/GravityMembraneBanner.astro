---
// GravityMembraneBanner.astro: Fixed-Grid Active Fluid Reservoir Banner
// Features:
// - Fixed-position MDUI card grid (strictly zero position/shape jitter or rotation)
// - Baseline fluid depth at rest occupies 1/5 (20%) of the banner height
// - Active sloshing waves & wall collision climbs reach up to 3/5 (40% from top)
// - Cards toggle on/off purely through cell activation (like Yusuke Endoh IOCCC ASCII fluid simulation)
// - Continuous autonomous wave dynamics, wall run-up & internal vortex convection
// - Strict Material Theme color & gradient transitions
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating active fluid card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%; /* Upper area open for custom titles/badges/cards */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let splashTrigger = false;

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		// All cell positions (cx, cy) and dimensions (cardW, cardH) are 100% fixed & invariant
		let cols = 0;
		let rows = 0;
		let stepX = 46;
		let stepY = 36;
		let cardW = 38;
		let cardH = 28;
		let cardRadius = 7;
		let gridStartY = 0;

		// Water configuration:
		// Baseline fluid resting depth is 1/5 (20%) of banner height
		// Splashes, waves, and wall collision climb reach up to 3/5 (40% from top)
		let baseSurfaceY = 0;
		let surfaceOffsets = [];
		let surfaceVelocities = [];

		// Airborne splash droplet particles
		const droplets = [];

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Baseline water depth: 1/5 (20%) of height
			const waterDepth = height * 0.20;
			baseSurfaceY = height - waterDepth; // y = 0.80 * height

			// Grid coverage starts at ~38% height (around the 3/5 line from bottom)
			// This gives ample headroom for wall impact climbs, surges, and splash droplets
			gridStartY = height * 0.38;
			const totalActiveH = height - gridStartY - 10;

			const targetStepX = width < 640 ? 36 : (width < 1100 ? 44 : 48);
			const targetStepY = width < 640 ? 28 : 34;

			cols = Math.floor(width / targetStepX);
			stepX = width / cols;
			cardW = Math.round(stepX * 0.82);

			rows = Math.max(10, Math.floor(totalActiveH / targetStepY));
			stepY = totalActiveH / rows;
			cardH = Math.round(stepY * 0.82);
			cardRadius = Math.round(Math.min(cardW, cardH) * 0.28);

			surfaceOffsets = new Float32Array(cols);
			surfaceVelocities = new Float32Array(cols);

			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				const cy = gridStartY + r * stepY + stepY * 0.5;

				for (let c = 0; c < cols; c++) {
					// Initially only cells in the bottom 1/5 are submerged
					if (cy >= baseSurfaceY - stepY * 0.25) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}

			droplets.length = 0;
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Theme Color and Gradient Palette:
		// Dynamic illumination based on depth and fluid kinetic energy
		function getThemeGradientColor(energyRatio, depthRatio) {
			const [pr, pg, pb] = primaryColor;

			// Deep tone at the container bed
			const deepR = Math.round(pr * 0.40);
			const deepG = Math.round(pg * 0.44);
			const deepB = Math.round(pb * 0.60);

			// Bright crest/splash highlight
			const crestR = Math.round(pr + (255 - pr) * 0.75);
			const crestG = Math.round(pg + (255 - pg) * 0.75);
			const crestB = Math.round(pb + (255 - pb) * 0.90);

			// Balance depth and kinetic excitation
			const t = Math.max(0, Math.min(1.0, (1.0 - depthRatio) * 0.55 + energyRatio * 0.60));

			let r, g, b;
			if (t < 0.5) {
				const subT = t / 0.5;
				r = Math.round(deepR + (pr - deepR) * subT);
				g = Math.round(deepG + (pg - deepG) * subT);
				b = Math.round(deepB + (pb - deepB) * subT);
			} else {
				const subT = (t - 0.5) / 0.5;
				r = Math.round(pr + (crestR - pr) * subT);
				g = Math.round(pg + (crestG - pg) * subT);
				b = Math.round(pb + (crestB - pb) * subT);
			}

			return [r, g, b];
		}

		// Draw fixed-position, non-rotating MDUI Card tile
		function drawCardTile(cx, cy, w, h, r, g, b, alpha, outlineAlpha) {
			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - halfW, cy - halfH, w, h, cr);
			} else {
				ctx.moveTo(cx - halfW + cr, cy - halfH);
				ctx.lineTo(cx + halfW - cr, cy - halfH);
				ctx.quadraticCurveTo(cx + halfW, cy - halfH, cx + halfW, cy - halfH + cr);
				ctx.lineTo(cx + halfW, cy + halfH - cr);
				ctx.quadraticCurveTo(cx + halfW, cy + halfH, cx + halfW - cr, cy + halfH);
				ctx.lineTo(cx - halfW + cr, cy + halfH);
				ctx.quadraticCurveTo(cx - halfW, cy + halfH, cx - halfW, cy + halfH - cr);
				ctx.lineTo(cx - halfW, cy - halfH + cr);
				ctx.quadraticCurveTo(cx - halfW, cy - halfH, cx - halfW + cr, cy - halfH);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Clean Material stroke
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updatePhysics() {
			time += 0.018;

			// Mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.8;
				mouseVy = (mouseY - prevMouseY) * 0.8;
			} else {
				mouseVx *= 0.88;
				mouseVy *= 0.88;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// 1. High-Energy Perpetual Sloshing & Wall Collision Dynamics
			// Maximum wave climb can reach the 3/5 mark (gridStartY: ~0.38*height, offset ~ -0.42*height)
			const maxSloshReach = height * 0.38; // Max amplitude allowed toward 3/5 position
			const sloshFreq = 1.15;
			const baseSlosh = Math.sin(time * sloshFreq);
			const secondSlosh = Math.sin(time * 2.3 + 0.4) * 0.35;

			const tension = 0.048;
			const springK = 0.026;
			const damping = 0.962;

			for (let c = 0; c < cols; c++) {
				const colNorm = (c / (cols - 1)) * 2.0 - 1.0; // [-1.0 (left wall), 1.0 (right wall)]
				const absCol = Math.abs(colNorm);

				// Wall impact run-up: when water rushes towards left/right wall, non-linear steepening pushes it way up
				const wallDirection = colNorm < 0 ? -1.0 : 1.0;
				const sloshDirection = baseSlosh; // positive tilts right, negative tilts left
				const isHittingWall = (wallDirection * sloshDirection) < 0;

				let wallClimb = 0;
				if (isHittingWall) {
					// Water climbs up the wall due to momentum conservation
					const climbFactor = Math.pow(absCol, 2.8);
					wallClimb = -Math.abs(baseSlosh + secondSlosh) * maxSloshReach * climbFactor;
				} else {
					// Water recedes away from this wall
					const recedeFactor = Math.pow(absCol, 1.8);
					wallClimb = Math.abs(baseSlosh) * (height * 0.12) * recedeFactor;
				}

				// Cross traveling ripple waves
				const ripple1 = Math.sin(c * 0.28 - time * 3.2) * (height * 0.035);
				const ripple2 = Math.cos(c * 0.45 + time * 2.4) * (height * 0.02);

				const targetWaveOffset = wallClimb + ripple1 + ripple2;

				const left = c > 0 ? surfaceOffsets[c - 1] : surfaceOffsets[c];
				const right = c < cols - 1 ? surfaceOffsets[c + 1] : surfaceOffsets[c];

				// Spring-mass wave equation
				const waveForce = -springK * (surfaceOffsets[c] - targetWaveOffset) + tension * (left + right - 2.0 * surfaceOffsets[c]);
				surfaceVelocities[c] = (surfaceVelocities[c] + waveForce) * damping;
			}

			for (let c = 0; c < cols; c++) {
				surfaceOffsets[c] += surfaceVelocities[c];
				// Hard limit to ensure waves never clip above 3/5 boundary
				const minOffset = -(baseSurfaceY - gridStartY);
				if (surfaceOffsets[c] < minOffset) {
					surfaceOffsets[c] = minOffset;
					surfaceVelocities[c] = 0;
				}
			}

			// Spontaneous ejection of airborne droplets when waves crash against the wall
			if (Math.abs(baseSlosh) > 0.88 && Math.random() < 0.25) {
				const isLeft = baseSlosh < 0;
				const ejectX = isLeft ? Math.random() * 80 : (width - Math.random() * 80);
				droplets.push({
					x: ejectX,
					y: gridStartY + Math.random() * 40,
					vx: (isLeft ? 1 : -1) * (2 + Math.random() * 6),
					vy: -(4 + Math.random() * 8),
					life: 1.0
				});
			}

			// 2. Mouse interaction: disturbances, waves & splashes
			if (isHovered && mouseY > gridStartY - 60) {
				const mouseCol = Math.max(0, Math.min(cols - 1, Math.round(mouseX / stepX)));
				const mouseSpeed = Math.hypot(mouseVx, mouseVy);
				const influenceRadius = Math.max(2, Math.round(3 + mouseSpeed * 0.45));

				for (let dc = -influenceRadius; dc <= influenceRadius; dc++) {
					const c = mouseCol + dc;
					if (c >= 0 && c < cols) {
						const factor = 1.0 - Math.abs(dc) / influenceRadius;
						surfaceVelocities[c] += (mouseVy * 0.48) * factor;

						if (splashTrigger) {
							// Plunge or splash on click
							surfaceVelocities[c] -= 22.0 * factor;
						}
					}
				}

				// Click triggers vibrant airborne droplet splashes
				if (splashTrigger) {
					const dropCount = Math.min(28, Math.round(14 + mouseSpeed * 0.9));
					for (let k = 0; k < dropCount; k++) {
						droplets.push({
							x: mouseX + (Math.random() - 0.5) * 50,
							y: Math.max(gridStartY, mouseY) + (Math.random() - 0.5) * 20,
							vx: mouseVx * 0.55 + (Math.random() - 0.5) * 18,
							vy: -(10 + Math.random() * 18 + Math.abs(mouseVy) * 0.5),
							life: 1.0
						});
					}
				}
			}

			// 3. Update airborne droplets
			for (let i = droplets.length - 1; i >= 0; i--) {
				const d = droplets[i];
				d.vy += 0.65; // Gravity
				d.x += d.vx;
				d.y += d.vy;
				d.life -= 0.022;

				const dCol = Math.floor(d.x / stepX);
				const surfAtX = dCol >= 0 && dCol < cols ? (baseSurfaceY + surfaceOffsets[dCol]) : baseSurfaceY;

				// Collision with water surface
				if (d.y >= surfAtX && d.vy > 0) {
					if (dCol >= 0 && dCol < cols) {
						surfaceVelocities[dCol] += 3.8; // Creates ripple upon reentry
					}
					droplets.splice(i, 1);
				} else if (d.life <= 0 || d.x < 0 || d.x > width) {
					droplets.splice(i, 1);
				}
			}

			splashTrigger = false;
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			// Droplet spatial occupancy map for airborne card activation
			const dropletMap = new Uint8Array(rows * cols);
			for (let i = 0; i < droplets.length; i++) {
				const d = droplets[i];
				const c = Math.floor(d.x / stepX);
				const r = Math.floor((d.y - gridStartY) / stepY);
				if (c >= 0 && c < cols && r >= 0 && r < rows) {
					dropletMap[r * cols + c] = 1;
				}
			}

			// Render the fixed grid matrix:
			// Expresses dynamic fluid motion strictly via cell activation (turning cards on/off like ASCII characters)
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * stepY + stepY * 0.5;
				// Depth ratio relative to the active water zone
				const depthRatio = Math.max(0, Math.min(1.0, (cy - gridStartY) / (height - gridStartY)));

				for (let c = 0; c < cols; c++) {
					const cx = c * stepX + stepX * 0.5;

					// Dynamic surface Y at this column (sloshing + wall climb)
					const currentSurfaceY = baseSurfaceY + surfaceOffsets[c];

					// Check if this cell is submerged in the moving water body, or occupied by a splash droplet
					const isSubmerged = cy >= (currentSurfaceY - stepY * 0.28);
					const hasDroplet = dropletMap[r * cols + c] === 1;

					// Internal fluid velocity & convection to give rich vitality (never static)
					const internalVortex = Math.sin(r * 0.65 + time * 2.2) * 0.5 + Math.cos(c * 0.4 - time * 1.8) * 0.5;
					const surfaceActivity = Math.abs(surfaceVelocities[c]) * 0.22;
					const cellKinetic = Math.min(1.0, surfaceActivity + Math.abs(internalVortex) * 0.45 + (hasDroplet ? 0.85 : 0.0));

					const targetA = (isSubmerged || hasDroplet) ? 1.0 : 0.0;

					// Responsive cell activation/deactivation (fast fade out to ensure crisp fluid wave shape)
					const lerpSpeed = targetA > cellAlpha[r][c] ? 0.45 : 0.35;
					cellAlpha[r][c] += (targetA - cellAlpha[r][c]) * lerpSpeed;
					cellEnergy[r][c] += (cellKinetic - cellEnergy[r][c]) * 0.25;

					const currentA = cellAlpha[r][c];

					if (currentA > 0.05) {
						// Dynamic theme color based on kinetic excitation and depth
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = Math.max(0.45, Math.min(0.96, currentA));
						const outlineA = Math.max(0.12, Math.min(0.35, currentA * 0.35));

						// Strictly fixed position and shape (no rotation, no warping)
						drawCardTile(cx, cy, cardW, cardH, cr, cg, cb, cardAlpha, outlineA);
					} else {
						// Subtle ghost baseline card slot outline for elegant Material structural matrix
						ctx.beginPath();
						if (typeof ctx.roundRect === "function") {
							ctx.roundRect(cx - cardW * 0.5, cy - cardH * 0.5, cardW, cardH, cardRadius);
						}
						ctx.lineWidth = 1;
						ctx.strokeStyle = "rgba(255, 255, 255, 0.02)";
						ctx.stroke();
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				splashTrigger = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				splashTrigger = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
