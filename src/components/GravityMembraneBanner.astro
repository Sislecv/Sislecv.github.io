---
// GravityMembraneBanner.astro: Fixed-Grid Active Fluid Reservoir Banner
// Features:
// - Fixed-position MDUI card grid (strictly zero position/shape jitter or rotation)
// - Baseline fluid depth at rest occupies 1/5 (20%) of banner height
// - Smooth physical wave dynamics & wall run-up reaching up to 3/5 (40% from top)
// - No airborne artificial droplets: purely continuous, physical fluid body
// - Slow, natural and heavy fluid sloshing & traveling gravity waves
// - Interactive mouse color excitation (proximity glow + expanding wave ripples)
// - Strict Material Theme color & gradient transitions
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating active fluid card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%; /* Upper area open for custom titles/badges/cards */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let mouseSpeed = 0;
		let isHovered = false;

		// Interactive expanding ripples for color disturbance
		const ripples = [];

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		// All cell positions (cx, cy) and dimensions (cardW, cardH) are 100% fixed & invariant
		let cols = 0;
		let rows = 0;
		let stepX = 46;
		let stepY = 36;
		let cardW = 38;
		let cardH = 28;
		let cardRadius = 7;
		let gridStartY = 0;

		// Water configuration:
		// Baseline fluid depth: 1/5 (20%) of height at rest
		// Wave surges and wall climbs can reach up to 3/5 mark (40% from top)
		let baseSurfaceY = 0;
		let surfaceOffsets = [];
		let surfaceVelocities = [];

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Baseline water depth: exactly 1/5 (20%) of banner height
			const waterDepth = height * 0.20;
			baseSurfaceY = height - waterDepth; // y = 0.80 * height

			// Grid coverage starts at 38% height (around the 3/5 line from container bottom)
			// This covers the entire active water range up to the 3/5 surge level
			gridStartY = height * 0.38;
			const totalActiveH = height - gridStartY - 10;

			const targetStepX = width < 640 ? 36 : (width < 1100 ? 44 : 48);
			const targetStepY = width < 640 ? 28 : 34;

			cols = Math.floor(width / targetStepX);
			stepX = width / cols;
			cardW = Math.round(stepX * 0.82);

			rows = Math.max(10, Math.floor(totalActiveH / targetStepY));
			stepY = totalActiveH / rows;
			cardH = Math.round(stepY * 0.82);
			cardRadius = Math.round(Math.min(cardW, cardH) * 0.28);

			surfaceOffsets = new Float32Array(cols);
			surfaceVelocities = new Float32Array(cols);

			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				const cy = gridStartY + r * stepY + stepY * 0.5;

				for (let c = 0; c < cols; c++) {
					// Initially only cells in the bottom 1/5 are submerged
					if (cy >= baseSurfaceY - stepY * 0.25) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}

			ripples.length = 0;
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Theme Color and Gradient Palette:
		// Dynamic illumination with smooth color transitions driven by mouse interaction & fluid motion
		function getThemeGradientColor(energyRatio, depthRatio) {
			const [pr, pg, pb] = primaryColor;

			// Deep tone at the container bed
			const deepR = Math.round(pr * 0.38);
			const deepG = Math.round(pg * 0.42);
			const deepB = Math.round(pb * 0.58);

			// Vibrant crest and mouse-excited luminous highlight
			const crestR = Math.round(pr + (255 - pr) * 0.82);
			const crestG = Math.round(pg + (255 - pg) * 0.82);
			const crestB = Math.round(pb + (255 - pb) * 0.95);

			// t blends depth with interactive/kinetic excitation
			const t = Math.max(0, Math.min(1.0, (1.0 - depthRatio) * 0.45 + energyRatio * 0.70));

			let r, g, b;
			if (t < 0.45) {
				const subT = t / 0.45;
				r = Math.round(deepR + (pr - deepR) * subT);
				g = Math.round(deepG + (pg - deepG) * subT);
				b = Math.round(deepB + (pb - deepB) * subT);
			} else {
				const subT = (t - 0.45) / 0.55;
				r = Math.round(pr + (crestR - pr) * subT);
				g = Math.round(pg + (crestG - pg) * subT);
				b = Math.round(pb + (crestB - pb) * subT);
			}

			return [r, g, b];
		}

		// Draw fixed-position, non-rotating MDUI Card tile
		function drawCardTile(cx, cy, w, h, r, g, b, alpha, outlineAlpha) {
			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - halfW, cy - halfH, w, h, cr);
			} else {
				ctx.moveTo(cx - halfW + cr, cy - halfH);
				ctx.lineTo(cx + halfW - cr, cy - halfH);
				ctx.quadraticCurveTo(cx + halfW, cy - halfH, cx + halfW, cy - halfH + cr);
				ctx.lineTo(cx + halfW, cy + halfH - cr);
				ctx.quadraticCurveTo(cx + halfW, cy + halfH, cx + halfW - cr, cy + halfH);
				ctx.lineTo(cx - halfW + cr, cy + halfH);
				ctx.quadraticCurveTo(cx - halfW, cy + halfH, cx - halfW, cy + halfH - cr);
				ctx.lineTo(cx - halfW, cy - halfH + cr);
				ctx.quadraticCurveTo(cx - halfW, cy - halfH, cx - halfW + cr, cy - halfH);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Clean Material stroke
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updatePhysics() {
			// Slower, more majestic fluid physical time progression
			time += 0.009;

			// Mouse velocity & speed tracking
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mouseSpeed = mouseSpeed * 0.8 + dist * 0.2;
				mouseVx = (mouseX - prevMouseX) * 0.7;
				mouseVy = (mouseY - prevMouseY) * 0.7;

				// Spawn expanding color ripples when moving briskly
				if (mouseSpeed > 3.2 && Math.random() < 0.4) {
					ripples.push({
						x: mouseX,
						y: mouseY,
						radius: 8,
						strength: Math.min(1.0, mouseSpeed * 0.1),
						decay: 0.02
					});
					if (ripples.length > 20) ripples.shift();
				}
			} else {
				mouseSpeed *= 0.88;
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Update expanding interactive ripples
			for (let i = ripples.length - 1; i >= 0; i--) {
				const rp = ripples[i];
				rp.radius += 4.8;
				rp.strength -= rp.decay;
				if (rp.strength <= 0) {
					ripples.splice(i, 1);
				}
			}

			// 1. Natural, Slow, Physical Gravity Waves & Sloshing
			// Realistic container sloshing: low natural frequency (approx 7-9s cycle), heavy water inertia
			const maxWaveClimb = height * 0.38; // Max surge up to 3/5 mark
			const primaryFreq = 0.58; // Slower, calm, natural wave pacing
			const primaryWave = Math.sin(time * primaryFreq);
			const secondaryWave = Math.sin(time * 1.15 + 0.5) * 0.32;

			// Surface tension & shallow water wave coupling constants
			const tension = 0.038;
			const springK = 0.016;
			const damping = 0.978; // Higher momentum conservation for heavier fluid inertia

			for (let c = 0; c < cols; c++) {
				const colNorm = (c / (cols - 1)) * 2.0 - 1.0; // [-1.0 left wall, 1.0 right wall]
				const absCol = Math.abs(colNorm);

				// Fluid wall run-up & reflection:
				// As water pushes into a wall, conservation of head pushes it up smoothly into a crest
				const wallSide = colNorm < 0 ? -1.0 : 1.0;
				const currentTilt = primaryWave + secondaryWave;
				const isPushingWall = (wallSide * currentTilt) < 0;

				let wallTarget = 0;
				if (isPushingWall) {
					// Smooth, non-linear hydraulic run-up along the wall
					const surgeProfile = Math.pow(absCol, 2.4);
					wallTarget = -Math.abs(currentTilt) * maxWaveClimb * surgeProfile;
				} else {
					// Drawdown on the opposite side
					const drawProfile = Math.pow(absCol, 1.5);
					wallTarget = Math.abs(currentTilt) * (height * 0.09) * drawProfile;
				}

				// Gentle traveling swells propagating across the surface
				const swell1 = Math.sin(c * 0.18 - time * 1.8) * (height * 0.026);
				const swell2 = Math.cos(c * 0.32 + time * 1.4) * (height * 0.015);

				const targetWaveOffset = wallTarget + swell1 + swell2;

				const left = c > 0 ? surfaceOffsets[c - 1] : surfaceOffsets[c];
				const right = c < cols - 1 ? surfaceOffsets[c + 1] : surfaceOffsets[c];

				// Discrete wave equation with Laplace curvature and restoring spring
				const waveForce = -springK * (surfaceOffsets[c] - targetWaveOffset) + tension * (left + right - 2.0 * surfaceOffsets[c]);
				surfaceVelocities[c] = (surfaceVelocities[c] + waveForce) * damping;
			}

			// Integrate wave velocities
			for (let c = 0; c < cols; c++) {
				surfaceOffsets[c] += surfaceVelocities[c];

				// Physical ceiling clamp: guarantees fluid never overshoots the 3/5 mark
				const minOffset = -(baseSurfaceY - gridStartY);
				if (surfaceOffsets[c] < minOffset) {
					surfaceOffsets[c] = minOffset;
					surfaceVelocities[c] = 0;
				}
			}

			// 2. Physical mouse disturbance on water surface
			if (isHovered && mouseY > gridStartY - 40) {
				const mouseCol = Math.max(0, Math.min(cols - 1, Math.round(mouseX / stepX)));
				const influenceRadius = Math.max(2, Math.round(3 + mouseSpeed * 0.35));

				for (let dc = -influenceRadius; dc <= influenceRadius; dc++) {
					const c = mouseCol + dc;
					if (c >= 0 && c < cols) {
						const factor = 1.0 - Math.abs(dc) / influenceRadius;
						// Gently push water with mouse vertical motion
						surfaceVelocities[c] += (mouseVy * 0.28) * factor;
					}
				}
			}
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			// Render the fixed grid matrix:
			// Continuous physical water body: no sudden drops or disjointed floating boxes
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * stepY + stepY * 0.5;
				// Depth ratio relative to the active reservoir area
				const depthRatio = Math.max(0, Math.min(1.0, (cy - gridStartY) / (height - gridStartY)));

				for (let c = 0; c < cols; c++) {
					const cx = c * stepX + stepX * 0.5;

					// Dynamic surface Y at this column (sloshing + wall climb)
					const currentSurfaceY = baseSurfaceY + surfaceOffsets[c];

					// Check if this cell is submerged in the physical water body
					const isSubmerged = cy >= (currentSurfaceY - stepY * 0.28);

					// 1. Natural internal fluid convection & eddy currents
					const naturalFlow = Math.sin(r * 0.5 + time * 1.4) * 0.35 + Math.cos(c * 0.35 - time * 1.1) * 0.35;
					const surfaceMovement = Math.abs(surfaceVelocities[c]) * 0.18;
					let kineticEnergy = Math.min(0.8, surfaceMovement + Math.abs(naturalFlow) * 0.3);

					// 2. Interactive mouse color excitement (restored original proximity & ripple color effect)
					let interactionEnergy = 0;
					if (isHovered) {
						const dx = cx - mouseX;
						const dy = cy - mouseY;
						const dist = Math.hypot(dx, dy);
						const mouseRadius = 150;

						if (dist < mouseRadius) {
							const proximity = 1.0 - dist / mouseRadius;
							// Vibrant illumination scaling with proximity and mouse speed
							interactionEnergy += Math.pow(proximity, 1.4) * (0.65 + mouseSpeed * 0.08);
						}
					}

					// Expanding ripple wave contribution to color
					for (let j = 0; j < ripples.length; j++) {
						const rp = ripples[j];
						const d = Math.hypot(cx - rp.x, cy - rp.y);
						const diff = Math.abs(d - rp.radius);
						if (diff < 48) {
							const ring = Math.cos((diff / 48) * Math.PI * 0.5) * rp.strength;
							interactionEnergy += ring * 0.75;
						}
					}

					// Combined total excitation
					const totalEnergy = Math.max(0, Math.min(1.0, kineticEnergy + interactionEnergy));

					// Cell activation: submerged cells stay solid; non-submerged cells can show subtle hover glow
					const targetA = isSubmerged ? 1.0 : (interactionEnergy > 0.15 ? Math.min(0.35, interactionEnergy * 0.45) : 0.0);

					// Smooth easing
					const lerpSpeed = targetA > cellAlpha[r][c] ? 0.38 : 0.28;
					cellAlpha[r][c] += (targetA - cellAlpha[r][c]) * lerpSpeed;
					cellEnergy[r][c] += (totalEnergy - cellEnergy[r][c]) * 0.20;

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						// Dynamic theme color: smooth transition from deep water -> vibrant primary -> radiant crest
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = isSubmerged ? Math.max(0.48, Math.min(0.96, currentA)) : currentA;
						const outlineA = Math.max(0.12, Math.min(0.38, 0.12 + cellEnergy[r][c] * 0.26));

						// Strictly fixed position and shape (no rotation, no warping)
						drawCardTile(cx, cy, cardW, cardH, cr, cg, cb, cardAlpha, outlineA);
					} else {
						// Subtle ghost baseline card slot outline for elegant structural matrix
						ctx.beginPath();
						if (typeof ctx.roundRect === "function") {
							ctx.roundRect(cx - cardW * 0.5, cy - cardH * 0.5, cardW, cardH, cardRadius);
						}
						ctx.lineWidth = 1;
						ctx.strokeStyle = "rgba(255, 255, 255, 0.02)";
						ctx.stroke();
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				const rect = root.getBoundingClientRect();
				const clickX = e.clientX - rect.left;
				const clickY = e.clientY - rect.top;
				ripples.push({
					x: clickX,
					y: clickY,
					radius: 10,
					strength: 1.25,
					decay: 0.018
				});
				// Also inject downward force into nearby surface
				const c = Math.max(0, Math.min(cols - 1, Math.round(clickX / stepX)));
				surfaceVelocities[c] -= 12.0;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				ripples.push({
					x: mouseX,
					y: mouseY,
					radius: 10,
					strength: 1.25,
					decay: 0.018
				});
				const c = Math.max(0, Math.min(cols - 1, Math.round(mouseX / stepX)));
				surfaceVelocities[c] -= 12.0;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
