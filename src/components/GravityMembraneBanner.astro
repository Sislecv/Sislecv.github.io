---
// GravityMembraneBanner.astro: Authentic Yusuke Endoh (IOCCC 2012) SPH Fluid Simulation Banner
// Features:
// - Authentic SPH (Smoothed Particle Hydrodynamics) 2D fluid physics engine based on Yusuke Endoh's classic IOCCC 2012 fluid simulation
// - Zero artificial "spray/firework" particle fountains: completely coherent, physical fluid body that flows, surges, curls and sloshes
// - Baseline fluid resting depth strictly occupies 1/5 (20%) of the container height
// - Fluid allows full-screen traversal when vigorously agitated or climbing walls
// - Fixed-position square MDUI cards: strictly non-rotating, refined small square cells
// - Cells toggle on/off purely through fluid particle occupancy (like terminal ASCII characters)
// - Colors appear strictly ONLY where water physically exists; air has zero color reaction
// - Translucent, refined Material Theme gradient palette
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating SPH fluid voxel card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Fullscreen hero dimensions */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px;
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, #f3f5f9 0%, #eaedf5 50%, #e1e5f0 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: linear-gradient(180deg, #23242c 0%, #1c1d25 50%, #16171e 100%);
		border-bottom-color: rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.22);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let mouseSpeed = 0;
		let isHovered = false;
		let mouseImpulse = false;

		// Theme colors extracted from MDUI CSS variables
		let themePrimary = [11, 87, 208];
		let isDarkTheme = false;

		function parseColor(str, fallback) {
			if (!str) return fallback;
			str = str.trim();
			if (str.startsWith("#")) {
				let hex = str.slice(1);
				if (hex.length === 3) hex = hex.split("").map((c) => c + c).join("");
				if (hex.length >= 6) {
					return [
						parseInt(hex.slice(0, 2), 16),
						parseInt(hex.slice(2, 4), 16),
						parseInt(hex.slice(4, 6), 16),
					];
				}
			}
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const html = document.documentElement;
			isDarkTheme = html.classList.contains("mdui-theme-dark");
			const cs = getComputedStyle(html);
			themePrimary = parseColor(cs.getPropertyValue("--mdui-color-primary"), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		let cols = 0;
		let rows = 0;
		let step = 24; // Small refined square cell size
		let cardSize = 20;
		let cardRadius = 4;
		let gridStartX = 0;
		let gridStartY = 0;

		// SPH Particle Engine Arrays
		// Modeled after Yusuke Endoh's IOCCC SPH formulation
		let px, py, vx, vy, rho;
		let totalParticles = 0;

		// SPH physical parameters in grid coordinate space
		const H = 2.4; // Interaction smoothing radius (grid units)
		const H2 = H * H;
		const P = 0.85; // Incompressible pressure coefficient
		const V = 0.35; // Fluid viscosity coefficient
		const G = 0.22; // Gravity downwards

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Small square cell dimensioning - exact width subdivision
			const targetStep = width < 640 ? 19 : (width < 1100 ? 22 : 24);
			cols = Math.round(width / targetStep);
			step = width / cols; // Exact width division: cols * step === width
			cardSize = Math.round(step * 0.90);
			cardRadius = Math.max(2, Math.round(cardSize * 0.16));

			rows = Math.ceil(height / step);

			// Start exactly at left edge (0) and align bottom row to container bed
			gridStartX = 0;
			gridStartY = height - rows * step;

			const _px = [];
			const _py = [];
			const _vx = [];
			const _vy = [];
			const _rho = [];

			// Coherent Fluid particles strictly filling bottom 1/5 (20%) at rest, spanning 100% width
			// Calibrated spacing (1.18) ensures resting fluid equilibrium precisely occupies bottom 1/5
			const fluidStartY = rows * 0.80;
			const pSpacing = 1.18;

			for (let y = fluidStartY + 0.3; y <= rows - 0.7; y += pSpacing) {
				for (let x = 0.5; x <= cols - 0.5; x += pSpacing) {
					_px.push(x + (Math.random() - 0.5) * 0.05);
					_py.push(y + (Math.random() - 0.5) * 0.05);
					_vx.push(0);
					_vy.push(0);
					_rho.push(0);
				}
			}

			totalParticles = _px.length;

			px = new Float32Array(_px);
			py = new Float32Array(_py);
			vx = new Float32Array(_vx);
			vy = new Float32Array(_vy);
			rho = new Float32Array(_rho);

			// Initialize grid matrix across entire width
			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				for (let c = 0; c < cols; c++) {
					// Solid at resting bottom 1/5
					if (r >= fluidStartY - 0.5) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Gentle, soft monochromatic theme palette with minimal gradient
		function getThemeGradientColor(energyRatio, depthRatio) {
			const heightFactor = 1.0 - depthRatio;
			const t = Math.max(0, Math.min(1.0, heightFactor * 0.75 + energyRatio * 0.35));
			const [pr, pg, pb] = themePrimary;

			if (isDarkTheme) {
				// Dark mode: soft, pale luminous tint of primary (low saturation, gentle)
				const r = Math.round(pr * 0.45 + 110 * 0.55 + t * 20);
				const g = Math.round(pg * 0.45 + 130 * 0.55 + t * 20);
				const b = Math.round(pb * 0.60 + 160 * 0.40 + t * 15);
				return [r, g, b];
			} else {
				// Light mode: airy, soft pastel tone of primary (light & pale)
				const r = Math.round(pr * 0.28 + 255 * 0.72 - t * 15);
				const g = Math.round(pg * 0.28 + 255 * 0.72 - t * 15);
				const b = Math.round(pb * 0.38 + 255 * 0.62);
				return [r, g, b];
			}
		}

		function drawCardTile(x, y, w, h, cr, r, g, b, alpha) {
			const safeCr = Math.min(cr, Math.floor(Math.min(w, h) * 0.5));
			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(x, y, w, h, safeCr);
			} else {
				ctx.moveTo(x + safeCr, y);
				ctx.lineTo(x + w - safeCr, y);
				ctx.quadraticCurveTo(x + w, y, x + w, y + safeCr);
				ctx.lineTo(x + w, y + h - safeCr);
				ctx.quadraticCurveTo(x + w, y + h, x + w - safeCr, y + h);
				ctx.lineTo(x + safeCr, y + h);
				ctx.quadraticCurveTo(x, y + h, x, y + h - safeCr);
				ctx.lineTo(x, y + safeCr);
				ctx.quadraticCurveTo(x, y, x + safeCr, y);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();
			// STRICTLY NO WHITE BORDER (no ctx.stroke)
		}

		let time = 0;

		function updateSPHPhysics() {
			time += 0.016;

			// Mouse velocity & coordinates in grid units
			let mouseGridX = -9999;
			let mouseGridY = -9999;
			let mSpeed = 0;
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mSpeed = Math.min(10, dist / step);
				mouseVx = (mouseX - prevMouseX) / step;
				mouseVy = (mouseY - prevMouseY) / step;
				mouseGridX = (mouseX - gridStartX) / step;
				mouseGridY = (mouseY - gridStartY) / step;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Natural ocean swell rhythmic sway
			const sway1 = Math.sin(time * 0.95) * 0.22;
			const sway2 = Math.sin(time * 1.9 + 0.4) * 0.08;
			const gx = sway1 + sway2;

			// Pass 1: Compute density field for all fluid particles
			for (let i = 0; i < totalParticles; i++) {
				let r = 0.0;
				const xi = px[i];
				const yi = py[i];

				for (let j = 0; j < totalParticles; j++) {
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2) {
						const w = 1.0 - Math.sqrt(d2) / H;
						r += w * w;
					}
				}
				rho[i] = Math.max(r, 0.4);
			}

			// Pass 2: SPH Navier-Stokes Pressure & Viscosity Force Integration
			for (let i = 0; i < totalParticles; i++) {
				let fx = gx;
				let fy = G;
				const xi = px[i];
				const yi = py[i];
				const vxi = vx[i];
				const vyi = vy[i];
				const rho_i = rho[i];

				for (let j = 0; j < totalParticles; j++) {
					if (i === j) continue;
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2 && d2 > 0.0001) {
						const dist = Math.sqrt(d2);
						const w = 1.0 - dist / H;

						// Yusuke Endoh pressure state equation
						const p_term = w * (dist * (3.0 - rho_i - rho[j]) * P);
						// Fluid viscosity
						const v_term_x = (vx[j] - vxi) * V * w;
						const v_term_y = (vy[j] - vyi) * V * w;

						fx += (-(dx / dist) * p_term + v_term_x) / rho_i;
						fy += (-(dy / dist) * p_term + v_term_y) / rho_i;
					}
				}

				// Mouse displacement and interaction
				if (isHovered && mouseGridY > 0) {
					const mdx = xi - mouseGridX;
					const mdy = yi - mouseGridY;
					const mdist2 = mdx * mdx + mdy * mdy;
					const mRadius = 4.6;
					if (mdist2 < mRadius * mRadius && mdist2 > 0.01) {
						const mdist = Math.sqrt(mdist2);
						const mfactor = 1.0 - mdist / mRadius;
						fx += (mdx / mdist) * 1.5 * mfactor;
						fy += (mdy / mdist) * 1.5 * mfactor;
						fx += mouseVx * 0.65 * mfactor;
						fy += mouseVy * 0.65 * mfactor;

						if (mouseImpulse) {
							fx += (mdx / mdist) * 3.5 * mfactor;
							fy += -4.0 * mfactor;
						}
					}
				}

				// Velocity integration
				vx[i] = (vx[i] + fx * 0.12) * 0.985;
				vy[i] = (vy[i] + fy * 0.12) * 0.985;

				px[i] += vx[i];
				py[i] += vy[i];

				// Direct Container Wall Collision Physics (tight flush to boundaries + wave surge)
				// Left wall (x <= 0)
				if (px[i] <= 0.0) {
					px[i] = 0.0;
					if (vx[i] < -0.05) {
						// Convert horizontal impact momentum into upward surging splash
						vy[i] -= Math.abs(vx[i]) * 1.35;
						vx[i] = Math.abs(vx[i]) * 0.35; // Curls inward as it climbs
					} else {
						vx[i] = 0;
					}
				}

				// Right wall (x >= cols - 1)
				if (px[i] >= cols - 1) {
					px[i] = cols - 1;
					if (vx[i] > 0.05) {
						// Convert horizontal impact momentum into upward surging splash
						vy[i] -= Math.abs(vx[i]) * 1.35;
						vx[i] = -Math.abs(vx[i]) * 0.35; // Curls inward as it climbs
					} else {
						vx[i] = 0;
					}
				}

				// Bottom floor (y >= rows - 1)
				if (py[i] >= rows - 1) {
					py[i] = rows - 1;
					if (vy[i] > 0) vy[i] = -vy[i] * 0.10;
				}

				// Ceiling (y <= 0.2)
				if (py[i] < 0.2) {
					py[i] = 0.2;
					if (vy[i] < 0) vy[i] = 0;
				}
			}

			mouseImpulse = false;
		}

		function render() {
			updateSPHPhysics();

			ctx.clearRect(0, 0, width, height);

			// 1. Grid Occupancy & Velocity Rasterization (SPH Particles -> Fixed Voxel Matrix)
			const occupancy = new Float32Array(cols * rows);
			const cellVel = new Float32Array(cols * rows);

			for (let i = 0; i < totalParticles; i++) {
				const gx = px[i];
				const gy = py[i];
				const baseC = Math.round(gx);
				const baseR = Math.round(gy);
				const speed = Math.hypot(vx[i], vy[i]);

				// Splat particle onto surrounding square matrix cells
				for (let dr = -1; dr <= 1; dr++) {
					const r = baseR + dr;
					if (r < 0 || r >= rows) continue;
					for (let dc = -1; dc <= 1; dc++) {
						const c = baseC + dc;
						if (c < 0 || c >= cols) continue;
						const d = Math.hypot(gx - c, gy - r);
						if (d < 1.45) {
							const w = (1.45 - d) / 1.45;
							const idx = r * cols + c;
							occupancy[idx] += w * 1.10;
							cellVel[idx] = Math.max(cellVel[idx], speed);
						}
					}
				}
			}

			// 2. Render Fixed Square MDUI Cards
			// STRICT: Cells render and change color ONLY where water physically exists!
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * step + step * 0.5;
				const depthRatio = Math.max(0, Math.min(1.0, r / rows));

				for (let c = 0; c < cols; c++) {
					const cx = gridStartX + c * step + step * 0.5;
					const idx = r * cols + c;
					const occ = occupancy[idx];
					const hasWater = occ > 0.32;

					if (!hasWater) {
						// STRICT: Empty air. No color, no hover glow, fade to zero.
						cellAlpha[r][c] += (0.0 - cellAlpha[r][c]) * 0.35;
						cellEnergy[r][c] = 0.0;
					} else {
						// Natural fluid kinetic energy based on SPH velocity
						const vSpeed = cellVel[idx];
						const fluidKinetic = Math.min(1.0, vSpeed * 0.70 + (occ > 1.2 ? 0.25 : 0.10));

						cellAlpha[r][c] += (1.0 - cellAlpha[r][c]) * 0.40;
						cellEnergy[r][c] += (fluidKinetic - cellEnergy[r][c]) * 0.20;
					}

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						// Render soft, light Material square tile
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const baseA = isDarkTheme ? 0.36 : 0.42;
						const maxA = isDarkTheme ? 0.62 : 0.70;
						const cardAlpha = Math.max(baseA, Math.min(maxA, currentA * (baseA + cellEnergy[r][c] * 0.22)));

						const half = cardSize * 0.5;
						let cardX = cx - half;
						let cardY = cy - half;
						let cardW = cardSize;
						let cardH = cardSize;

						// Seamless flush with banner edges (strictly 0 gap on left, right, bottom)
						if (c === 0) {
							cardW += cardX;
							cardX = 0;
						}
						if (c === cols - 1) {
							cardW = width - cardX;
						}
						if (r === rows - 1) {
							cardH = height - cardY;
						}

						drawCardTile(cardX, cardY, cardW, cardH, cardRadius, cr, cg, cb, cardAlpha);
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				mouseImpulse = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				mouseImpulse = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>