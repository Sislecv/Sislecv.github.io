---
// GravityMembraneBanner.astro: Material Card-based SPH Fluid Dynamics Simulation
// Inspried by Yusuke Endoh's classic SPH fluid physics.
// The banner acts as a spacious, partially-filled container with fluid sloshing at the bottom,
// leaving the upper area open for custom content (via slot).
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating fluid particles at bottom of container -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: open for custom user content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Subtle technical telemetry at bottom corner -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">SPH·FLUID // PARTICLES: 520 // PRESSURE: EQUILIBRIUM</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 35%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 35%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 60%; /* Upper 60% open for user content */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 32px;
		box-sizing: border-box;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 5;
	}

	.gravity-hero-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: #38bdf8;
		text-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: #38bdf8;
		opacity: 0.6;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		color: #67e8f9;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let isPressed = false;
		let splashTrigger = false;

		// SPH Fluid Physics Constants
		const H = 32.0;           // Interaction smoothing radius
		const H2 = H * H;
		const REST_DENS = 0.0016; // Rest density
		const GAS_CONST = 240.0;  // Pressure constant
		const VISC = 0.45;        // Fluid viscosity
		const GRAV = 0.26;        // Downward gravity towards container bottom
		const DT = 0.65;          // Time step

		// Spatial hash grid for O(N) neighbor queries
		const CELL_SIZE = H;
		let gridCols = 0;
		let gridRows = 0;
		let grid = [];

		class SPHParticle {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				this.vx = (Math.random() - 0.5) * 1.5;
				this.vy = Math.random() * 0.5;
				this.fx = 0;
				this.fy = 0;
				this.rho = REST_DENS;
				this.pressure = 0;
				this.speed = 0;
				this.angle = 0;
			}
		}

		let particles = [];
		const PARTICLE_COUNT = 480;

		function initParticles() {
			particles = [];
			// Fluid initially occupies the bottom 28% of the container, spanning full width
			const bottomDepth = height * 0.28;
			const startY = height - bottomDepth;
			const paddingX = 24;
			const usableWidth = width - paddingX * 2;

			// Arrange particles in staggered grid at container bottom
			const cols = Math.ceil(Math.sqrt(PARTICLE_COUNT * (usableWidth / bottomDepth)));
			const rows = Math.ceil(PARTICLE_COUNT / cols);
			const stepX = usableWidth / cols;
			const stepY = (bottomDepth - 20) / rows;

			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					if (particles.length >= PARTICLE_COUNT) break;
					const px = paddingX + c * stepX + (r % 2) * (stepX * 0.5) + (Math.random() - 0.5) * 4;
					const py = startY + r * stepY + (Math.random() - 0.5) * 4;
					particles.push(new SPHParticle(px, py));
				}
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			gridCols = Math.ceil(width / CELL_SIZE) + 2;
			gridRows = Math.ceil(height / CELL_SIZE) + 2;

			initParticles();
		}

		// Material Design Palette for Fluid Depth & Kinetic Energy:
		// Deep Bed: Deep Sapphire / Navy [20, 60, 140]
		// Mid Water: Bright Cyan / Turquoise [6, 182, 212]
		// Surface & Wavelets: Vibrant Mint [16, 185, 129]
		// Airborne Splashes / Agitation: Coral Rose [244, 63, 94] to Golden Amber [251, 191, 36]
		function getFluidParticleColor(yPos, speedRatio) {
			const depthRatio = Math.max(0, Math.min(1, (height - yPos) / (height * 0.45))); // 0=bottom, 1=high surface/air

			let r, g, b;
			if (speedRatio > 0.45 || depthRatio > 0.75) {
				// Airborne splash or high energy agitation
				const t = Math.min(1, (speedRatio - 0.3) * 1.5);
				r = Math.round(244 + (251 - 244) * t);
				g = Math.round(63 + (191 - 63) * t);
				b = Math.round(94 + (36 - 94) * t);
			} else if (depthRatio > 0.35) {
				// Mid water toward surface: Mint to Cyan
				const t = (depthRatio - 0.35) / 0.4;
				r = Math.round(6 + (16 - 6) * t);
				g = Math.round(182 + (185 - 182) * t);
				b = Math.round(212 + (129 - 212) * t);
			} else {
				// Deep bottom bed: Deep Navy into Ocean Cyan
				const t = depthRatio / 0.35;
				r = Math.round(20 + (6 - 20) * t);
				g = Math.round(60 + (182 - 60) * t);
				b = Math.round(140 + (212 - 140) * t);
			}

			return [r, g, b];
		}

		// Draw single MDUI mini-card tile
		function drawMiniCard(cx, cy, w, h, radius, rotAngle, r, g, b, alpha) {
			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(rotAngle);

			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = Math.min(radius, halfW, halfH);

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(-halfW, -halfH, w, h, cr);
			} else {
				ctx.moveTo(-halfW + cr, -halfH);
				ctx.lineTo(halfW - cr, -halfH);
				ctx.quadraticCurveTo(halfW, -halfH, halfW, -halfH + cr);
				ctx.lineTo(halfW, halfH - cr);
				ctx.quadraticCurveTo(halfW, halfH, halfW - cr, halfH);
				ctx.lineTo(-halfW + cr, halfH);
				ctx.quadraticCurveTo(-halfW, halfH, -halfW, halfH - cr);
				ctx.lineTo(-halfW, -halfH + cr);
				ctx.quadraticCurveTo(-halfW, -halfH, -halfW + cr, -halfH);
				ctx.closePath();
			}

			// Solid Card Fill
			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// 1px Material subtle outline
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${Math.min(0.3, alpha * 0.35)})`;
			ctx.stroke();

			ctx.restore();
		}

		function updatePhysics() {
			// Track mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.6;
				mouseVy = (mouseY - prevMouseY) * 0.6;
			} else {
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Clear spatial grid
			const totalCells = gridCols * gridRows;
			grid = new Array(totalCells);
			for (let k = 0; k < totalCells; k++) grid[k] = [];

			// Insert particles into grid cells
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];
				const gx = Math.max(0, Math.min(gridCols - 1, Math.floor(p.x / CELL_SIZE)));
				const gy = Math.max(0, Math.min(gridRows - 1, Math.floor(p.y / CELL_SIZE)));
				const idx = gy * gridCols + gx;
				grid[idx].push(i);
			}

			// Precomputed kernel coefficients
			const POLY6 = 315.0 / (64.0 * Math.PI * Math.pow(H, 9));
			const SPIKY_GRAD = -45.0 / (Math.PI * Math.pow(H, 6));
			const VISC_LAP = 45.0 / (Math.PI * Math.pow(H, 6));

			// 1. Calculate Density and Pressure
			for (let i = 0; i < particles.length; i++) {
				const pi = particles[i];
				let rho = 0;

				const gx = Math.max(0, Math.min(gridCols - 1, Math.floor(pi.x / CELL_SIZE)));
				const gy = Math.max(0, Math.min(gridRows - 1, Math.floor(pi.y / CELL_SIZE)));

				// Neighbor 3x3 search
				for (let dy = -1; dy <= 1; dy++) {
					const ny = gy + dy;
					if (ny < 0 || ny >= gridRows) continue;
					for (let dx = -1; dx <= 1; dx++) {
						const nx = gx + dx;
						if (nx < 0 || nx >= gridCols) continue;
						const cell = grid[ny * gridCols + nx];
						for (let k = 0; k < cell.length; k++) {
							const pj = particles[cell[k]];
							const rx = pi.x - pj.x;
							const ry = pi.y - pj.y;
							const r2 = rx * rx + ry * ry;
							if (r2 < H2) {
								rho += Math.pow(H2 - r2, 3);
							}
						}
					}
				}

				pi.rho = Math.max(rho * POLY6, REST_DENS);
				pi.pressure = GAS_CONST * (pi.rho - REST_DENS);
			}

			// 2. Calculate Forces (Pressure Gradient + Viscosity + Gravity)
			for (let i = 0; i < particles.length; i++) {
				const pi = particles[i];
				let f_px = 0;
				let f_py = 0;
				let f_vx = 0;
				let f_vy = 0;

				const gx = Math.max(0, Math.min(gridCols - 1, Math.floor(pi.x / CELL_SIZE)));
				const gy = Math.max(0, Math.min(gridRows - 1, Math.floor(pi.y / CELL_SIZE)));

				for (let dy = -1; dy <= 1; dy++) {
					const ny = gy + dy;
					if (ny < 0 || ny >= gridRows) continue;
					for (let dx = -1; dx <= 1; dx++) {
						const nx = gx + dx;
						if (nx < 0 || nx >= gridCols) continue;
						const cell = grid[ny * gridCols + nx];
						for (let k = 0; k < cell.length; k++) {
							const j = cell[k];
							if (i === j) continue;
							const pj = particles[j];
							const rx = pi.x - pj.x;
							const ry = pi.y - pj.y;
							const r = Math.hypot(rx, ry);

							if (r < H && r > 0.001) {
								const p_term = (pi.pressure + pj.pressure) / (2.0 * pj.rho);
								const gradW = SPIKY_GRAD * Math.pow(H - r, 2);
								f_px -= (rx / r) * p_term * gradW;
								f_py -= (ry / r) * p_term * gradW;

								const lapW = VISC_LAP * (H - r);
								f_vx += VISC * (pj.vx - pi.vx) / pj.rho * lapW;
								f_vy += VISC * (pj.vy - pi.vy) / pj.rho * lapW;
							}
						}
					}
				}

				// Mouse stirring / splash force
				let mouseFx = 0;
				let mouseFy = 0;
				if (isHovered) {
					const mx = pi.x - mouseX;
					const my = pi.y - mouseY;
					const mDist = Math.hypot(mx, my);
					const mouseRadius = 90;

					if (mDist < mouseRadius && mDist > 0.1) {
						const mFactor = 1.0 - mDist / mouseRadius;
						// Repulsion push
						mouseFx += (mx / mDist) * mFactor * 16.0;
						mouseFy += (my / mDist) * mFactor * 16.0;
						// Impart mouse velocity to fluid
						mouseFx += mouseVx * mFactor * 1.5;
						mouseFy += mouseVy * mFactor * 1.5;

						if (splashTrigger) {
							// Explosive upward splash on click
							mouseFy -= mFactor * 32.0;
							mouseFx += (Math.random() - 0.5) * 20.0;
						}
					}
				}

				// Total acceleration
				const ax = (f_px + f_vx + mouseFx);
				const ay = (f_py + f_vy + mouseFy) + GRAV;

				// Integration
				pi.vx = (pi.vx + ax * DT) * 0.992;
				pi.vy = (pi.vy + ay * DT) * 0.992;

				pi.x += pi.vx * DT;
				pi.y += pi.vy * DT;

				// Boundary Collisions (Sides and bottom of container)
				const wallDamping = -0.42;
				// Bottom bed
				if (pi.y > height - 12) {
					pi.y = height - 12;
					pi.vy *= wallDamping;
				}
				// Left container wall
				if (pi.x < 10) {
					pi.x = 10;
					pi.vx *= wallDamping;
				}
				// Right container wall
				if (pi.x > width - 10) {
					pi.x = width - 10;
					pi.vx *= wallDamping;
				}

				pi.speed = Math.hypot(pi.vx, pi.vy);
				pi.angle = Math.atan2(pi.vy, pi.vx);
			}

			splashTrigger = false;
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			let totalKinetic = 0;
			let maxSpeed = 0;

			// Render each particle as a mini MDUI Card tile
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];
				totalKinetic += p.speed;
				if (p.speed > maxSpeed) maxSpeed = p.speed;

				const speedRatio = Math.min(1.0, p.speed / 5.5);
				
				// Size dynamics:
				// Calm: ~10px mini card
				// High speed / agitation: ~16px-20px expanded card
				const cardW = 9.5 + speedRatio * 7.5;
				const cardH = 8.5 + speedRatio * 4.5;
				const cardRadius = Math.min(cardW, cardH) * 0.28;

				// Color dynamics: depth + speed
				const [cr, cg, cb] = getFluidParticleColor(p.y, speedRatio);
				const cardAlpha = Math.max(0.4, Math.min(0.96, 0.55 + speedRatio * 0.4));

				drawMiniCard(
					p.x,
					p.y,
					cardW,
					cardH,
					cardRadius,
					p.angle * 0.35, // subtle fluid orientation
					cr,
					cg,
					cb,
					cardAlpha
				);
			}

			// Telemetry status
			if (telemetry) {
				const avgK = (totalKinetic / particles.length).toFixed(2);
				const status = isHovered && maxSpeed > 4 ? "STIRRED / SPLASHING" : (maxSpeed > 2 ? "SLOSHING" : "SETTLED");
				telemetry.textContent = `SPH·FLUID // PARTICLES: ${particles.length} // KINETIC: ${avgK} // ${status}`;
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			isPressed = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				isPressed = true;
				splashTrigger = true;
			}
		});

		window.addEventListener("mouseup", () => {
			isPressed = false;
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				isPressed = true;
				splashTrigger = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isPressed = false;
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		resize();
		requestAnimationFrame(render);
	})();
</script>
