---
// GravityMembraneBanner.astro: Interactive Fullscreen ASCII Ocean Fluid Simulation
// True hydrodynamic wave synthesis (Gerstner waves + fluid particle drift + foam dynamics)
// Dynamic multi-tiered oceanic color gradient reflecting depth, crest, and turbulence.
---

<div class="ocean-fluid-hero" id="ocean-banner-container">
	<div class="ocean-hero-viewport" id="ocean-banner-root">
		<canvas id="ocean-banner-canvas" aria-hidden="true"></canvas>

		<!-- Minimalist ocean telemetry -->
		<div class="ocean-telemetry">
			<span class="telemetry-badge" id="ocean-telemetry-metric">SIM·OCEAN // SWELL: 1.85m // T: 4.2s // SEA STATE: 3</span>
		</div>

		<!-- Minimalist ASCII scroll indicator -->
		<button class="ocean-scroll-down" id="ocean-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-wave">~</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	.ocean-fluid-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 560px;
		max-height: 1120px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.ocean-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 60%, rgba(10, 25, 45, 0.85) 0%, rgba(4, 12, 24, 0.98) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .ocean-hero-viewport {
		background: radial-gradient(circle at 50% 65%, rgba(6, 18, 36, 0.9) 0%, rgba(2, 6, 14, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#ocean-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.ocean-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.7;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.12em;
		transition: opacity 0.2s ease;
		z-index: 2;
	}

	.ocean-hero-viewport:hover .ocean-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: #38bdf8;
		text-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
	}

	/* Minimalist ASCII scroll indicator */
	.ocean-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: #38bdf8;
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 2;
		outline: none;
	}

	.ocean-scroll-down:hover {
		opacity: 1;
		color: #67e8f9;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: ocean-bob 2.4s ease-in-out infinite;
	}

	.glyph-wave {
		font-size: 11px;
		margin: -1px 0;
		color: #22d3ee;
	}

	@keyframes ocean-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(7px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.ocean-fluid-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.ocean-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.ocean-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("ocean-banner-root");
		const canvas = document.getElementById("ocean-banner-canvas");
		const telemetry = document.getElementById("ocean-telemetry-metric");
		const scrollBtn = document.getElementById("ocean-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("ocean-banner-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		// Font and ASCII parameters
		const FONT_SIZE = 12.5;
		const FONT_FAMILY = 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace';

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Fluid Interaction
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseSpeed = 0;
		let isHovered = false;
		let isPressed = false;
		let pressEnergy = 0;

		// Splash waves / Shockwaves from clicks/touches
		const splashes = [];

		// Fluid wake particles (bubbles & water disturbance behind mouse)
		const wakeTrails = [];

		// Ocean Grid Resolution
		let GRID_COLS = 68;
		let GRID_ROWS = 36;

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			if (width < 600) {
				GRID_COLS = 44;
				GRID_ROWS = 26;
			} else if (width > 1400) {
				GRID_COLS = 80;
				GRID_ROWS = 40;
			} else {
				GRID_COLS = 68;
				GRID_ROWS = 34;
			}
		}

		// Multi-layered Gerstner Wave Synthesis & Fluid Dynamics
		// Gerstner Wave Component: [dirX, dirY, wavelength, amplitude, speed, steepness]
		const waveComponents = [
			// 1. Primary oceanic swell: deep, powerful, diagonal forward drift
			{ dx: 0.78, dy: 0.62, lambda: 180, amp: 26, speed: 1.25, Q: 0.65 },
			// 2. Secondary crossing wave: diamond interference patterns
			{ dx: -0.65, dy: 0.76, lambda: 125, amp: 16, speed: 1.6, Q: 0.55 },
			// 3. Counter chop / wind ripple: creates wave crest details
			{ dx: 0.95, dy: 0.31, lambda: 72, amp: 8.5, speed: 2.1, Q: 0.45 },
			// 4. Fine turbulent capillary ripples
			{ dx: -0.35, dy: 0.94, lambda: 36, amp: 4.2, speed: 2.8, Q: 0.35 }
		];

		// Ocean Depth & Light Color Palettes (RGB)
		// Deep Abyss -> Ocean Body -> Sunlit Aquamarine -> Crest Sky Blue -> Pure White Foam
		const COLOR_ABYSS = [10, 32, 60];        // Deep ocean trough (波谷深海)
		const COLOR_DEEP = [14, 88, 140];        // Deep blue (海水体)
		const COLOR_AQUA = [6, 182, 212];        // Sunlit turquoise (向阳碧青)
		const COLOR_EMERALD = [20, 210, 160];    // Vibrant emerald surge (海浪卷曲微光)
		const COLOR_CREST = [125, 211, 252];     // Bright wave crest (波峰浅天蓝)
		const COLOR_FOAM = [255, 255, 255];      // Whitecap foam (海浪翻涌碎浪白沫)

		function lerpRgb(c1, c2, t) {
			const clampedT = Math.max(0, Math.min(1, t));
			return [
				Math.round(c1[0] + (c2[0] - c1[0]) * clampedT),
				Math.round(c1[1] + (c2[1] - c1[1]) * clampedT),
				Math.round(c1[2] + (c2[2] - c1[2]) * clampedT)
			];
		}

		// ASCII Glyphs reflecting wave height & curvature
		// Trough: . · | Mid-body: ~ - ≈ = | Steep: ^ * + s | Crest & Foam: # % @ W
		const FOAM_GLYPHS = ["@", "%", "#", "W", "*"];
		const CREST_GLYPHS = ["^", "*", "+", "≈", "~"];
		const BODY_GLYPHS = ["~", "≈", "-", "=", ":"];
		const TROUGH_GLYPHS = ["·", ".", " "];

		let time = 0;

		function render() {
			time += 0.018;

			// Handle mouse speed & wake generation
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mouseSpeed = mouseSpeed * 0.82 + dist * 0.18;
				
				// Generate wake ripples
				if (mouseSpeed > 3.5) {
					wakeTrails.push({
						x: mouseX,
						y: mouseY,
						life: 1.0,
						decay: 0.02 + Math.random() * 0.015,
						radius: 12 + mouseSpeed * 0.8
					});
					if (wakeTrails.length > 35) wakeTrails.shift();
				}
			} else {
				mouseSpeed *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Update click splash shockwaves
			for (let i = splashes.length - 1; i >= 0; i--) {
				const sp = splashes[i];
				sp.radius += 6.5;
				sp.strength *= 0.945;
				if (sp.strength < 0.02 || sp.radius > Math.max(width, height) * 1.5) {
					splashes.splice(i, 1);
				}
			}

			// Update wake trails
			for (let i = wakeTrails.length - 1; i >= 0; i--) {
				const w = wakeTrails[i];
				w.life -= w.decay;
				w.radius += 1.2;
				if (w.life <= 0) {
					wakeTrails.splice(i, 1);
				}
			}

			// Smooth press energy
			if (isPressed) {
				pressEnergy += (1 - pressEnergy) * 0.15;
			} else {
				pressEnergy += (0 - pressEnergy) * 0.08;
			}

			ctx.clearRect(0, 0, width, height);

			ctx.font = `${FONT_SIZE}px ${FONT_FAMILY}`;
			ctx.textBaseline = "middle";
			ctx.textAlign = "center";

			// Ocean perspective geometry
			// Horizon starts at 22% from top, waves roll toward bottom foreground
			const horizonY = height * 0.18;
			const oceanDepth = height - horizonY;
			const centerX = width * 0.5;

			// Track maximum peak for telemetry
			let maxWaveH = 0;
			let totalEnergy = 0;

			// Iterate 3D Ocean Surface Grid (row: 0=distant horizon -> GRID_ROWS=near camera)
			for (let r = 0; r < GRID_ROWS; r++) {
				const rowT = r / (GRID_ROWS - 1); // 0 (horizon) -> 1 (foreground)
				
				// Non-linear depth distribution: more resolution in foreground swells
				const depthFactor = Math.pow(rowT, 1.35);
				const baseScreenY = horizonY + depthFactor * oceanDepth;

				// Width spans wider as it gets closer (perspective cone)
				const spanWidth = width * (0.85 + rowT * 0.45);
				const rowStartX = centerX - spanWidth * 0.5;

				// Far waves are smaller, near waves are immense and towering
				const perspectiveScale = 0.35 + depthFactor * 0.95;

				for (let c = 0; c < GRID_COLS; c++) {
					const colT = c / (GRID_COLS - 1);
					const baseScreenX = rowStartX + colT * spanWidth;

					// World space wave coordinates
					const wx = (colT - 0.5) * spanWidth;
					const wy = depthFactor * oceanDepth * 2.2;

					// Gerstner Wave Displacement Synthesis
					let totalZ = 0;
					let dispX = 0;
					let dispY = 0;
					let waveSlope = 0;

					for (let w = 0; w < waveComponents.length; w++) {
						const comp = waveComponents[w];
						const k = (2 * Math.PI) / comp.lambda;
						const phase = k * (comp.dx * wx + comp.dy * wy) - time * comp.speed;

						const sinP = Math.sin(phase);
						const cosP = Math.cos(phase);

						// Wave height (Z)
						const h = comp.amp * cosP;
						totalZ += h;

						// Horizontal displacement (water particle orbital motion)
						dispX -= comp.Q * comp.amp * comp.dx * sinP;
						dispY -= comp.Q * comp.amp * comp.dy * sinP;

						// Wave steepness/slope for crest foam detection
						waveSlope += k * comp.amp * sinP;
					}

					// Mouse disturbance interaction
					if (isHovered) {
						const dMouse = Math.hypot(baseScreenX - mouseX, baseScreenY - mouseY);
						const mouseRadius = 140 + mouseSpeed * 3;
						if (dMouse < mouseRadius) {
							const mouseProximity = 1 - dMouse / mouseRadius;
							const pushOut = Math.sin(mouseProximity * Math.PI) * (20 + mouseSpeed * 1.5 + pressEnergy * 45);
							totalZ += pushOut;
							waveSlope += mouseProximity * 1.4;
						}
					}

					// Wake disturbance from past movement
					for (let i = 0; i < wakeTrails.length; i++) {
						const w = wakeTrails[i];
						const d = Math.hypot(baseScreenX - w.x, baseScreenY - w.y);
						if (d < w.radius) {
							const ripple = Math.cos((d / w.radius) * Math.PI * 2) * 14 * w.life;
							totalZ += ripple;
							waveSlope += Math.abs(ripple) * 0.08;
						}
					}

					// Splash shockwave rings
					for (let i = 0; i < splashes.length; i++) {
						const sp = splashes[i];
						const d = Math.hypot(baseScreenX - sp.x, baseScreenY - sp.y);
						const diff = d - sp.radius;
						if (Math.abs(diff) < 60) {
							const ringWave = Math.sin((diff / 60) * Math.PI) * 28 * sp.strength;
							totalZ += ringWave;
							waveSlope += Math.abs(ringWave) * 0.12;
						}
					}

					// Shoaling: swells rise taller and sharper near the observer
					totalZ *= perspectiveScale;

					if (Math.abs(totalZ) > maxWaveH) maxWaveH = Math.abs(totalZ);
					totalEnergy += Math.abs(totalZ);

					// Screen projected coordinate
					const projX = baseScreenX + dispX * perspectiveScale;
					const projY = baseScreenY + dispY * perspectiveScale * 0.4 - totalZ;

					// Normalized elevation in range [-1, 1] mapped to [0, 1]
					const maxExpectedAmp = 42 * perspectiveScale;
					const normH = Math.max(0, Math.min(1, (totalZ + maxExpectedAmp * 0.7) / (maxExpectedAmp * 1.7)));

					// Foam intensity: combines steepness (slope) + peak height
					const isPeak = totalZ > maxExpectedAmp * 0.55;
					const foamFactor = Math.max(0, Math.min(1, (waveSlope * 0.45) + (isPeak ? 0.45 : 0)));

					// Atmospheric horizon depth fading
					const horizonFade = 0.25 + depthFactor * 0.75;

					// Multi-tiered Color Blending based on depth and foam
					let rgb;
					let alpha = Math.min(1.0, (0.35 + normH * 0.65) * horizonFade);
					let glyph = "·";

					if (foamFactor > 0.65 || normH > 0.88) {
						// Wave Crest Foam (白浪沫)
						rgb = lerpRgb(COLOR_CREST, COLOR_FOAM, (foamFactor - 0.65) / 0.35);
						const gIdx = Math.floor(Math.random() * FOAM_GLYPHS.length);
						glyph = FOAM_GLYPHS[gIdx];
						alpha = Math.min(1.0, 0.85 + foamFactor * 0.15);
					} else if (normH > 0.68) {
						// Wave Peak / Upward Surge (浪尖天蓝向青碧)
						const t = (normH - 0.68) / 0.2;
						rgb = lerpRgb(COLOR_EMERALD, COLOR_CREST, t);
						glyph = CREST_GLYPHS[c % CREST_GLYPHS.length];
						alpha = 0.75 + t * 0.2;
					} else if (normH > 0.42) {
						// Sunlit Ocean Body (明澈青碧)
						const t = (normH - 0.42) / 0.26;
						rgb = lerpRgb(COLOR_AQUA, COLOR_EMERALD, t);
						glyph = BODY_GLYPHS[(c + r) % BODY_GLYPHS.length];
						alpha = 0.55 + t * 0.25;
					} else if (normH > 0.2) {
						// Deep Body Water (海水层)
						const t = (normH - 0.2) / 0.22;
						rgb = lerpRgb(COLOR_DEEP, COLOR_AQUA, t);
						glyph = BODY_GLYPHS[r % BODY_GLYPHS.length];
						alpha = 0.38 + t * 0.2;
					} else {
						// Trough Abyss (深邃海谷)
						const t = normH / 0.2;
						rgb = lerpRgb(COLOR_ABYSS, COLOR_DEEP, t);
						glyph = TROUGH_GLYPHS[(c + r) % TROUGH_GLYPHS.length];
						alpha = 0.18 + t * 0.2;
					}

					// Render ASCII Character
					ctx.fillStyle = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${alpha})`;
					ctx.fillText(glyph, projX, projY);
				}
			}

			// Ocean Telemetry Info Update
			if (telemetry) {
				const swellH = (1.2 + (maxWaveH * 0.035) + pressEnergy * 1.5).toFixed(2);
				const seaState = maxWaveH > 35 ? "4 (MODERATE)" : (maxWaveH > 20 ? "3 (SLIGHT)" : "2 (SMOOTH)");
				const turb = (mouseSpeed > 5 ? "CHOPPY // WAKE ACTIVE" : (isPressed ? "SURGE" : "SWELL"));
				telemetry.textContent = `SIM·OCEAN // SWELL: ${swellH}m // T: 4.2s // SEA STATE: ${seaState} // ${turb}`;
			}

			requestAnimationFrame(render);
		}

		// Interactive Event Listeners
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			isPressed = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				isPressed = true;
				splashes.push({
					x: mouseX,
					y: mouseY,
					radius: 8,
					strength: 1.0
				});
			}
		});

		window.addEventListener("mouseup", () => {
			isPressed = false;
		});

		// Mobile Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				isPressed = true;
				splashes.push({
					x: mouseX,
					y: mouseY,
					radius: 10,
					strength: 1.0
				});
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isPressed = false;
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		resize();
		requestAnimationFrame(render);
	})();
</script>
