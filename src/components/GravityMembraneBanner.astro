---
// GravityMembraneBanner.astro: Authentic Yusuke Endoh (IOCCC 2012) SPH Fluid Simulation Banner
// Features:
// - Authentic SPH (Smoothed Particle Hydrodynamics) 2D fluid physics engine based on Yusuke Endoh's classic IOCCC 2012 fluid simulation
// - Zero artificial "spray/firework" particle fountains: completely coherent, physical fluid body that flows, surges, curls and sloshes
// - Baseline fluid resting depth strictly occupies 1/5 (20%) of the container height
// - Fluid allows full-screen traversal when vigorously agitated or climbing walls
// - Fixed-position square MDUI cards: strictly non-rotating, refined small square cells
// - Cells toggle on/off purely through fluid particle occupancy (like terminal ASCII characters)
// - Colors appear strictly ONLY where water physically exists; air has zero color reaction
// - Translucent, refined Material Theme gradient palette
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating SPH fluid voxel card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Fullscreen hero dimensions */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px;
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let mouseSpeed = 0;
		let isHovered = false;
		let mouseImpulse = false;

		// Theme colors
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Matrix Configuration
		let cols = 0;
		let rows = 0;
		let step = 24; // Small refined square cell size
		let cardSize = 20;
		let cardRadius = 4;
		let gridStartX = 0;
		let gridStartY = 0;

		// SPH Particle Engine Arrays
		// Modeled after Yusuke Endoh's IOCCC SPH formulation
		let px, py, vx, vy, isWall, rho;
		let totalParticles = 0;
		let fluidCount = 0;

		// SPH physical parameters in grid coordinate space
		const H = 2.4; // Interaction smoothing radius (grid units)
		const H2 = H * H;
		const P = 0.85; // Incompressible pressure coefficient
		const V = 0.38; // Fluid viscosity coefficient
		const G = 0.22; // Gravity downwards

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Small square cell dimensioning
			step = width < 640 ? 20 : (width < 1100 ? 22 : 25);
			cardSize = Math.round(step * 0.82);
			cardRadius = Math.max(2, Math.round(cardSize * 0.20));

			cols = Math.ceil(width / step);
			rows = Math.ceil(height / step);

			gridStartX = (width - cols * step) * 0.5;
			gridStartY = (height - rows * step) * 0.5;

			const _px = [];
			const _py = [];
			const _vx = [];
			const _vy = [];
			const _isWall = [];
			const _rho = [];

			// 1. Static boundary wall particles (prevent penetration, provide natural SPH repulsive cushion)
			// Left boundary
			for (let y = 0; y <= rows + 1; y += 0.9) {
				_px.push(1.0); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(0.0); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}
			// Right boundary
			for (let y = 0; y <= rows + 1; y += 0.9) {
				_px.push(cols - 1.0); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(cols); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}
			// Bottom boundary
			for (let x = 0; x <= cols; x += 0.9) {
				_px.push(x); _py.push(rows - 0.5); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(x); _py.push(rows + 0.5); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}

			// 2. Coherent Fluid particles strictly filling bottom 1/5 (20%) at rest
			// Y starts from rows * 0.80 down to rows - 1.2
			const fluidStartY = rows * 0.80;
			const targetFluid = Math.min(420, Math.max(160, Math.floor(cols * (rows * 0.20) * 1.15)));
			let added = 0;

			const pSpacing = 0.82;
			for (let y = fluidStartY; y < rows - 1.2 && added < targetFluid; y += pSpacing) {
				for (let x = 2.5; x < cols - 2.5 && added < targetFluid; x += pSpacing) {
					_px.push(x + (Math.random() - 0.5) * 0.1);
					_py.push(y + (Math.random() - 0.5) * 0.1);
					_vx.push(0);
					_vy.push(0);
					_isWall.push(0);
					_rho.push(0);
					added++;
				}
			}

			fluidCount = added;
			totalParticles = _px.length;

			px = new Float32Array(_px);
			py = new Float32Array(_py);
			vx = new Float32Array(_vx);
			vy = new Float32Array(_vy);
			isWall = new Uint8Array(_isWall);
			rho = new Float32Array(_rho);

			// Initialize grid matrix
			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				const cy = r;
				for (let c = 0; c < cols; c++) {
					// Solid at bottom 1/5
					if (cy >= fluidStartY - 0.5) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Light, translucent Material tone
		function getThemeGradientColor(energyRatio, depthRatio) {
			const [pr, pg, pb] = primaryColor;

			// Lighter base tone at container bed
			const deepR = Math.round(pr * 0.55 + (255 - pr) * 0.35);
			const deepG = Math.round(pg * 0.55 + (255 - pg) * 0.35);
			const deepB = Math.round(pb * 0.55 + (255 - pb) * 0.45);

			// Mid body tone
			const midR = Math.round(pr * 0.75 + (255 - pr) * 0.50);
			const midG = Math.round(pg * 0.75 + (255 - pg) * 0.50);
			const midB = Math.round(pb * 0.75 + (255 - pb) * 0.60);

			// Bright crest/surge highlight
			const crestR = Math.round(pr * 0.25 + 255 * 0.75);
			const crestG = Math.round(pg * 0.25 + 255 * 0.75);
			const crestB = Math.round(pb * 0.15 + 255 * 0.85);

			const t = Math.max(0, Math.min(1.0, (1.0 - depthRatio) * 0.52 + energyRatio * 0.65));

			let r, g, b;
			if (t < 0.5) {
				const subT = t / 0.5;
				r = Math.round(deepR + (midR - deepR) * subT);
				g = Math.round(deepG + (midG - deepG) * subT);
				b = Math.round(deepB + (midB - deepB) * subT);
			} else {
				const subT = (t - 0.5) / 0.5;
				r = Math.round(midR + (crestR - midR) * subT);
				g = Math.round(midG + (crestG - midG) * subT);
				b = Math.round(midB + (crestB - midB) * subT);
			}

			return [r, g, b];
		}

		function drawCardTile(cx, cy, size, r, g, b, alpha, outlineAlpha) {
			const half = size * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - half, cy - half, size, size, cr);
			} else {
				ctx.moveTo(cx - half + cr, cy - half);
				ctx.lineTo(cx + half - cr, cy - half);
				ctx.quadraticCurveTo(cx + half, cy - half, cx + half, cy - half + cr);
				ctx.lineTo(cx + half, cy + half - cr);
				ctx.quadraticCurveTo(cx + half, cy + half, cx + half - cr, cy + half);
				ctx.lineTo(cx - half + cr, cy + half);
				ctx.quadraticCurveTo(cx - half, cy + half, cx - half, cy + half - cr);
				ctx.lineTo(cx - half, cy - half + cr);
				ctx.quadraticCurveTo(cx - half, cy - half, cx - half + cr, cy - half);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updateSPHPhysics() {
			time += 0.016;

			// Mouse velocity & coordinates in grid units
			let mouseGridX = -9999;
			let mouseGridY = -9999;
			let mSpeed = 0;
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mSpeed = Math.min(12, dist / step);
				mouseVx = (mouseX - prevMouseX) / step;
				mouseVy = (mouseY - prevMouseY) / step;
				mouseGridX = (mouseX - gridStartX) / step;
				mouseGridY = (mouseY - gridStartY) / step;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Large natural sloshing swing (gentle perpetual reservoir sway)
			// Smooth stochastic gravity tilt: sloshes whole fluid body without artificial fireworks
			const sway1 = Math.sin(time * 0.85) * Math.cos(time * 0.42);
			const sway2 = Math.sin(time * 1.55 + 0.6) * 0.35;
			const gx = (sway1 + sway2) * 0.22; // Substantial natural sloshing acceleration

			// Pass 1: Compute density field for all particles
			for (let i = 0; i < totalParticles; i++) {
				let r = isWall[i] ? 8.5 : 0.0;
				const xi = px[i];
				const yi = py[i];

				for (let j = 0; j < totalParticles; j++) {
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2) {
						const w = 1.0 - Math.sqrt(d2) / H;
						r += w * w;
					}
				}
				rho[i] = Math.max(r, 0.4);
			}

			// Pass 2: SPH Navier-Stokes Pressure & Viscosity Force Integration
			for (let i = 0; i < totalParticles; i++) {
				if (isWall[i]) continue;

				let fx = gx;
				let fy = G;
				const xi = px[i];
				const yi = py[i];
				const vxi = vx[i];
				const vyi = vy[i];
				const rho_i = rho[i];

				for (let j = 0; j < totalParticles; j++) {
					if (i === j) continue;
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2 && d2 > 0.0001) {
						const dist = Math.sqrt(d2);
						const w = 1.0 - dist / H;

						// Yusuke Endoh pressure state equation (repulsive when density exceeds 3.0)
						const p_term = w * (dist * (3.0 - rho_i - rho[j]) * P);
						// Fluid viscosity
						const v_term_x = (vx[j] - vxi) * V * w;
						const v_term_y = (vy[j] - vyi) * V * w;

						fx += (-(dx / dist) * p_term + v_term_x) / rho_i;
						fy += (-(dy / dist) * p_term + v_term_y) / rho_i;
					}
				}

				// Mouse displacement and interaction (pushes water aside and carries waves upwards)
				if (isHovered && mouseGridY > 0) {
					const mdx = xi - mouseGridX;
					const mdy = yi - mouseGridY;
					const mdist2 = mdx * mdx + mdy * mdy;
					const mRadius = 4.2; // Mouse influence radius in grid units
					if (mdist2 < mRadius * mRadius && mdist2 > 0.01) {
						const mdist = Math.sqrt(mdist2);
						const mfactor = 1.0 - mdist / mRadius;
						// Push away from cursor
						fx += (mdx / mdist) * 1.8 * mfactor;
						fy += (mdy / mdist) * 1.8 * mfactor;
						// Transfer mouse momentum into water
						fx += mouseVx * 0.65 * mfactor;
						fy += mouseVy * 0.65 * mfactor;

						if (mouseImpulse) {
							// Burst on click
							fx += (mdx / mdist) * 4.5 * mfactor;
							fy += (mdy / mdist) * 4.5 * mfactor;
						}
					}
				}

				// Velocity integration with fluid damping
				vx[i] = (vx[i] + fx * 0.12) * 0.985;
				vy[i] = (vy[i] + fy * 0.12) * 0.985;

				px[i] += vx[i];
				py[i] += vy[i];

				// Physical boundary safety constraints (walls)
				if (px[i] < 1.2) { px[i] = 1.2; vx[i] = -vx[i] * 0.25; }
				if (px[i] > cols - 1.2) { px[i] = cols - 1.2; vx[i] = -vx[i] * 0.25; }
				if (py[i] < 0.6) { py[i] = 0.6; vy[i] = 0; }
				if (py[i] > rows - 0.8) { py[i] = rows - 0.8; vy[i] = -vy[i] * 0.15; }
			}

			mouseImpulse = false;
		}

		function render() {
			updateSPHPhysics();

			ctx.clearRect(0, 0, width, height);

			// 1. Grid Occupancy & Velocity Rasterization (SPH Particles -> Fixed Voxel Matrix)
			const occupancy = new Float32Array(cols * rows);
			const cellVel = new Float32Array(cols * rows);

			for (let i = 0; i < totalParticles; i++) {
				if (isWall[i]) continue;
				const gx = px[i];
				const gy = py[i];
				const baseC = Math.round(gx);
				const baseR = Math.round(gy);
				const speed = Math.hypot(vx[i], vy[i]);

				// Splat particle onto surrounding square matrix cells
				for (let dr = -1; dr <= 1; dr++) {
					const r = baseR + dr;
					if (r < 0 || r >= rows) continue;
					for (let dc = -1; dc <= 1; dc++) {
						const c = baseC + dc;
						if (c < 0 || c >= cols) continue;
						const d = Math.hypot(gx - c, gy - r);
						if (d < 1.35) {
							const w = (1.35 - d) / 1.35;
							const idx = r * cols + c;
							occupancy[idx] += w * 0.95;
							cellVel[idx] = Math.max(cellVel[idx], speed);
						}
					}
				}
			}

			// 2. Render Fixed Square MDUI Cards
			// STRICT: Cells render and change color ONLY where water physically exists!
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * step + step * 0.5;
				// Depth ratio relative to fluid bed
				const depthRatio = Math.max(0, Math.min(1.0, r / rows));

				for (let c = 0; c < cols; c++) {
					const cx = gridStartX + c * step + step * 0.5;
					const idx = r * cols + c;
					const occ = occupancy[idx];
					const hasWater = occ > 0.42;

					if (!hasWater) {
						// STRICT: Empty air. No color, no hover glow, fade to zero.
						cellAlpha[r][c] += (0.0 - cellAlpha[r][c]) * 0.40;
						cellEnergy[r][c] = 0.0;
					} else {
						// Natural fluid kinetic energy based on SPH velocity
						const vSpeed = cellVel[idx];
						const fluidKinetic = Math.min(1.0, vSpeed * 0.65 + (occ > 1.2 ? 0.35 : 0.15));

						cellAlpha[r][c] += (1.0 - cellAlpha[r][c]) * 0.45;
						cellEnergy[r][c] += (fluidKinetic - cellEnergy[r][c]) * 0.25;
					}

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						// Render translucent Material square tile
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = Math.max(0.55, Math.min(0.92, currentA));
						const outlineA = Math.max(0.14, Math.min(0.42, 0.14 + cellEnergy[r][c] * 0.28));

						drawCardTile(cx, cy, cardSize, cr, cg, cb, cardAlpha, outlineA);
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				mouseImpulse = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				mouseImpulse = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>