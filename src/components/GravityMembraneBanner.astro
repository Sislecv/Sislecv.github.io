---
// GravityMembraneBanner.astro: Authentic Yusuke Endoh (IOCCC 2012) SPH Fluid Simulation Banner
// Features:
// - Authentic SPH (Smoothed Particle Hydrodynamics) 2D fluid physics engine based on Yusuke Endoh's classic IOCCC 2012 fluid simulation
// - Zero artificial "spray/firework" particle fountains: completely coherent, physical fluid body that flows, surges, curls and sloshes
// - Baseline fluid resting depth strictly occupies 1/5 (20%) of the container height
// - Fluid allows full-screen traversal when vigorously agitated or climbing walls
// - Fixed-position square MDUI cards: strictly non-rotating, refined small square cells
// - Cells toggle on/off purely through fluid particle occupancy (like terminal ASCII characters)
// - Colors appear strictly ONLY where water physically exists; air has zero color reaction
// - Translucent, refined Material Theme gradient palette
// - Upper area open for custom user content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating SPH fluid voxel card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Fullscreen hero dimensions */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px;
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 25%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 25%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 38%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 28px;
		box-sizing: border-box;
	}

	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let mouseSpeed = 0;
		let isHovered = false;
		let mouseImpulse = false;

		// Theme colors extracted from MDUI CSS variables
		let themePrimary = [11, 87, 208];
		let themePrimaryContainer = [218, 226, 249];
		let themeSecondary = [0, 140, 200];
		let themeTertiary = [120, 80, 210];
		let themeTertiaryContainer = [255, 216, 253];

		function parseColor(str, fallback) {
			if (!str) return fallback;
			str = str.trim();
			if (str.startsWith("#")) {
				let hex = str.slice(1);
				if (hex.length === 3) hex = hex.split("").map((c) => c + c).join("");
				if (hex.length >= 6) {
					return [
						parseInt(hex.slice(0, 2), 16),
						parseInt(hex.slice(2, 4), 16),
						parseInt(hex.slice(4, 6), 16),
					];
				}
			}
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			themePrimary = parseColor(cs.getPropertyValue("--mdui-color-primary"), [11, 87, 208]);
			themePrimaryContainer = parseColor(cs.getPropertyValue("--mdui-color-primary-container"), [218, 226, 249]);
			themeSecondary = parseColor(cs.getPropertyValue("--mdui-color-secondary"), [0, 140, 200]);
			themeTertiary = parseColor(cs.getPropertyValue("--mdui-color-tertiary"), [120, 80, 210]);
			themeTertiaryContainer = parseColor(cs.getPropertyValue("--mdui-color-tertiary-container"), [255, 216, 253]);
		}

		// Fixed Matrix Configuration
		let cols = 0;
		let rows = 0;
		let step = 24; // Small refined square cell size
		let cardSize = 20;
		let cardRadius = 4;
		let gridStartX = 0;
		let gridStartY = 0;

		// SPH Particle Engine Arrays
		// Modeled after Yusuke Endoh's IOCCC SPH formulation
		let px, py, vx, vy, isWall, rho;
		let totalParticles = 0;
		let fluidCount = 0;

		// SPH physical parameters in grid coordinate space
		const H = 2.4; // Interaction smoothing radius (grid units)
		const H2 = H * H;
		const P = 0.85; // Incompressible pressure coefficient
		const V = 0.38; // Fluid viscosity coefficient
		const G = 0.22; // Gravity downwards

		// Fixed grid cell activation and energy state matrices
		let cellAlpha = [];
		let cellEnergy = [];

		function initGridAndFluid() {
			// Small square cell dimensioning - exact width subdivision guarantees zero edge gap
			const targetStep = width < 640 ? 19 : (width < 1100 ? 22 : 24);
			cols = Math.round(width / targetStep);
			step = width / cols; // Exact width division: cols * step === width
			cardSize = Math.round(step * 0.84);
			cardRadius = Math.max(2, Math.round(cardSize * 0.18));

			rows = Math.ceil(height / step);

			// Start exactly at left edge (0) and align bottom row to container bed
			gridStartX = 0;
			gridStartY = height - rows * step;

			const _px = [];
			const _py = [];
			const _vx = [];
			const _vy = [];
			const _isWall = [];
			const _rho = [];

			// 1. Static boundary wall particles placed outside visible grid boundaries
			// Left boundary: two layers outside grid (x = -0.7 and x = -1.6)
			for (let y = -1; y <= rows + 2; y += 0.85) {
				_px.push(-0.7); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(-1.6); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}
			// Right boundary: two layers outside grid (x = cols - 0.3 and x = cols + 0.6)
			const rightWall1 = cols - 0.3;
			const rightWall2 = cols + 0.6;
			for (let y = -1; y <= rows + 2; y += 0.85) {
				_px.push(rightWall1); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(rightWall2); _py.push(y); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}
			// Bottom boundary: two layers below grid (y = rows - 0.3 and y = rows + 0.6)
			const botWall1 = rows - 0.3;
			const botWall2 = rows + 0.6;
			for (let x = -1.6; x <= cols + 1.0; x += 0.85) {
				_px.push(x); _py.push(botWall1); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
				_px.push(x); _py.push(botWall2); _vx.push(0); _vy.push(0); _isWall.push(1); _rho.push(0);
			}

			// 2. Coherent Fluid particles strictly filling bottom 1/5 (20%) at rest, spanning 100% width
			const fluidStartY = rows * 0.80;
			const targetFluid = Math.min(640, Math.max(160, Math.floor(cols * (rows * 0.20) * 1.25)));
			let added = 0;

			const pSpacing = 0.82;
			for (let y = fluidStartY; y < rows - 0.9 && added < targetFluid; y += pSpacing) {
				for (let x = 0.0; x <= cols - 1.0 && added < targetFluid; x += pSpacing) {
					_px.push(x + (Math.random() - 0.5) * 0.08);
					_py.push(y + (Math.random() - 0.5) * 0.08);
					_vx.push(0);
					_vy.push(0);
					_isWall.push(0);
					_rho.push(0);
					added++;
				}
			}

			fluidCount = added;
			totalParticles = _px.length;

			px = new Float32Array(_px);
			py = new Float32Array(_py);
			vx = new Float32Array(_vx);
			vy = new Float32Array(_vy);
			isWall = new Uint8Array(_isWall);
			rho = new Float32Array(_rho);

			// Initialize grid matrix across entire width
			cellAlpha = [];
			cellEnergy = [];
			for (let r = 0; r < rows; r++) {
				const aRow = new Float32Array(cols);
				const eRow = new Float32Array(cols);
				for (let c = 0; c < cols; c++) {
					// Solid at resting bottom 1/5
					if (r >= fluidStartY - 0.5) {
						aRow[c] = 1.0;
					} else {
						aRow[c] = 0.0;
					}
					eRow[c] = 0.0;
				}
				cellAlpha.push(aRow);
				cellEnergy.push(eRow);
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Full-spectrum Material Theme gradient palette
		function getThemeGradientColor(energyRatio, depthRatio) {
			// depthRatio: 1.0 at container floor, 0.0 at top
			const heightFactor = 1.0 - depthRatio; // 0.0 at floor, ~0.20 at baseline, 1.0 at very top
			// t in [0.0, 1.0]: composite depth + kinetic energy progression
			const t = Math.max(0, Math.min(1.0, heightFactor * 0.92 + energyRatio * 0.58));

			const p = themePrimary;
			const sec = themeSecondary;
			const tert = themeTertiary;
			const cont = themePrimaryContainer;

			let r, g, b;
			if (t < 0.25) {
				// Deep calm bed: rich dark primary tone
				const s = t / 0.25;
				r = p[0] * 0.58 + (p[0] - p[0] * 0.58) * s;
				g = p[1] * 0.58 + (p[1] - p[1] * 0.58) * s;
				b = p[2] * 0.70 + (p[2] - p[2] * 0.70) * s;
			} else if (t < 0.58) {
				// Mid layer: transitions from Primary into vibrant Secondary/Tertiary gradient
				const s = (t - 0.25) / 0.33;
				r = p[0] + (tert[0] - p[0]) * s;
				g = p[1] + (sec[1] - p[1]) * s;
				b = p[2] + (tert[2] - p[2]) * s;
			} else if (t < 0.85) {
				// Rising surge / active currents: Tertiary to vibrant Container gradient
				const s = (t - 0.58) / 0.27;
				r = tert[0] + (cont[0] - tert[0]) * s;
				g = sec[1] + (cont[1] - sec[1]) * s;
				b = tert[2] + (cont[2] - tert[2]) * s;
			} else {
				// Splashing wave crest / wall collision / extreme speed: luminous highlight
				const s = (t - 0.85) / 0.15;
				r = cont[0] + (248 - cont[0]) * s;
				g = cont[1] + (252 - cont[1]) * s;
				b = Math.min(255, cont[2] + (255 - cont[2]) * s);
			}

			return [Math.round(r), Math.round(g), Math.round(b)];
		}

		function drawCardTile(cx, cy, size, r, g, b, alpha, outlineAlpha) {
			const half = size * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - half, cy - half, size, size, cr);
			} else {
				ctx.moveTo(cx - half + cr, cy - half);
				ctx.lineTo(cx + half - cr, cy - half);
				ctx.quadraticCurveTo(cx + half, cy - half, cx + half, cy - half + cr);
				ctx.lineTo(cx + half, cy + half - cr);
				ctx.quadraticCurveTo(cx + half, cy + half, cx + half - cr, cy + half);
				ctx.lineTo(cx - half + cr, cy + half);
				ctx.quadraticCurveTo(cx - half, cy + half, cx - half, cy + half - cr);
				ctx.lineTo(cx - half, cy - half + cr);
				ctx.quadraticCurveTo(cx - half, cy - half, cx - half + cr, cy - half);
				ctx.closePath();
			}

			// Subtle vertical gradient on each card for elevated Material tactile feel
			const grad = ctx.createLinearGradient(cx, cy - half, cx, cy + half);
			const r1 = Math.min(255, Math.round(r * 1.12 + 10));
			const g1 = Math.min(255, Math.round(g * 1.12 + 10));
			const b1 = Math.min(255, Math.round(b * 1.08 + 12));
			const r2 = Math.round(r * 0.90);
			const g2 = Math.round(g * 0.90);
			const b2 = Math.round(b * 0.92);

			grad.addColorStop(0, `rgba(${r1}, ${g1}, ${b1}, ${alpha})`);
			grad.addColorStop(1, `rgba(${r2}, ${g2}, ${b2}, ${alpha})`);

			ctx.fillStyle = grad;
			ctx.fill();

			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updateSPHPhysics() {
			time += 0.016;

			// Mouse velocity & coordinates in grid units
			let mouseGridX = -9999;
			let mouseGridY = -9999;
			let mSpeed = 0;
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mSpeed = Math.min(12, dist / step);
				mouseVx = (mouseX - prevMouseX) / step;
				mouseVy = (mouseY - prevMouseY) / step;
				mouseGridX = (mouseX - gridStartX) / step;
				mouseGridY = (mouseY - gridStartY) / step;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Large natural sloshing swing (gentle perpetual reservoir sway)
			// Multi-frequency swell: creates authentic rhythmic ocean slosh from left to right
			const sway1 = Math.sin(time * 0.85) * Math.cos(time * 0.42);
			const sway2 = Math.sin(time * 1.55 + 0.6) * 0.35;
			const sway3 = Math.sin(time * 0.28) * 0.18;
			const gx = (sway1 + sway2 + sway3) * 0.26; // Natural sloshing acceleration

			// Pass 1: Compute density field for all particles
			for (let i = 0; i < totalParticles; i++) {
				let r = isWall[i] ? 8.5 : 0.0;
				const xi = px[i];
				const yi = py[i];

				for (let j = 0; j < totalParticles; j++) {
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2) {
						const w = 1.0 - Math.sqrt(d2) / H;
						r += w * w;
					}
				}
				rho[i] = Math.max(r, 0.4);
			}

			// Pass 2: SPH Navier-Stokes Pressure & Viscosity Force Integration
			for (let i = 0; i < totalParticles; i++) {
				if (isWall[i]) continue;

				let fx = gx;
				let fy = G;
				const xi = px[i];
				const yi = py[i];
				const vxi = vx[i];
				const vyi = vy[i];
				const rho_i = rho[i];

				for (let j = 0; j < totalParticles; j++) {
					if (i === j) continue;
					const dx = xi - px[j];
					const dy = yi - py[j];
					const d2 = dx * dx + dy * dy;
					if (d2 < H2 && d2 > 0.0001) {
						const dist = Math.sqrt(d2);
						const w = 1.0 - dist / H;

						// Yusuke Endoh pressure state equation (repulsive when density exceeds 3.0)
						const p_term = w * (dist * (3.0 - rho_i - rho[j]) * P);
						// Fluid viscosity
						const v_term_x = (vx[j] - vxi) * V * w;
						const v_term_y = (vy[j] - vyi) * V * w;

						fx += (-(dx / dist) * p_term + v_term_x) / rho_i;
						fy += (-(dy / dist) * p_term + v_term_y) / rho_i;
					}
				}

				// Mouse displacement and interaction (pushes water aside and carries waves upwards)
				if (isHovered && mouseGridY > 0) {
					const mdx = xi - mouseGridX;
					const mdy = yi - mouseGridY;
					const mdist2 = mdx * mdx + mdy * mdy;
					const mRadius = 4.2; // Mouse influence radius in grid units
					if (mdist2 < mRadius * mRadius && mdist2 > 0.01) {
						const mdist = Math.sqrt(mdist2);
						const mfactor = 1.0 - mdist / mRadius;
						// Push away from cursor
						fx += (mdx / mdist) * 1.8 * mfactor;
						fy += (mdy / mdist) * 1.8 * mfactor;
						// Transfer mouse momentum into water
						fx += mouseVx * 0.65 * mfactor;
						fy += mouseVy * 0.65 * mfactor;

						if (mouseImpulse) {
							// Burst on click
							fx += (mdx / mdist) * 4.5 * mfactor;
							fy += (mdy / mdist) * 4.5 * mfactor;
						}
					}
				}

				// Natural hydraulic wave lift along container walls when colliding
				if (px[i] < 1.0 && vx[i] < -0.15) {
					fy -= Math.abs(vx[i]) * 0.45; // convert horizontal collision momentum into upward surge
				} else if (px[i] > cols - 2.0 && vx[i] > 0.15) {
					fy -= Math.abs(vx[i]) * 0.45;
				}

				// Velocity integration with fluid damping
				vx[i] = (vx[i] + fx * 0.12) * 0.985;
				vy[i] = (vy[i] + fy * 0.12) * 0.985;

				px[i] += vx[i];
				py[i] += vy[i];

				// Physical boundary safety constraints (seamless full screen edge)
				if (px[i] < -0.1) { px[i] = -0.1; vx[i] = -vx[i] * 0.28; }
				if (px[i] > cols - 0.9) { px[i] = cols - 0.9; vx[i] = -vx[i] * 0.28; }
				if (py[i] < 0.2) { py[i] = 0.2; vy[i] = 0; }
				if (py[i] > rows - 0.9) { py[i] = rows - 0.9; vy[i] = -vy[i] * 0.15; }
			}

			mouseImpulse = false;
		}

		function render() {
			updateSPHPhysics();

			ctx.clearRect(0, 0, width, height);

			// 1. Grid Occupancy & Velocity Rasterization (SPH Particles -> Fixed Voxel Matrix)
			const occupancy = new Float32Array(cols * rows);
			const cellVel = new Float32Array(cols * rows);

			for (let i = 0; i < totalParticles; i++) {
				if (isWall[i]) continue;
				const gx = px[i];
				const gy = py[i];
				const baseC = Math.round(gx);
				const baseR = Math.round(gy);
				const speed = Math.hypot(vx[i], vy[i]);

				// Splat particle onto surrounding square matrix cells
				for (let dr = -1; dr <= 1; dr++) {
					const r = baseR + dr;
					if (r < 0 || r >= rows) continue;
					for (let dc = -1; dc <= 1; dc++) {
						const c = baseC + dc;
						if (c < 0 || c >= cols) continue;
						const d = Math.hypot(gx - c, gy - r);
						if (d < 1.35) {
							const w = (1.35 - d) / 1.35;
							const idx = r * cols + c;
							occupancy[idx] += w * 0.95;
							cellVel[idx] = Math.max(cellVel[idx], speed);
						}
					}
				}
			}

			// 2. Render Fixed Square MDUI Cards
			// STRICT: Cells render and change color ONLY where water physically exists!
			for (let r = 0; r < rows; r++) {
				const cy = gridStartY + r * step + step * 0.5;
				// Depth ratio relative to fluid bed
				const depthRatio = Math.max(0, Math.min(1.0, r / rows));

				for (let c = 0; c < cols; c++) {
					const cx = gridStartX + c * step + step * 0.5;
					const idx = r * cols + c;
					const occ = occupancy[idx];
					const hasWater = occ > 0.42;

					if (!hasWater) {
						// STRICT: Empty air. No color, no hover glow, fade to zero.
						cellAlpha[r][c] += (0.0 - cellAlpha[r][c]) * 0.40;
						cellEnergy[r][c] = 0.0;
					} else {
						// Natural fluid kinetic energy based on SPH velocity
						const vSpeed = cellVel[idx];
						const fluidKinetic = Math.min(1.0, vSpeed * 0.65 + (occ > 1.2 ? 0.35 : 0.15));

						cellAlpha[r][c] += (1.0 - cellAlpha[r][c]) * 0.45;
						cellEnergy[r][c] += (fluidKinetic - cellEnergy[r][c]) * 0.25;
					}

					const currentA = cellAlpha[r][c];

					if (currentA > 0.04) {
						// Render translucent Material square tile with theme gradient
						const [cr, cg, cb] = getThemeGradientColor(cellEnergy[r][c], depthRatio);
						const cardAlpha = Math.max(0.62, Math.min(0.96, currentA * (0.80 + cellEnergy[r][c] * 0.18)));
						const outlineA = Math.max(0.18, Math.min(0.55, 0.18 + cellEnergy[r][c] * 0.35));

						drawCardTile(cx, cy, cardSize, cr, cg, cb, cardAlpha, outlineA);
					}
				}
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				mouseImpulse = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				mouseImpulse = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>