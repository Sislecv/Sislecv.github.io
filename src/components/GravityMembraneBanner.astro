---
// GravityMembraneBanner.astro: Material Card-based Fluid Dynamics Banner
// Features:
// - Fixed-position MDUI card grid at container bottom (no rotating/scattering)
// - Dynamic sizing & fluid swelling (cards expand/contract with fluid momentum)
// - Strict Material Theme color & gradient transitions
// - Perpetual, continuous fluid flow even without interaction
// - Immediate initialization at bottom (no dropping down from top)
// - Upper spacious container slot for custom user elements
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas rendering the fluid MDUI-card grid at bottom -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Subtle technical telemetry at bottom corner -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">FLUID·GRID // MATERIAL DESIGN // CONTINUOUS FLOW</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 30%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 30%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 58%; /* Upper 58% open for user content */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 32px;
		box-sizing: border-box;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 5;
	}

	.gravity-hero-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		text-shadow: 0 0 10px rgba(var(--mdui-color-primary, 11, 87, 208), 0.35);
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseSpeed = 0;
		let isHovered = false;

		// Active interactive ripples triggered by mouse movement or clicks
		const ripples = [];

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed MDUI Grid Node representing a stable mini-card tile at container bottom
		class FixedCardTile {
			constructor(gx, gy, col, row) {
				this.originX = gx;
				this.originY = gy;
				this.col = col;
				this.row = row;
				this.x = gx;
				this.y = gy;
				this.energy = 0;
				this.currentW = 34;
				this.currentH = 34;
			}
		}

		let tiles = [];
		let stepX = 48;
		let stepY = 48;
		let cols = 0;
		let rows = 0;

		function initGrid() {
			tiles = [];
			// Water sits completely at the bottom of the container (lower ~42% of banner)
			const fluidTopY = height * 0.58;
			const fluidHeight = height - fluidTopY - 16; // 16px bottom padding

			// Card spacing: adaptive between 42px and 52px
			const targetStep = width < 640 ? 38 : (width < 1100 ? 46 : 52);
			cols = Math.floor(width / targetStep);
			stepX = width / cols;

			rows = Math.max(3, Math.floor(fluidHeight / targetStep));
			stepY = fluidHeight / rows;

			for (let r = 0; r < rows; r++) {
				const gy = fluidTopY + r * stepY + stepY * 0.5;
				for (let c = 0; c < cols; c++) {
					const gx = c * stepX + stepX * 0.5;
					tiles.push(new FixedCardTile(gx, gy, c, r));
				}
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGrid();
		}

		// Theme Color and Gradient Interpolation:
		// Base: Deep rich shade of theme color
		// Mid: Standard pure theme color
		// Peak / Crest: High-illuminance sunlit tint (tinted towards crisp white-blue)
		function getThemeGradientColor(t) {
			const clampedT = Math.max(0, Math.min(1, t));
			const [pr, pg, pb] = primaryColor;

			// Base deep tone
			const deepR = Math.round(pr * 0.35);
			const deepG = Math.round(pg * 0.4);
			const deepB = Math.round(pb * 0.55);

			// Peak highlighted tint
			const peakR = Math.round(pr + (255 - pr) * 0.65);
			const peakG = Math.round(pg + (255 - pg) * 0.65);
			const peakB = Math.round(pb + (255 - pb) * 0.75);

			let r, g, b;
			if (clampedT < 0.5) {
				// Deep to Primary
				const subT = clampedT / 0.5;
				r = Math.round(deepR + (pr - deepR) * subT);
				g = Math.round(deepG + (pg - deepG) * subT);
				b = Math.round(deepB + (pb - deepB) * subT);
			} else {
				// Primary to Highlight Peak
				const subT = (clampedT - 0.5) / 0.5;
				r = Math.round(pr + (peakR - pr) * subT);
				g = Math.round(pg + (peakG - pg) * subT);
				b = Math.round(pb + (peakB - pb) * subT);
			}

			return [r, g, b];
		}

		// Draw a solid, perfectly horizontal mini MDUI Card (NO rotation, clean Material shape)
		function drawFixedCard(cx, cy, w, h, radius, r, g, b, alpha, outlineAlpha) {
			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = Math.min(radius, halfW, halfH);

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - halfW, cy - halfH, w, h, cr);
			} else {
				ctx.moveTo(cx - halfW + cr, cy - halfH);
				ctx.lineTo(cx + halfW - cr, cy - halfH);
				ctx.quadraticCurveTo(cx + halfW, cy - halfH, cx + halfW, cy - halfH + cr);
				ctx.lineTo(cx + halfW, cy + halfH - cr);
				ctx.quadraticCurveTo(cx + halfW, cy + halfH, cx + halfW - cr, cy + halfH);
				ctx.lineTo(cx - halfW + cr, cy + halfH);
				ctx.quadraticCurveTo(cx - halfW, cy + halfH, cx - halfW, cy + halfH - cr);
				ctx.lineTo(cx - halfW, cy - halfH + cr);
				ctx.quadraticCurveTo(cx - halfW, cy - halfH, cx - halfW + cr, cy - halfH);
				ctx.closePath();
			}

			// Card Solid Fill
			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// 1px Material Design Card Edge Outline
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function render() {
			time += 0.016;

			// Mouse velocity calculation
			if (isHovered && prevMouseX > -1000) {
				const dist = Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY);
				mouseSpeed = mouseSpeed * 0.8 + dist * 0.2;

				if (mouseSpeed > 3.0) {
					ripples.push({
						x: mouseX,
						y: mouseY,
						radius: 10,
						strength: Math.min(1.0, mouseSpeed * 0.12),
						decay: 0.025
					});
					if (ripples.length > 25) ripples.shift();
				}
			} else {
				mouseSpeed *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			// Update interactive wave ripples
			for (let i = ripples.length - 1; i >= 0; i--) {
				const rp = ripples[i];
				rp.radius += 5.5;
				rp.strength -= rp.decay;
				if (rp.strength <= 0) {
					ripples.splice(i, 1);
				}
			}

			ctx.clearRect(0, 0, width, height);

			let avgEnergy = 0;

			// Continuous Perpetual Fluid Dynamics (runs constantly without interaction)
			// Multi-harmonic stream waves flowing across the bottom lattice
			const freqX1 = 0.007;
			const freqY1 = 0.016;
			const freqX2 = 0.014;
			const freqY2 = 0.011;

			for (let i = 0; i < tiles.length; i++) {
				const t = tiles[i];

				// 1. Natural perpetual fluid flow field (sine/cosine vorticity harmonics)
				const fluidWave1 = Math.sin(t.originX * freqX1 + time * 1.35) * Math.cos(t.originY * freqY1 - time * 0.85);
				const fluidWave2 = Math.cos(t.originX * freqX2 - t.originY * freqY2 + time * 1.7);
				const fluidWave3 = Math.sin((t.originX + t.originY) * 0.006 + time * 1.1);

				// Base perpetual fluid energy normalized to [0, 1]
				const naturalEnergy = (fluidWave1 * 0.45 + fluidWave2 * 0.35 + fluidWave3 * 0.2 + 1.0) * 0.5;

				// 2. Interactive fluid disturbance from mouse proximity and ripples
				let interactionEnergy = 0;
				if (isHovered) {
					const dx = t.originX - mouseX;
					const dy = t.originY - mouseY;
					const dist = Math.hypot(dx, dy);
					const mouseRadius = 140;

					if (dist < mouseRadius) {
						const proximity = 1 - dist / mouseRadius;
						interactionEnergy += Math.pow(proximity, 1.5) * (0.6 + mouseSpeed * 0.08);
					}
				}

				// Add ripple wave propagation
				for (let j = 0; j < ripples.length; j++) {
					const rp = ripples[j];
					const d = Math.hypot(t.originX - rp.x, t.originY - rp.y);
					const diff = Math.abs(d - rp.radius);
					if (diff < 45) {
						const ring = Math.cos((diff / 45) * Math.PI * 0.5) * rp.strength;
						interactionEnergy += ring * 0.8;
					}
				}

				// Target fluid energy
				const targetEnergy = Math.max(0, Math.min(1.0, naturalEnergy + interactionEnergy));
				// Smooth easing
				t.energy += (targetEnergy - t.energy) * 0.14;
				avgEnergy += t.energy;

				// 3. Fluid Swell Displacement (subtle vertical fluid heave, strictly horizontal, NO rotation)
				const fluidHeave = Math.sin(t.originX * 0.009 + time * 1.5) * (3 + t.energy * 6);
				t.x = t.originX;
				t.y = t.originY - fluidHeave;

				// 4. Large Card Size Scaling:
				// Base card size is generous (~34px to 40px)
				// Expands up to ~44px to 48px during energetic fluid surges
				const baseW = stepX * 0.74;
				const baseH = stepY * 0.74;
				const scaleFactor = 0.78 + t.energy * 0.44; // Scale between 0.78x and 1.22x
				t.currentW = baseW * scaleFactor;
				t.currentH = baseH * scaleFactor;
				const cardRadius = Math.min(t.currentW, t.currentH) * 0.26;

				// 5. Material Theme Color & Gradient Transition
				const [cr, cg, cb] = getThemeGradientColor(t.energy);
				const cardAlpha = Math.max(0.42, Math.min(0.96, 0.48 + t.energy * 0.48));
				const outlineAlpha = Math.max(0.08, Math.min(0.32, 0.12 + t.energy * 0.2));

				// Draw stable mini-card tile (0 rotation)
				drawFixedCard(
					t.x,
					t.y,
					t.currentW,
					t.currentH,
					cardRadius,
					cr,
					cg,
					cb,
					cardAlpha,
					outlineAlpha
				);
			}

			// Telemetry status
			if (telemetry) {
				const energyVal = (avgEnergy / Math.max(1, tiles.length)).toFixed(2);
				const statusTag = isHovered && mouseSpeed > 3 ? "TURBULENT SURGE" : (mouseSpeed > 0.5 ? "INTERACTIVE FLOW" : "PERPETUAL FLOW");
				telemetry.textContent = `FLUID·GRID // MATERIAL TILES: ${tiles.length} // KINETIC: ${energyVal} // ${statusTag}`;
			}

			requestAnimationFrame(render);
		}

		// Event listeners
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				ripples.push({
					x: mouseX,
					y: mouseY,
					radius: 8,
					strength: 1.2,
					decay: 0.02
				});
			}
		});

		// Touch interaction
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				ripples.push({
					x: mouseX,
					y: mouseY,
					radius: 8,
					strength: 1.2,
					decay: 0.02
				});
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
