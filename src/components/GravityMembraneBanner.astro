---
// GravityMembraneBanner.astro: Fixed-Grid Fluid Dynamics Display
// Features:
// - Absolutely fixed-position MDUI card grid (zero position/shape jitter or rotation)
// - Cards act like ASCII characters: cells toggle on/off (appear/disappear) based on fluid presence
// - Real fluid simulation: sloshing, crashing against container walls (deformation), and splashes
// - Fluid settles immediately at container bottom on load (no dropping down from top)
// - Continuous perpetual fluid motion even without interaction
// - Strict Material Theme color & gradient transitions
// - Upper container space open for custom content (via slot)
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<!-- Canvas simulating fluid presence over the fixed card matrix -->
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Upper spacious zone: reserved for user-defined content / elements -->
		<div class="banner-content-container">
			<slot />
		</div>

		<!-- Subtle technical telemetry at bottom corner -->
		<div class="fluid-telemetry">
			<span class="telemetry-badge" id="fluid-telemetry-metric">FLUID·VOXEL // MATRIX: FIXED GRID // STATE: DYNAMIC</span>
		</div>

		<!-- Minimalist scroll down indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	/* Preserving original fullscreen hero dimensions strictly */
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 30%, rgba(24, 25, 34, 0.96) 0%, rgba(10, 11, 16, 0.99) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 30%, rgba(18, 19, 28, 0.96) 0%, rgba(7, 8, 12, 0.99) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Upper spacious container slot for custom user elements */
	.banner-content-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 52%; /* Upper 52% wide open for custom titles/badges/cards */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: auto;
		z-index: 4;
		padding: 32px;
		box-sizing: border-box;
	}

	.fluid-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.65;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		font-size: 11px;
		letter-spacing: 0.1em;
		transition: opacity 0.2s ease;
		z-index: 5;
	}

	.gravity-hero-viewport:hover .fluid-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		text-shadow: 0 0 10px rgba(var(--mdui-color-primary, 11, 87, 208), 0.35);
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		opacity: 0.65;
		transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.fluid-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const telemetry = document.getElementById("fluid-telemetry-metric");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content on trigger
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Touch interaction state
		let mouseX = -9999;
		let mouseY = -9999;
		let prevMouseX = -9999;
		let prevMouseY = -9999;
		let mouseVx = 0;
		let mouseVy = 0;
		let isHovered = false;
		let splashTrigger = false;

		// Theme colors extracted dynamically from Material tokens
		let primaryColor = [11, 87, 208];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			primaryColor = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
		}

		// Fixed Card Grid Configuration
		// Every grid cell has a strictly invariant position and size (no rotation, no warping)
		let cols = 0;
		let rows = 0;
		let stepX = 46;
		let stepY = 40;
		let cardW = 38;
		let cardH = 32;
		let cardRadius = 8;
		let gridStartY = 0;

		// Cell state matrix (opacity / active state)
		let cellAlpha = [];
		let cellSpeed = [];

		// Fluid Particle Simulation System (under the hood)
		// Simulates real water sloshing, wall impacts, and droplet splashes
		class FluidParticle {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				this.vx = 0;
				this.vy = 0;
			}
		}

		let particles = [];
		let particleCount = 420;

		function initGridAndFluid() {
			// Grid covers the lower 58% of the container (leaving upper space for splashing & custom content)
			gridStartY = height * 0.44;
			const activeH = height - gridStartY - 12;

			const targetStepX = width < 640 ? 36 : (width < 1100 ? 44 : 48);
			const targetStepY = width < 640 ? 32 : 38;

			cols = Math.floor(width / targetStepX);
			stepX = width / cols;
			cardW = Math.round(stepX * 0.82);

			rows = Math.max(6, Math.floor(activeH / targetStepY));
			stepY = activeH / rows;
			cardH = Math.round(stepY * 0.82);
			cardRadius = Math.round(Math.min(cardW, cardH) * 0.28);

			// Initialize cell matrices
			cellAlpha = [];
			cellSpeed = [];
			for (let r = 0; r < rows; r++) {
				cellAlpha.push(new Float32Array(cols));
				cellSpeed.push(new Float32Array(cols));
			}

			// Initialize particles: settled immediately at container bottom (NO dropping from above)
			particles = [];
			particleCount = width < 640 ? 280 : 420;

			const bottomBedDepth = rows * stepY * 0.45; // Water depth in bottom ~45% of active grid
			const fluidBedTop = height - bottomBedDepth - 16;
			const usableW = width - 32;

			const pCols = Math.ceil(Math.sqrt(particleCount * (usableW / bottomBedDepth)));
			const pRows = Math.ceil(particleCount / pCols);
			const dx = usableW / pCols;
			const dy = bottomBedDepth / pRows;

			for (let r = 0; r < pRows; r++) {
				for (let c = 0; c < pCols; c++) {
					if (particles.length >= particleCount) break;
					const px = 16 + c * dx + (r % 2) * (dx * 0.5) + (Math.random() - 0.5) * 3;
					const py = fluidBedTop + r * dy + (Math.random() - 0.5) * 3;
					particles.push(new FluidParticle(px, py));
				}
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initGridAndFluid();
		}

		// Theme Color and Gradient Palette:
		// Based strictly on Material Theme Primary token
		// Deep Bed (low energy/deep water): rich dark primary tone
		// Mid Layer: pure Material primary color
		// Crest / Splash: luminous tinted primary highlight
		function getThemeGradientColor(energyRatio, rowRatio) {
			const [pr, pg, pb] = primaryColor;

			// Base deep tone at the container bed
			const deepR = Math.round(pr * 0.4);
			const deepG = Math.round(pg * 0.45);
			const deepB = Math.round(pb * 0.6);

			// Bright crest/splash highlight
			const crestR = Math.round(pr + (255 - pr) * 0.65);
			const crestG = Math.round(pg + (255 - pg) * 0.65);
			const crestB = Math.round(pb + (255 - pb) * 0.78);

			// Combined tone factor: row 0 is water surface/splashes, row rows-1 is container bed
			const t = Math.max(0, Math.min(1.0, (1 - rowRatio) * 0.6 + energyRatio * 0.55));

			let r, g, b;
			if (t < 0.5) {
				const subT = t / 0.5;
				r = Math.round(deepR + (pr - deepR) * subT);
				g = Math.round(deepG + (pg - deepG) * subT);
				b = Math.round(deepB + (pb - deepB) * subT);
			} else {
				const subT = (t - 0.5) / 0.5;
				r = Math.round(pr + (crestR - pr) * subT);
				g = Math.round(pg + (crestG - pg) * subT);
				b = Math.round(pb + (crestB - pb) * subT);
			}

			return [r, g, b];
		}

		// Draw fixed-position, non-rotating MDUI Card tile
		function drawCardTile(cx, cy, w, h, r, g, b, alpha, outlineAlpha) {
			const halfW = w * 0.5;
			const halfH = h * 0.5;
			const cr = cardRadius;

			ctx.beginPath();
			if (typeof ctx.roundRect === "function") {
				ctx.roundRect(cx - halfW, cy - halfH, w, h, cr);
			} else {
				ctx.moveTo(cx - halfW + cr, cy - halfH);
				ctx.lineTo(cx + halfW - cr, cy - halfH);
				ctx.quadraticCurveTo(cx + halfW, cy - halfH, cx + halfW, cy - halfH + cr);
				ctx.lineTo(cx + halfW, cy + halfH - cr);
				ctx.quadraticCurveTo(cx + halfW, cy + halfH, cx + halfW - cr, cy + halfH);
				ctx.lineTo(cx - halfW + cr, cy + halfH);
				ctx.quadraticCurveTo(cx - halfW, cy + halfH, cx - halfW, cy + halfH - cr);
				ctx.lineTo(cx - halfW, cy - halfH + cr);
				ctx.quadraticCurveTo(cx - halfW, cy - halfH, cx - halfW + cr, cy - halfH);
				ctx.closePath();
			}

			ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
			ctx.fill();

			// Clean Material 1px stroke
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(255, 255, 255, ${outlineAlpha})`;
			ctx.stroke();
		}

		let time = 0;

		function updatePhysics() {
			time += 0.016;

			// Mouse velocity
			if (isHovered && prevMouseX > -1000) {
				mouseVx = (mouseX - prevMouseX) * 0.65;
				mouseVy = (mouseY - prevMouseY) * 0.65;
			} else {
				mouseVx *= 0.85;
				mouseVy *= 0.85;
			}
			prevMouseX = mouseX;
			prevMouseY = mouseY;

			const GRAV = 0.28;
			const H_INTERACTION = 30.0;
			const H2 = H_INTERACTION * H_INTERACTION;

			// Natural perpetual fluid sloshing & convection (sloshing left-right across container bed)
			const sloshWave = Math.sin(time * 1.35) * 0.22;
			const convection = Math.cos(time * 1.85) * 0.12;

			// SPH particle interaction & integration
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];

				// Gravity + continuous perpetual fluid drift
				let ax = sloshWave + Math.cos(p.y * 0.015 + time * 2) * convection;
				let ay = GRAV;

				// Mouse agitation & splash trigger
				if (isHovered) {
					const dx = p.x - mouseX;
					const dy = p.y - mouseY;
					const dist = Math.hypot(dx, dy);
					const mouseRadius = 110;

					if (dist < mouseRadius && dist > 1) {
						const factor = 1.0 - dist / mouseRadius;
						// Push water away + impart mouse momentum
						ax += (dx / dist) * factor * 14.0 + mouseVx * factor * 1.6;
						ay += (dy / dist) * factor * 14.0 + mouseVy * factor * 1.6;

						if (splashTrigger) {
							// Explosive upward splash on click / tap
							ay -= factor * 38.0;
							ax += (Math.random() - 0.5) * 22.0;
						}
					}
				}

				// Soft particle-particle repulsion (keeps water volume and sloshing wave fronts)
				// Subsample neighbors for fast 60fps performance
				const checkCount = Math.min(particles.length, 36);
				const step = Math.floor(particles.length / checkCount);
				for (let k = 0; k < checkCount; k++) {
					const j = (i + k * step) % particles.length;
					if (i === j) continue;
					const pj = particles[j];
					const rx = p.x - pj.x;
					const ry = p.y - pj.y;
					const r2 = rx * rx + ry * ry;
					if (r2 < H2 && r2 > 0.1) {
						const r = Math.sqrt(r2);
						const repulse = (1.0 - r / H_INTERACTION) * 1.25;
						ax += (rx / r) * repulse;
						ay += (ry / r) * repulse;
					}
				}

				// Velocity integration & viscous damping
				p.vx = (p.vx + ax * 0.65) * 0.988;
				p.vy = (p.vy + ay * 0.65) * 0.988;

				p.x += p.vx * 0.65;
				p.y += p.vy * 0.65;

				// Container boundaries:
				// Left wall: collision & piling up
				if (p.x < 12) {
					p.x = 12;
					p.vx *= -0.45;
					// Fluid climbs wall slightly upon collision
					p.vy -= Math.abs(p.vx) * 0.3;
				}
				// Right wall: collision & piling up
				if (p.x > width - 12) {
					p.x = width - 12;
					p.vx *= -0.45;
					p.vy -= Math.abs(p.vx) * 0.3;
				}
				// Bottom bed of container
				if (p.y > height - 16) {
					p.y = height - 16;
					p.vy *= -0.3;
				}
				// Top open (splashes can freely fly and fall back under gravity)
			}

			splashTrigger = false;
		}

		function render() {
			updatePhysics();

			ctx.clearRect(0, 0, width, height);

			// Target density/energy per grid cell
			const targetOcc = [];
			const targetSpd = [];
			for (let r = 0; r < rows; r++) {
				targetOcc.push(new Float32Array(cols));
				targetSpd.push(new Float32Array(cols));
			}

			// Map fluid particles into the fixed grid cells (Rasterization)
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];
				if (p.y < gridStartY - stepY) continue; // Out of grid bounds

				const c = Math.floor(p.x / stepX);
				const r = Math.floor((p.y - gridStartY) / stepY);

				if (c >= 0 && c < cols && r >= 0 && r < rows) {
					targetOcc[r][c] += 1;
					const spd = Math.hypot(p.vx, p.vy);
					if (spd > targetSpd[r][c]) targetSpd[r][c] = spd;
				}
			}

			let activeCardsCount = 0;

			// Render the fixed grid matrix:
			// Cells with fluid presence show solid MDUI cards.
			// Empty cells are either hidden or shown as subtle ghost outlines.
			for (let r = 0; r < rows; r++) {
				const rowRatio = r / (rows - 1);
				const cy = gridStartY + r * stepY + stepY * 0.5;

				for (let c = 0; c < cols; c++) {
					const cx = c * stepX + stepX * 0.5;

					const hasFluid = targetOcc[r][c] > 0;
					const targetA = hasFluid ? Math.min(1.0, 0.45 + targetOcc[r][c] * 0.28) : 0;
					const targetS = targetSpd[r][c];

					// Smooth temporal transition for cell appearance/disappearance
					cellAlpha[r][c] += (targetA - cellAlpha[r][c]) * 0.22;
					cellSpeed[r][c] += (targetS - cellSpeed[r][c]) * 0.18;

					const currentA = cellAlpha[r][c];
					const energy = Math.min(1.0, cellSpeed[r][c] / 4.5);

					if (currentA > 0.04) {
						activeCardsCount++;
						// Dynamic theme color reflecting fluid depth and splash speed
						const [cr, cg, cb] = getThemeGradientColor(energy, rowRatio);
						const cardAlpha = Math.max(0.35, Math.min(0.96, currentA));
						const outlineA = Math.max(0.12, Math.min(0.35, currentA * 0.35));

						// Strictly fixed position and shape (no rotation, no warping)
						drawCardTile(cx, cy, cardW, cardH, cr, cg, cb, cardAlpha, outlineA);
					} else {
						// Subtle ghost baseline card slot outline for elegant Material structural matrix
						ctx.beginPath();
						if (typeof ctx.roundRect === "function") {
							ctx.roundRect(cx - cardW * 0.5, cy - cardH * 0.5, cardW, cardH, cardRadius);
						}
						ctx.lineWidth = 1;
						ctx.strokeStyle = "rgba(255, 255, 255, 0.025)";
						ctx.stroke();
					}
				}
			}

			// Telemetry status
			if (telemetry) {
				const statusTag = isHovered && mouseSpeed > 3 ? "SPLASHING & CRASHING" : "SLOSHING DYNAMICS";
				telemetry.textContent = `FLUID·VOXEL // ACTIVE TILES: ${activeCardsCount} // PARTICLES: ${particleCount} // ${statusTag}`;
			}

			let mouseSpeed = Math.hypot(mouseVx, mouseVy);

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				splashTrigger = true;
			}
		});

		// Touch
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				splashTrigger = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
