---
// GravityMembraneBanner.astro: Fullscreen Hero ASCII Gravity Membrane
// Zero superfluous slogans/text. Pure kinetic geometry & gravitational well physics.
---

<div class="gravity-fullscreen-hero" id="gravity-hero-container">
	<div class="gravity-hero-viewport" id="gravity-banner-root">
		<canvas id="gravity-banner-canvas" aria-hidden="true"></canvas>

		<!-- Subtle technical telemetry -->
		<div class="gravity-telemetry">
			<span class="telemetry-badge" id="telemetry-metric">G·MEMBRANE // TENSION: 1.00 // EQUILIBRIUM</span>
		</div>

		<!-- Minimalist scroll indicator -->
		<button class="gravity-scroll-down" id="gravity-scroll-trigger" aria-label="向下滚动至内容" title="向下滚动">
			<div class="scroll-ascii-glyph">
				<span class="glyph-line">|</span>
				<span class="glyph-arrow">v</span>
			</div>
		</button>
	</div>
</div>

<style>
	.gravity-fullscreen-hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		height: 100vh;
		min-height: 540px;
		max-height: 1080px;
		margin-top: -20px; /* Align to top flush */
		margin-bottom: 28px;
		overflow: hidden;
	}

	.gravity-hero-viewport {
		position: relative;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 50% 50%, rgba(var(--mdui-color-surface-container, 24, 24, 30), 0.5) 0%, rgba(var(--mdui-color-surface, 15, 15, 20), 0.95) 100%);
		border-bottom: 1px solid rgba(var(--mdui-color-outline-variant, 120, 120, 130), 0.18);
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .gravity-hero-viewport {
		background: radial-gradient(circle at 50% 50%, rgba(20, 20, 28, 0.6) 0%, rgba(10, 10, 14, 0.98) 100%);
		border-bottom-color: rgba(255, 255, 255, 0.08);
	}

	#gravity-banner-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.gravity-telemetry {
		position: absolute;
		bottom: 22px;
		right: 28px;
		pointer-events: none;
		opacity: 0.6;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 11px;
		letter-spacing: 0.12em;
		transition: opacity 0.2s ease;
		z-index: 2;
	}

	.gravity-hero-viewport:hover .gravity-telemetry {
		opacity: 0.95;
	}

	.telemetry-badge {
		color: rgb(var(--mdui-color-on-surface-variant, 140, 140, 150));
	}

	/* Minimalist ASCII scroll indicator */
	.gravity-scroll-down {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: transparent;
		border: none;
		padding: 12px;
		cursor: pointer;
		color: rgb(var(--mdui-color-on-surface-variant, 140, 140, 150));
		opacity: 0.6;
		transition: opacity 0.2s ease, transform 0.2s ease;
		z-index: 2;
		outline: none;
	}

	.gravity-scroll-down:hover {
		opacity: 1;
		color: rgb(var(--mdui-color-primary, 11, 87, 208));
		transform: translateX(-50%) translateY(3px);
	}

	.scroll-ascii-glyph {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.1;
		animation: scroll-bob 2.2s ease-in-out infinite;
	}

	@keyframes scroll-bob {
		0%, 100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: translateY(6px);
			opacity: 1;
		}
	}

	@media (max-width: 600px) {
		.gravity-fullscreen-hero {
			height: 82vh;
			min-height: 480px;
			margin-bottom: 20px;
		}
		.gravity-telemetry {
			font-size: 9px;
			bottom: 12px;
			right: 14px;
		}
		.gravity-scroll-down {
			bottom: 14px;
		}
	}
</style>

<script is:inline>
	(function () {
		const root = document.getElementById("gravity-banner-root");
		const canvas = document.getElementById("gravity-banner-canvas");
		const telemetry = document.getElementById("telemetry-metric");
		const scrollBtn = document.getElementById("gravity-scroll-trigger");
		if (!canvas || !root) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// Scroll to content when clicking indicator
		if (scrollBtn) {
			scrollBtn.addEventListener("click", () => {
				const hero = document.getElementById("gravity-hero-container");
				if (hero) {
					const targetY = hero.offsetTop + hero.offsetHeight - 16;
					window.scrollTo({ top: targetY, behavior: "smooth" });
				}
			});
		}

		// Font and ASCII ramps
		const FONT_SIZE = 13;
		const FONT_FAMILY = 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace';
		const CHAR_ASPECT = 0.6;
		const CHAR_W = FONT_SIZE * CHAR_ASPECT;

		// Density ramp
		const DENSITY_RAMP = " .·:;+=xX$#@";

		let width = 0;
		let height = 0;
		let dpr = 1;

		// Mouse & Physical state
		let mouseX = -9999;
		let mouseY = -9999;
		let isHovered = false;
		let isPressed = false;
		let pressStrength = 0; // 0 to 1 smooth buildup
		let shockwaveRadius = -1;
		let shockwaveStrength = 0;

		// Theme colors extracted dynamically
		let colorPrimary = [11, 87, 208];
		let colorOnSurface = [160, 160, 170];

		function parseRgb(str, fallback) {
			if (!str) return fallback;
			const m = str.match(/[\d.]+/g);
			if (m && m.length >= 3) {
				return [parseFloat(m[0]), parseFloat(m[1]), parseFloat(m[2])];
			}
			return fallback;
		}

		function updateTheme() {
			const cs = getComputedStyle(document.documentElement);
			colorPrimary = parseRgb(cs.getPropertyValue("--mdui-color-primary").trim(), [11, 87, 208]);
			colorOnSurface = parseRgb(cs.getPropertyValue("--mdui-color-on-surface").trim(), [160, 160, 170]);
		}

		// Density of the membrane grid (expanded for full-screen breadth)
		let GRID_X = 58;
		let GRID_Y = 32;

		class Point {
			constructor(ox, oy) {
				this.ox = ox; // normalized [-1, 1]
				this.oy = oy; // normalized [-1, 1]
				this.x = 0;
				this.y = 0;
				this.z = 0;
				this.vz = 0;
			}
		}

		let points = [];
		function initGrid() {
			points = [];
			for (let j = 0; j < GRID_Y; j++) {
				const row = [];
				const ny = (j / (GRID_Y - 1)) * 2 - 1;
				for (let i = 0; i < GRID_X; i++) {
					const nx = (i / (GRID_X - 1)) * 2 - 1;
					row.push(new Point(nx, ny));
				}
				points.push(row);
			}
		}
		initGrid();

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;

			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			// Adaptive grid density based on width
			if (width < 600) {
				GRID_X = 38;
				GRID_Y = 24;
				initGrid();
			} else if (width > 1200) {
				GRID_X = 64;
				GRID_Y = 36;
				initGrid();
			}
		}

		// Octahedron core in 3D: 6 vertices
		const coreVertices = [
			[0, 1.25, 0],   // top
			[0, -1.25, 0],  // bottom
			[-1.1, 0, 0],   // left
			[1.1, 0, 0],    // right
			[0, 0, -1.1],   // back
			[0, 0, 1.1]     // front
		];

		const coreEdges = [
			[0, 2], [0, 3], [0, 4], [0, 5],
			[1, 2], [1, 3], [1, 4], [1, 5],
			[2, 4], [4, 3], [3, 5], [5, 2]
		];

		let rotX = 0.35;
		let rotY = 0;
		let time = 0;

		function render() {
			time += 0.016;

			// Smooth press transition
			if (isPressed) {
				pressStrength += (1 - pressStrength) * 0.12;
			} else {
				pressStrength += (0 - pressStrength) * 0.08;
			}

			// Shockwave propagation
			if (shockwaveRadius >= 0) {
				shockwaveRadius += 10;
				shockwaveStrength *= 0.94;
				if (shockwaveStrength < 0.01 || shockwaveRadius > Math.max(width, height) * 1.6) {
					shockwaveRadius = -1;
				}
			}

			// Auto rotation of central core with subtle mouse influence
			rotY += 0.011 + (pressStrength * 0.028);
			rotX = 0.36 + Math.sin(time * 0.5) * 0.08;

			ctx.clearRect(0, 0, width, height);

			const centerX = width * 0.5;
			const centerY = height * 0.52;
			const membranePitch = 0.65; // perspective pitch tilt

			const normMouseX = mouseX;
			const normMouseY = mouseY;

			// Dynamic depth and well size scaled to fullscreen dimensions
			const maxDepth = (height * 0.18) + pressStrength * 120;
			const wellRadius = (Math.min(width, height) * 0.3) + pressStrength * 60;

			// Update physics & projection
			for (let j = 0; j < points.length; j++) {
				const row = points[j];
				for (let i = 0; i < row.length; i++) {
					const p = row[i];
					
					// Flat 3D plane coordinates spanning fullscreen breadth
					const px3d = p.ox * (width * 0.55);
					const py3d = p.oy * (height * 0.72);

					// Screen project with perspective
					let sx = centerX + px3d;
					let sy = centerY + py3d * membranePitch;

					// Singularity gravitational pull from center
					const distCenter = Math.hypot(px3d, py3d);
					const centerDepression = Math.exp(-distCenter / (Math.min(width, height) * 0.16)) * (65 + pressStrength * 55);

					// Mouse depression well
					let mouseDepression = 0;
					if (isHovered) {
						const distMouse = Math.hypot(sx - normMouseX, sy - normMouseY);
						mouseDepression = Math.exp(-Math.pow(distMouse / wellRadius, 2)) * maxDepth;
					}

					// Shockwave ripple
					let shockDisplacement = 0;
					if (shockwaveRadius >= 0) {
						const distOrigin = Math.hypot(sx - (isHovered ? normMouseX : centerX), sy - (isHovered ? normMouseY : centerY));
						const delta = distOrigin - shockwaveRadius;
						if (Math.abs(delta) < 55) {
							shockDisplacement = Math.sin(delta * 0.12) * 22 * shockwaveStrength;
						}
					}

					// Target Z displacement (downward gravity well)
					const targetZ = -(centerDepression + mouseDepression + shockDisplacement);

					// Damped spring physics on Z
					const springK = 0.14;
					const damping = 0.83;
					p.vz += (targetZ - p.z) * springK;
					p.vz *= damping;
					p.z += p.vz;

					// Final projected screen coords
					p.x = sx;
					p.y = sy - p.z * 0.88;
				}
			}

			// Render ASCII grid lines & characters
			ctx.font = `${FONT_SIZE}px ${FONT_FAMILY}`;
			ctx.textBaseline = "middle";
			ctx.textAlign = "center";

			// Draw horizontal & vertical topological contours with ASCII chars
			for (let j = 0; j < points.length; j++) {
				const rowT = j / (points.length - 1);
				const depthFade = 0.18 + rowT * 0.75;

				for (let i = 0; i < points[j].length; i++) {
					const p = points[j][i];
					const zDisp = Math.abs(p.z);

					let char = "·";
					let alpha = 0.16 * depthFade;
					let isAccent = false;

					if (zDisp > 55) {
						char = "+";
						alpha = Math.min(0.9, 0.4 + zDisp * 0.006);
						isAccent = true;
					} else if (zDisp > 26) {
						char = ":";
						alpha = Math.min(0.65, 0.25 + zDisp * 0.007);
					} else if (i % 2 === 0 && j % 2 === 0) {
						char = "+";
						alpha = 0.22 * depthFade;
					}

					if (isAccent) {
						ctx.fillStyle = `rgba(${colorPrimary[0]}, ${colorPrimary[1]}, ${colorPrimary[2]}, ${alpha})`;
					} else {
						ctx.fillStyle = `rgba(${colorOnSurface[0]}, ${colorOnSurface[1]}, ${colorOnSurface[2]}, ${alpha})`;
					}

					ctx.fillText(char, p.x, p.y);
				}
			}

			// Render central 3D rotating ASCII Octahedron (Singularity core)
			const coreScale = (Math.min(width, height) * 0.09) + pressStrength * 16;
			const cosY = Math.cos(rotY);
			const sinY = Math.sin(rotY);
			const cosX = Math.cos(rotX);
			const sinX = Math.sin(rotX);

			// Project 3D core vertices to screen
			const projectedCore = coreVertices.map(([vx, vy, vz]) => {
				let x1 = vx * cosY - vz * sinY;
				let z1 = vx * sinY + vz * cosY;
				let y2 = vy * cosX - z1 * sinX;
				let z2 = vy * sinX + z1 * cosX;

				return {
					x: centerX + x1 * coreScale,
					y: centerY + y2 * coreScale - 10,
					z: z2
				};
			});

			// Draw core wireframe using dense ASCII ticks
			for (const [v0Idx, v1Idx] of coreEdges) {
				const a = projectedCore[v0Idx];
				const b = projectedCore[v1Idx];

				const dx = b.x - a.x;
				const dy = b.y - a.y;
				const dist = Math.hypot(dx, dy);
				const steps = Math.max(3, Math.floor(dist / (CHAR_W * 1.15)));

				for (let s = 0; s <= steps; s++) {
					const t = s / steps;
					const px = a.x + dx * t;
					const py = a.y + dy * t;
					const avgZ = a.z + (b.z - a.z) * t;

					const zNorm = (avgZ + 1.25) / 2.5;
					const brightness = Math.max(0.2, Math.min(1, zNorm));
					const charIdx = Math.floor(brightness * (DENSITY_RAMP.length - 1));
					const ch = DENSITY_RAMP[charIdx] || "·";

					const alpha = 0.35 + brightness * 0.65;
					if (brightness > 0.65 || pressStrength > 0.35) {
						ctx.fillStyle = `rgba(${colorPrimary[0]}, ${colorPrimary[1]}, ${colorPrimary[2]}, ${alpha})`;
					} else {
						ctx.fillStyle = `rgba(${colorOnSurface[0]}, ${colorOnSurface[1]}, ${colorOnSurface[2]}, ${alpha})`;
					}
					ctx.fillText(ch, px, py);
				}
			}

			// Center Singularity core pulse
			const pulseChar = pressStrength > 0.6 ? "@" : (pressStrength > 0.2 ? "#" : "*");
			ctx.fillStyle = `rgb(${colorPrimary[0]}, ${colorPrimary[1]}, ${colorPrimary[2]})`;
			ctx.fillText(pulseChar, centerX, centerY - 10);

			// Real-time scientific tension metric
			if (telemetry) {
				const tensionVal = (1.0 + pressStrength * 4.25 + (shockwaveRadius >= 0 ? 0.95 : 0)).toFixed(2);
				const statusTag = isPressed ? "COMPRESSED" : (isHovered ? "WARPED" : "EQUILIBRIUM");
				telemetry.textContent = `G·MEMBRANE // TENSION: ${tensionVal} // ${statusTag}`;
			}

			requestAnimationFrame(render);
		}

		// Event handlers
		root.addEventListener("mousemove", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseenter", (e) => {
			const rect = root.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
			isHovered = true;
		});

		root.addEventListener("mouseleave", () => {
			isHovered = false;
			isPressed = false;
			mouseX = -9999;
			mouseY = -9999;
		});

		root.addEventListener("mousedown", (e) => {
			if (e.button === 0) {
				isPressed = true;
			}
		});

		window.addEventListener("mouseup", () => {
			if (isPressed) {
				isPressed = false;
				shockwaveRadius = 0;
				shockwaveStrength = 1.0;
			}
		});

		// Mobile touch interaction
		root.addEventListener("touchstart", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
				isPressed = true;
			}
		}, { passive: true });

		root.addEventListener("touchmove", (e) => {
			if (e.touches.length > 0) {
				const rect = root.getBoundingClientRect();
				mouseX = e.touches[0].clientX - rect.left;
				mouseY = e.touches[0].clientY - rect.top;
				isHovered = true;
			}
		}, { passive: true });

		root.addEventListener("touchend", () => {
			if (isPressed) {
				isPressed = false;
				shockwaveRadius = 0;
				shockwaveStrength = 1.0;
			}
			isHovered = false;
		});

		window.addEventListener("resize", resize);

		updateTheme();
		const observer = new MutationObserver(() => updateTheme());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"]
		});

		resize();
		requestAnimationFrame(render);
	})();
</script>
