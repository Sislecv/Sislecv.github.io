---
import { theme } from "../site.config";
const SCHEMES = theme.schemes;
---

<mdui-card clickable variant="elevated" class="bento-card">
	<div class="card-body">
		<div class="appearance-row" style="padding: 0">
			<mdui-icon-light-mode--outlined style="font-size: 20px"></mdui-icon-light-mode--outlined>
			<mdui-switch id="dark-switch" aria-label="深色模式"></mdui-switch>
			<mdui-icon-dark-mode--outlined style="font-size: 20px"></mdui-icon-dark-mode--outlined>
		</div>
		<div class="scheme-grid" style="margin-top: 12px">
			{
				SCHEMES.map((s) => (
					<button
						type="button"
						class="scheme-dot"
						style={`background: ${s.color}`}
						data-color={s.color}
						aria-label={s.name}
						title={s.name}
					></button>
				))
			}
		</div>
	</div>
</mdui-card>

<script>
	import { setColorScheme } from "mdui";
	import { theme as themeConfig } from "../site.config";
	import { isDark, setAppTheme } from "../lib/theme";

	const darkSwitch = document.getElementById("dark-switch") as HTMLInputElement | null;

	const syncSwitch = () => {
		if (darkSwitch) darkSwitch.checked = isDark();
	};

	const syncActiveDot = (currentColor: string) => {
		document.querySelectorAll<HTMLElement>(".scheme-dot").forEach((dot) => {
			if (dot.dataset.color?.toLowerCase() === currentColor.toLowerCase()) {
				dot.classList.add("is-active");
			} else {
				dot.classList.remove("is-active");
			}
		});
	};

	let savedColor = themeConfig.defaultColor;
	try {
		savedColor = localStorage.getItem("scheme") || themeConfig.defaultColor;
	} catch {
		/* ignore */
	}
	syncActiveDot(savedColor);

	darkSwitch?.addEventListener("change", () => {
		setAppTheme(darkSwitch.checked ? "dark" : "light");
	});

	window.addEventListener("app:theme-changed", syncSwitch);
	window
		.matchMedia("(prefers-color-scheme: dark)")
		.addEventListener("change", () => {
			if (!localStorage.getItem("theme")) {
				syncSwitch();
			}
		});
	syncSwitch();

	const card = darkSwitch?.closest("mdui-card");
	card?.addEventListener("click", (e: Event) => {
		const dot = (e.target as HTMLElement).closest(".scheme-dot") as HTMLElement | null;
		if (dot?.dataset.color) {
			try {
				setColorScheme(dot.dataset.color);
				localStorage.setItem("scheme", dot.dataset.color);
				syncActiveDot(dot.dataset.color);
			} catch {
				/* ignore */
			}
		}
	});
</script>

<style>
	.appearance-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		gap: 8px;
		color: rgb(var(--mdui-color-on-surface));
	}

	.scheme-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		width: 100%;
	}

	.scheme-dot {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 2px solid transparent;
		cursor: pointer;
		padding: 0;
		outline: none;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
			box-shadow var(--md-duration-short, 200ms) var(--md-easing-standard, ease);
	}

	.scheme-dot:hover {
		transform: scale(1.15);
	}

	.scheme-dot.is-active {
		border-color: rgb(var(--mdui-color-on-surface));
		box-shadow: 0 0 0 2px rgb(var(--mdui-color-surface)), 0 0 0 4px rgb(var(--mdui-color-primary));
		transform: scale(1.1);
	}
</style>
