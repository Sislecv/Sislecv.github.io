<!-- Minimal ASCII dot-grid background:
     - uniform gray dots (quiet, no scattered clutter)
     - cursor lights up nearby dots with a soft radial falloff (halo, not cluster)
     - glowing dots along the cursor trail decay slowly (1.5s afterglow) -->
<canvas id="ascii-bg" aria-hidden="true"></canvas>

<script is:inline>
	(function () {
		const canvas = document.getElementById("ascii-bg");
		if (!canvas) return;
		const ctx = canvas.getContext("2d");

		const SPACING = 30; // dot grid spacing
		const DOT = 3; // dot size
		const RADIUS = 180; // light radius
		const FALLOFF = 0.96; // afterglow decay per frame (~1.5s)
		const GRAY_ALPHA = 0.2; // resting dot opacity
		const LIT_ALPHA = 0.75; // max lit opacity

		let width = 0;
		let height = 0;
		let cols = 0;
		let rows = 0;
		const dots = []; // { x, y, glow }

		let mouseX = -9999;
		let mouseY = -9999;
		let mouseActive = false;
		let primary = [11, 87, 208];
		let gray = [27, 27, 31];
		let reduced = false;

		function readThemeColors() {
			const cs = getComputedStyle(document.documentElement);
			const primaryRaw = cs.getPropertyValue("--mdui-color-primary").trim();
			const m = primaryRaw.match(/^([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/);
			if (m) primary = [parseFloat(m[1]), parseFloat(m[2]), parseFloat(m[3])];
			const onSurfaceRaw = cs.getPropertyValue("--mdui-color-on-surface").trim();
			const g = onSurfaceRaw.match(/^([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/);
			if (g) gray = [parseFloat(g[1]), parseFloat(g[2]), parseFloat(g[3])];
		}

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			canvas.style.width = width + "px";
			canvas.style.height = height + "px";
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			cols = Math.ceil(width / SPACING) + 1;
			rows = Math.ceil(height / SPACING) + 1;
			dots.length = 0;
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					dots.push({ x: c * SPACING + SPACING / 2, y: r * SPACING + SPACING / 2, glow: 0 });
				}
			}
		}

		function draw() {
			ctx.clearRect(0, 0, width, height);
			const r2 = RADIUS * RADIUS;
			for (const d of dots) {
				// afterglow decay
				d.glow *= FALLOFF;

				let lit = false;
				if (mouseActive) {
					const dx = d.x - mouseX;
					const dy = d.y - mouseY;
					const dist2 = dx * dx + dy * dy;
					if (dist2 < r2) {
						const t = 1 - Math.sqrt(dist2) / RADIUS;
						if (t > d.glow) {
							d.glow = t;
							lit = true;
						}
					}
				}

				if (d.glow < 0.02) {
					ctx.fillStyle = `rgba(${gray[0]}, ${gray[1]}, ${gray[2]}, ${GRAY_ALPHA})`;
					ctx.fillRect(d.x - DOT / 2, d.y - DOT / 2, DOT, DOT);
				} else {
					const a = Math.min(d.glow * LIT_ALPHA, 0.85);
					ctx.fillStyle = `rgba(${primary[0]}, ${primary[1]}, ${primary[2]}, ${a})`;
					// lit dots glow slightly larger
					const s = DOT + d.glow * 2.5;
					ctx.fillRect(d.x - s / 2, d.y - s / 2, s, s);
				}
			}
		}

		function loop() {
			draw();
			requestAnimationFrame(loop);
		}

		window.addEventListener("mousemove", (e) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
			mouseActive = true;
		});
		window.addEventListener("mouseleave", () => {
			mouseActive = false;
		});
		window.addEventListener("resize", resize);

		reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		readThemeColors();
		const observer = new MutationObserver(() => readThemeColors());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"],
		});

		resize();
		if (!reduced) {
			requestAnimationFrame(loop);
		} else {
			draw();
		}
	})();
</script>
