<!-- base.org style interactive background: sparse blocks ATTRACT toward the cursor,
     forming a cluster near it, and relax back when the cursor leaves. -->
<canvas id="ascii-bg" aria-hidden="true"></canvas>

<script is:inline>
	(function () {
		const canvas = document.getElementById("ascii-bg");
		if (!canvas) return;
		const ctx = canvas.getContext("2d");

		const CELL = 38; // base grid spacing
		const BLOCK = 10; // block size
		const RADIUS = 280; // attract radius
		const MAX_ALPHA = 0.5;

		let width = 0;
		let height = 0;
		let cols = 0;
		let rows = 0;
		const blocks = []; // { bx, by, x, y, alpha, bright }

		let mouseX = -9999;
		let mouseY = -9999;
		let mouseActive = false;
		let primary = [11, 87, 208];
		let reduced = false;

		function readThemeColor() {
			const cs = getComputedStyle(document.documentElement);
			const raw = cs.getPropertyValue("--mdui-color-primary").trim();
			const m = raw.match(/^([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/);
			if (m) primary = [parseFloat(m[1]), parseFloat(m[2]), parseFloat(m[3])];
		}

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			canvas.style.width = width + "px";
			canvas.style.height = height + "px";
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			cols = Math.ceil(width / CELL) + 1;
			rows = Math.ceil(height / CELL) + 1;
			blocks.length = 0;
			let seed = 42;
			const rand = () => {
				seed = (seed * 16807) % 2147483647;
				return seed / 2147483647;
			};
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					if (rand() < 0.3) continue; // ~70% sparse
					const jx = (rand() - 0.5) * (CELL - BLOCK);
					const jy = (rand() - 0.5) * (CELL - BLOCK);
					const bx = c * CELL + CELL / 2 + jx;
					const by = r * CELL + CELL / 2 + jy;
					blocks.push({
						bx,
						by,
						x: bx,
						y: by,
						alpha: 0.35 + rand() * 0.65,
						bright: 0, // extra alpha while attracted
					});
				}
			}
		}

		function draw() {
			ctx.clearRect(0, 0, width, height);
			const r2 = RADIUS * RADIUS;
			for (const b of blocks) {
				const dx = b.x - mouseX;
				const dy = b.y - mouseY;
				const dist2 = dx * dx + dy * dy;
				let tx = b.bx;
				let ty = b.by;
				let targetBright = 0;
				if (mouseActive && dist2 < r2) {
					const dist = Math.sqrt(dist2) || 1;
					const t = 1 - dist / RADIUS;
					// strong converge: near-cursor blocks collapse onto the cursor
					const shrink = 1 - t * 0.88;
					tx = mouseX + dx * shrink;
					ty = mouseY + dy * shrink;
					targetBright = t * 0.85; // glow while clustered
				}
				const ease = 0.1;
				b.x += (tx - b.x) * ease;
				b.y += (ty - b.y) * ease;
				b.bright += (targetBright - b.bright) * ease;
				const a = Math.min(b.alpha * MAX_ALPHA + b.bright, 0.9);
				if (a < 0.004) continue;
				// blocks grow while clustered
				const grow = 1 + (b.bright / 0.7) * 1.2;
				const s = BLOCK * grow;
				ctx.fillStyle = `rgba(${primary[0]}, ${primary[1]}, ${primary[2]}, ${a})`;
				ctx.fillRect(b.x - s / 2, b.y - s / 2, s, s);
			}
		}

		function loop() {
			draw();
			requestAnimationFrame(loop);
		}

		window.addEventListener("mousemove", (e) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
			mouseActive = true;
		});
		window.addEventListener("mouseleave", () => {
			mouseActive = false;
		});
		window.addEventListener("resize", resize);

		reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		readThemeColor();
		const observer = new MutationObserver(() => readThemeColor());
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"],
		});

		resize();
		if (!reduced) {
			requestAnimationFrame(loop);
		} else {
			draw();
		}
	})();
</script>
