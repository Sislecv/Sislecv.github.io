---
import { formatDate, getPostSlug, getPostUrl, getReadingTime, type Post } from "../lib/posts";
import { resolveMediaUrl } from "../lib/media";

interface Props {
	post: Post;
	featured?: boolean;
}

const { post } = Astro.props;
const featured = Astro.props.featured ?? false;
const url = getPostUrl(getPostSlug(post));
const cover = resolveMediaUrl(post.data.image);
---

<mdui-card clickable href={url} variant={featured ? "elevated" : "filled"} class:list={["bento-card", "tonal-post-card", { "post-featured": featured, "post-card": !featured }]}>
	<!-- Monoton Double-line Watermark -->
	<div class="post-card-watermark" aria-hidden="true">ARTICLE</div>
	{
		cover && (
			<div class="post-cover-wrap">
				<img src={cover} alt={post.data.title} loading="lazy" class="post-cover-img" />
			</div>
		)
	}
	{
		featured ? (
			<div class="card-body">
				<div class="post-meta">
					<mdui-icon-event--outlined style="font-size: 15px"></mdui-icon-event--outlined>
					<span>{formatDate(post.data.published)}</span>
					<span>·</span>
					<mdui-icon-schedule--outlined style="font-size: 15px"></mdui-icon-schedule--outlined>
					<span>{getReadingTime(post)}</span>
				</div>
				<h3 class="post-title-featured">{post.data.title}</h3>
				{post.data.description && <p class="post-desc">{post.data.description}</p>}
				<div class="tag-cloud" style="margin-top: auto; padding-top: 12px">
					{
						post.data.tags.slice(0, 4).map((tag) => (
							<mdui-chip variant="assist">{tag}</mdui-chip>
						))
					}
				</div>
			</div>
		) : (
			<div class="card-body">
				<div class="post-meta">
					<mdui-icon-event--outlined style="font-size: 14px"></mdui-icon-event--outlined>
					<span>{formatDate(post.data.published)}</span>
				</div>
				<h3 class="post-title">{post.data.title}</h3>
			</div>
		)
	}
</mdui-card>

<style>
	.tonal-post-card {
		position: relative;
		overflow: hidden;
		border: none !important;
		outline: none !important;
		background: #fbf8f3 !important;
		color: #2e2418 !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease) !important;
	}
	:global(.mdui-theme-dark) .tonal-post-card {
		background: #241e17 !important;
		color: #fbf8f3 !important;
	}

	.post-card-watermark {
		position: absolute;
		right: 10px;
		bottom: -14px;
		font-family: var(--font-double-line), monospace;
		font-size: 4rem;
		font-weight: 400;
		line-height: 0.85;
		color: currentColor;
		opacity: 0.05;
		letter-spacing: 0.05em;
		pointer-events: none;
		user-select: none;
		transition: opacity 0.3s ease;
	}
	.tonal-post-card:hover .post-card-watermark {
		opacity: 0.09;
	}

	.post-cover-wrap {
		width: 100%;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: rgba(var(--mdui-color-surface-container-highest), 0.35);
		border-top-left-radius: inherit;
		border-top-right-radius: inherit;
	}
	.post-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--md-duration-medium, 250ms) var(--md-easing-emphasized-decelerate, ease);
	}
	.bento-card:hover .post-cover-img {
		transform: scale(1.03);
	}
	.post-title,
	.post-title-featured {
		transition: color 0.2s ease;
	}
	.bento-card:hover .post-title,
	.bento-card:hover .post-title-featured {
		color: rgb(var(--mdui-color-primary));
	}
</style>
