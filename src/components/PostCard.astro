---
import { formatDate, getPostSlug, getPostUrl, getReadingTime, type Post } from "../lib/posts";
import { resolveMediaUrl } from "../lib/media";

interface Props {
	post: Post;
	featured?: boolean;
}

const { post } = Astro.props;
const featured = Astro.props.featured ?? false;
const url = getPostUrl(getPostSlug(post));
const cover = resolveMediaUrl(post.data.image);
---

<mdui-card clickable href={url} variant={featured ? "elevated" : "filled"} class:list={["bento-card", { "post-featured": featured, "post-card": !featured }]}>
	{
		cover && (
			<div class="post-cover-wrap">
				<img src={cover} alt={post.data.title} loading="lazy" class="post-cover-img" />
			</div>
		)
	}
	{
		featured ? (
			<div class="card-body">
				<div class="post-meta">
					<mdui-icon-event--outlined style="font-size: 15px"></mdui-icon-event--outlined>
					<span>{formatDate(post.data.published)}</span>
					<span>·</span>
					<mdui-icon-schedule--outlined style="font-size: 15px"></mdui-icon-schedule--outlined>
					<span>{getReadingTime(post)}</span>
				</div>
				<h3 class="post-title-featured">{post.data.title}</h3>
				{post.data.description && <p class="post-desc">{post.data.description}</p>}
				<div class="tag-cloud" style="margin-top: auto; padding-top: 12px">
					{
						post.data.tags.slice(0, 4).map((tag) => (
							<mdui-chip variant="assist">{tag}</mdui-chip>
						))
					}
				</div>
			</div>
		) : (
			<div class="card-body">
				<div class="post-meta">
					<mdui-icon-event--outlined style="font-size: 14px"></mdui-icon-event--outlined>
					<span>{formatDate(post.data.published)}</span>
				</div>
				<h3 class="post-title">{post.data.title}</h3>
			</div>
		)
	}
</mdui-card>

<style>
	.post-cover-wrap {
		width: 100%;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: rgba(var(--mdui-color-surface-container-highest), 0.35);
		border-top-left-radius: inherit;
		border-top-right-radius: inherit;
	}
	.post-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--md-duration-medium, 250ms) var(--md-easing-emphasized-decelerate, ease);
	}
	.bento-card:hover .post-cover-img {
		transform: scale(1.03);
	}
	.post-title,
	.post-title-featured {
		transition: color 0.2s ease;
	}
	.bento-card:hover .post-title,
	.bento-card:hover .post-title-featured {
		color: rgb(var(--mdui-color-primary));
	}
</style>
