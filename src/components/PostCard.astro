---
import { formatDate, getPostSlug, getPostUrl, getReadingTime, type Post } from "../lib/posts";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const url = getPostUrl(getPostSlug(post));
---

<mdui-card clickable href={url} variant="filled" class="bento-card post-card">
	<div class="card-body">
		<div class="post-meta">
			<span>{formatDate(post.data.published)}</span>
			<span>·</span>
			<span>{getReadingTime(post)}</span>
		</div>
		<h3 class="post-title">{post.data.title}</h3>
		{post.data.description && <p class="post-desc">{post.data.description}</p>}
		<div class="tag-cloud" style="margin-top: auto; padding-top: 10px">
			{
				post.data.tags.slice(0, 3).map((tag) => (
					<a href={`/tags/${encodeURIComponent(tag)}/`}>
						<mdui-chip variant="assist">{tag}</mdui-chip>
					</a>
				))
			}
		</div>
	</div>
</mdui-card>
