---
// Google Material You Pure Solid Clover (四叶草) Icon Search Widget
---

<mdui-card
	clickable
	id="search-trigger"
	variant="filled"
	class="bento-card pixel-clover-search-card"
	title="搜索 (⌘K)"
>
	<div class="clover-search-wrap">
		<!-- MD3 4-Leaf Clover (四叶草) Solid Graphic Container -->
		<div class="clover-shape-badge">
			<svg class="clover-svg" viewBox="0 0 100 100" aria-hidden="true">
				<path
					class="clover-path"
					d="M 50.00 4.00 C 62.00 4.00, 72.00 14.00, 72.00 26.00 C 72.00 34.00, 66.00 40.00, 60.00 44.00 C 66.00 40.00, 74.00 34.00, 86.00 34.00 C 94.00 34.00, 96.00 42.00, 96.00 50.00 C 96.00 58.00, 94.00 66.00, 86.00 66.00 C 74.00 66.00, 66.00 60.00, 60.00 56.00 C 66.00 60.00, 72.00 66.00, 72.00 74.00 C 72.00 86.00, 62.00 96.00, 50.00 96.00 C 38.00 96.00, 28.00 86.00, 28.00 74.00 C 28.00 66.00, 34.00 60.00, 40.00 56.00 C 34.00 60.00, 26.00 66.00, 14.00 66.00 C 6.00 66.00, 4.00 58.00, 4.00 50.00 C 4.00 42.00, 6.00 34.00, 14.00 34.00 C 26.00 34.00, 34.00 40.00, 40.00 44.00 C 34.00 40.00, 28.00 34.00, 28.00 26.00 C 28.00 14.00, 38.00 4.00, 50.00 4.00 Z"
				/>
			</svg>
			<!-- Icon Centered in Clover -->
			<div class="clover-center-icon">
				<mdui-icon-search--outlined class="search-symbol"></mdui-icon-search--outlined>
			</div>
		</div>

		<!-- Minimal shortcut pill indicator (No bulky text) -->
		<div class="clover-badge-pill">
			<span class="clover-kbd">⌘K</span>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-clover-search-card {
		height: 100%;
		border-radius: var(--mdui-shape-corner-extra-large, 28px) !important;
		border: 1px solid rgba(var(--mdui-color-outline-variant), 0.12) !important;
		outline: none !important;
		padding: 0 !important;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(var(--mdui-color-tertiary-container), 0.55) !important;
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            background-color var(--md-duration-short, 200ms) ease,
		            box-shadow var(--md-duration-short, 200ms) ease !important;
		overflow: hidden;
		user-select: none;
	}

	.pixel-clover-search-card:hover {
		transform: translateY(-2px);
		background: rgba(var(--mdui-color-tertiary-container), 0.8) !important;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
	}

	:global(.mdui-theme-dark) .pixel-clover-search-card:hover {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.32);
	}

	.clover-search-wrap {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		padding: 16px;
		box-sizing: border-box;
	}

	.clover-shape-badge {
		position: relative;
		width: 100px;
		height: 100px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform var(--md-duration-medium, 300ms) var(--md-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
	}

	.pixel-clover-search-card:hover .clover-shape-badge {
		transform: scale(1.08) rotate(6deg);
	}

	.clover-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 4px 12px rgba(var(--mdui-color-tertiary), 0.25));
	}

	:global(.mdui-theme-dark) .clover-svg {
		filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.4));
	}

	.clover-path {
		fill: rgb(var(--mdui-color-tertiary));
		transition: fill var(--md-duration-short, 200ms) ease;
	}

	.pixel-clover-search-card:hover .clover-path {
		opacity: 0.92;
	}

	.clover-center-icon {
		position: relative;
		z-index: 2;
		color: rgb(var(--mdui-color-on-tertiary));
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.search-symbol {
		font-size: 36px;
		transition: transform var(--md-duration-short, 200ms) ease;
	}

	.pixel-clover-search-card:hover .search-symbol {
		transform: scale(1.1);
	}

	.clover-badge-pill {
		position: absolute;
		bottom: 12px;
		right: 14px;
		padding: 3px 8px;
		border-radius: 9999px;
		background: rgba(var(--mdui-color-surface), 0.7);
		border: 1px solid rgba(var(--mdui-color-outline-variant), 0.2);
		font-family: var(--font-pixel), monospace;
		font-size: 0.68rem;
		font-weight: 700;
		color: rgb(var(--mdui-color-on-tertiary-container));
		letter-spacing: 0.05em;
	}
</style>