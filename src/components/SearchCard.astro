---
// Google Pixel Material You Stadium Pill Search Widget
---

<mdui-card clickable id="search-trigger" variant="filled" class="bento-card pixel-search-pill-card">
	<div class="pill-bar-wrapper">
		<!-- Left circular action badges -->
		<div class="pill-left-actions">
			<div class="pill-circle-btn p-btn-primary" title="搜索">
				<mdui-icon-search--outlined class="p-btn-icon"></mdui-icon-search--outlined>
			</div>
			<div class="pill-circle-btn p-btn-secondary" title="探索">
				<mdui-icon-auto-awesome--outlined class="p-btn-icon"></mdui-icon-auto-awesome--outlined>
			</div>
		</div>

		<!-- Center inset pill input field -->
		<div class="pill-inset-field">
			<span class="pill-placeholder">搜索文章、想法与灵感...</span>
			<span class="pill-emoji-accent">✨</span>
		</div>

		<!-- Right shortcut pill -->
		<div class="pill-right-badge">
			<span class="shortcut-text">⌘K</span>
		</div>
	</div>
</mdui-card>

<style>
	.pixel-search-pill-card {
		height: 100%;
		border-radius: 9999px !important;
		padding: 6px 10px !important;
		display: flex;
		align-items: center;
		background: #f3edf7 !important;
		border: 1px solid rgba(var(--mdui-color-outline-variant), 0.3) !important;
		transition: transform var(--md-duration-short, 200ms) var(--md-easing-standard, ease),
		            background-color var(--md-duration-short, 200ms) ease,
		            border-color var(--md-duration-short, 200ms) ease !important;
		box-sizing: border-box;
		overflow: hidden;
	}

	:global(.mdui-theme-dark) .pixel-search-pill-card {
		background: #2b2930 !important;
		border-color: rgba(255, 255, 255, 0.08) !important;
	}

	.pixel-search-pill-card:hover {
		transform: translateY(-2px);
		border-color: rgba(var(--mdui-color-primary), 0.35) !important;
		background: #ece6f0 !important;
	}

	:global(.mdui-theme-dark) .pixel-search-pill-card:hover {
		background: #332f37 !important;
	}

	.pill-bar-wrapper {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.pill-left-actions {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
	}

	.pill-circle-btn {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform var(--md-duration-short, 150ms) ease;
	}

	.p-btn-primary {
		background: #6750a4;
		color: #ffffff;
	}

	.p-btn-secondary {
		background: #e8def8;
		color: #4a4458;
	}

	:global(.mdui-theme-dark) .p-btn-secondary {
		background: #4a4458;
		color: #e8def8;
	}

	.pixel-search-pill-card:hover .pill-circle-btn {
		transform: scale(1.08);
	}

	.p-btn-icon {
		font-size: 16px;
	}

	.pill-inset-field {
		flex: 1;
		height: 36px;
		border-radius: 9999px;
		background: #ffffff;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 14px;
		box-sizing: border-box;
		border: 1px solid rgba(0, 0, 0, 0.06);
		transition: border-color var(--md-duration-short, 150ms) ease;
	}

	:global(.mdui-theme-dark) .pill-inset-field {
		background: #1d1b20;
		border-color: rgba(255, 255, 255, 0.08);
	}

	.pixel-search-pill-card:hover .pill-inset-field {
		border-color: rgba(var(--mdui-color-primary), 0.3);
	}

	.pill-placeholder {
		font-size: 0.85rem;
		font-weight: 500;
		color: #49454f;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.mdui-theme-dark) .pill-placeholder {
		color: #cac4d0;
	}

	.pill-emoji-accent {
		font-size: 14px;
		margin-left: 6px;
	}

	.pill-right-badge {
		flex-shrink: 0;
		padding: 3px 8px;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.06);
		font-size: 0.72rem;
		font-weight: 600;
		color: #49454f;
	}

	:global(.mdui-theme-dark) .pill-right-badge {
		background: rgba(255, 255, 255, 0.1);
		color: #cac4d0;
	}
</style>