---
import "@mdui/icons/search--outlined.js";
---

<mdui-card clickable id="search-trigger" variant="filled" class="bento-card sq-card">
	<div class="sq-body">
		<mdui-icon-search--outlined style="font-size: 40px; color: var(--mdui-color-primary)"></mdui-icon-search--outlined>
	</div>
</mdui-card>

<mdui-dialog id="search-dialog" style="width: min(680px, calc(100vw - 32px))">
	<div style="padding: 8px 4px 4px">
		<mdui-text-field id="search-input" class="search-box" label="搜索文章" clearable autofocus>
			<mdui-icon-search--outlined slot="icon"></mdui-icon-search--outlined>
		</mdui-text-field>
		<div id="search-status" style="margin-top: 12px; font-size: 0.85rem; color: var(--mdui-color-on-surface-variant)"></div>
		<div id="search-results" class="search-results"></div>
	</div>
</mdui-dialog>

<script is:inline>
	const trigger = document.getElementById("search-trigger");
	const dialog = document.getElementById("search-dialog");
	const input = document.getElementById("search-input");
	const status = document.getElementById("search-status");
	const resultsEl = document.getElementById("search-results");
	let pagefind = null;

	async function ensurePagefind() {
		if (!pagefind) {
			const mod = await import("/pagefind/pagefind.js");
			pagefind = mod.createInstance({ basePath: "/pagefind/", noWorker: true });
		}
		return pagefind;
	}

	async function doSearch(query) {
		if (!query.trim()) {
			status.textContent = "";
			resultsEl.innerHTML = "";
			return;
		}
		try {
			const pf = await ensurePagefind();
			status.textContent = "搜索中…";
			const search = await pf.search(query);
			status.textContent = `找到 ${search.results.length} 条结果`;
			const data = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
			resultsEl.innerHTML = "";
			for (const item of data) {
				const card = document.createElement("a");
				card.href = item.url;
				const title = item.meta?.title || item.url.split("/").filter(Boolean).pop() || "未命名";
				card.innerHTML = `<mdui-card variant="filled" clickable style="width:100%">
					<div style="padding: 14px 18px">
						<div style="font-weight:600;margin-bottom:4px">${title}</div>
						<div style="font-size:.85rem;color:var(--mdui-color-on-surface-variant);line-height:1.6">${item.excerpt || item.plain_excerpt || ""}</div>
					</div>
				</mdui-card>`;
				resultsEl.appendChild(card);
			}
			if (data.length === 0) status.textContent = "没有找到相关结果";
		} catch (e) {
			status.textContent = "搜索功能暂不可用";
			console.error(e);
		}
	}

	if (trigger && dialog) {
		trigger.addEventListener("click", () => {
			dialog.open = true;
			setTimeout(() => input?.focus(), 100);
		});
	}

	input?.addEventListener("input", () => doSearch(input.value));
</script>
