---
interface Props {
	value: string;
	label: string;
	href: string;
}

const { value, label, href } = Astro.props;
---

<mdui-card clickable href={href} variant="filled" class="bento-card">
	<div class="stat-block">
		<div class="stat-number">{value}</div>
		<div class="stat-label">{label}</div>
	</div>
</mdui-card>
