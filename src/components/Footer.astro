---
import { SITE, SOCIAL_LINKS } from "../consts";
---

<footer class="blog-footer">
	<div>
		<a href="/" class="footer-brand">
			© {new Date().getFullYear()} <span class="footer-author-art">{SITE.author}</span>
		</a>
	</div>
	<div style="display: flex; gap: 16px">
		{
			SOCIAL_LINKS.map((link) => (
				<a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer" class="footer-link">
					{link.label}
				</a>
			))
		}
	</div>
</footer>

<style>
	.footer-brand {
		font-weight: 500;
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.footer-author-art {
		font-family: var(--font-double-line), var(--font-sans);
		font-size: 1.15rem;
		letter-spacing: 0.05em;
		color: rgb(var(--mdui-color-primary));
	}
	.footer-link {
		font-size: 0.88rem;
		opacity: 0.85;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.footer-link:hover {
		opacity: 1;
		color: rgb(var(--mdui-color-primary));
	}
</style>
