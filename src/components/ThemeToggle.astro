---
import "@mdui/icons/light-mode.js";
import "@mdui/icons/dark-mode.js";
---

<mdui-icon-button id="theme-toggle" aria-label="切换主题" title="切换主题">
	<mdui-icon-dark-mode id="icon-dark" style="display: none"></mdui-icon-dark-mode>
	<mdui-icon-light-mode id="icon-light" style="display: none"></mdui-icon-light-mode>
</mdui-icon-button>

<script is:inline>
	const btn = document.getElementById("theme-toggle");
	if (btn) {
		const iconDark = document.getElementById("icon-dark");
		const iconLight = document.getElementById("icon-light");

		const isDark = () =>
			document.documentElement.classList.contains("mdui-theme-dark") ||
			(!document.documentElement.classList.contains("mdui-theme-light") &&
				window.matchMedia("(prefers-color-scheme: dark)").matches);

		const syncIcon = () => {
			const dark = isDark();
			iconDark.style.display = dark ? "" : "none";
			iconLight.style.display = dark ? "none" : "";
		};

		btn.addEventListener("click", () => {
			const html = document.documentElement;
			if (isDark()) {
				html.classList.remove("mdui-theme-dark");
				html.classList.add("mdui-theme-light");
				localStorage.setItem("theme", "light");
			} else {
				html.classList.remove("mdui-theme-light");
				html.classList.add("mdui-theme-dark");
				localStorage.setItem("theme", "dark");
			}
			syncIcon();
		});

		// Keep icon in sync with system theme changes while in auto mode
		window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncIcon);
		syncIcon();
	}
</script>
