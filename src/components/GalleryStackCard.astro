---
import { getFeaturedGalleryImages } from "../lib/gallery";
const IMAGES = await getFeaturedGalleryImages();
---

<mdui-card clickable href="/gallery/" variant="elevated" class="bento-card card-editorial-gallery">
	<!-- Editorial Typographic Watermark -->
	<div class="editorial-watermark" aria-hidden="true">SHOTS</div>

	<div class="card-body" style="position: relative; overflow: hidden">
		<div class="gallery-stack">
			{
				IMAGES.map((img, i) => (
					<img
						src={img.data.src}
						alt={img.data.alt}
						loading="lazy"
						class="gallery-stack-img"
						style={`--gi: ${i}`}
					/>
				))
			}
		</div>
		<div class="gallery-hint">
			<mdui-icon-collections--outlined style="font-size: 16px"></mdui-icon-collections--outlined>
		</div>
	</div>
</mdui-card>

<style>
	.card-editorial-gallery {
		position: relative;
		overflow: hidden;
		background: #d4e7ee !important; /* Pinterest Baby Sky Blue */
		color: #0d2833 !important;
	}
	:global(.mdui-theme-dark) .card-editorial-gallery {
		background: #172d36 !important; /* Deep Cyan Night */
		color: #d4e7ee !important;
	}

	.editorial-watermark {
		position: absolute;
		right: -8px;
		bottom: -15px;
		font-family: var(--font-double-line), var(--font-display);
		font-size: 5rem;
		font-weight: 400;
		line-height: 0.85;
		color: #0d2833;
		opacity: 0.055;
		letter-spacing: 0.05em;
		pointer-events: none;
		user-select: none;
		transition: opacity 0.3s ease;
	}
	:global(.mdui-theme-dark) .editorial-watermark {
		color: #d4e7ee;
		opacity: 0.09;
	}

	.card-editorial-gallery:hover .editorial-watermark {
		opacity: 0.08;
	}
</style>
