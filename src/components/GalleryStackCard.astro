---
import { getFeaturedGalleryImages } from "../lib/gallery";
const IMAGES = await getFeaturedGalleryImages();
---

<mdui-card clickable href="/gallery/" variant="elevated" class="bento-card card-editorial-gallery">
	<!-- Editorial Typographic Watermark -->
	<div class="editorial-watermark" aria-hidden="true">SHOTS</div>

	<div class="card-body" style="position: relative; overflow: hidden">
		<div class="gallery-stack">
			{
				IMAGES.map((img, i) => (
					<img
						src={img.data.src}
						alt={img.data.alt}
						loading="lazy"
						class="gallery-stack-img"
						style={`--gi: ${i}`}
					/>
				))
			}
		</div>
		<div class="gallery-hint">
			<mdui-icon-collections--outlined style="font-size: 16px"></mdui-icon-collections--outlined>
		</div>
	</div>
</mdui-card>

<style>
	.card-editorial-gallery {
		position: relative;
		overflow: hidden;
		background: rgba(var(--mdui-color-surface-container-high), 0.6) !important;
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.editorial-watermark {
		position: absolute;
		right: -8px;
		top: -10px;
		font-family: var(--font-display), var(--font-sans);
		font-size: 4.5rem;
		font-weight: 900;
		line-height: 1;
		color: rgb(var(--mdui-color-on-surface));
		opacity: 0.04;
		letter-spacing: -0.05em;
		pointer-events: none;
		user-select: none;
		transition: opacity 0.3s ease;
	}

	.card-editorial-gallery:hover .editorial-watermark {
		opacity: 0.08;
	}
</style>
