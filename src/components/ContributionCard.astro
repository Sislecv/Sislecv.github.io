---
import type { Post } from "../lib/posts";

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

const postDates = new Map<string, number>();
for (const post of posts) {
	const d = new Date(post.data.published);
	const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
	postDates.set(iso, (postDates.get(iso) ?? 0) + 1);
}

// Last 52 weeks x 7 days, ending today; weeks oldest -> newest, days Sunday -> Saturday
const DAY_MS = 86400000;
const today = new Date();
today.setHours(0, 0, 0, 0);
const WEEKS = 52;

const weeks: { date: Date; count: number }[][] = [];
for (let w = WEEKS - 1; w >= 0; w--) {
	const week: { date: Date; count: number }[] = [];
	for (let d = 0; d < 7; d++) {
		const date = new Date(today.getTime() - (w * 7 + (6 - d)) * DAY_MS);
		const iso = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
		week.push({ date, count: postDates.get(iso) ?? 0 });
	}
	weeks.push(week);
}

const levelColor = (count: number) =>
	count === 0
		? "rgb(var(--mdui-color-surface-container-highest))"
		: count >= 3
			? "#1a7f37"
			: count === 2
				? "#40c463"
				: "#9be9a8";
---

<mdui-card clickable href="/archive/" variant="elevated" class="bento-card">
	<div class="card-body">
		<div class="contrib-grid">
			{
				weeks.map((week) =>
					week.map((cell) => (
						<div
							class="contrib-cell"
							style={`background: ${levelColor(cell.count)}`}
							title={`${cell.date.toISOString().slice(0, 10)}${cell.count ? `：${cell.count} 篇` : ""}`}
							data-level={cell.count}
						></div>
					)),
				)
			}
		</div>
	</div>
</mdui-card>
