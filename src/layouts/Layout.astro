---
import { SITE } from "../consts";
import Footer from "../components/Footer.astro";
import FooterNav from "../components/FooterNav.astro";
import SearchDialog from "../components/SearchDialog.astro";

// MDUI global styles + KaTeX styles
import "mdui/mdui.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	showFooterNav?: boolean;
}

const { title, description, showFooterNav = true } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const pageDescription = description || SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="icon"
			type="image/png"
			sizes="192x192"
			href="/favicon/favicon-light-192.png"
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="192x192"
			href="/favicon/favicon-dark-192.png"
			media="(prefers-color-scheme: dark)"
		/>
		<script is:inline>
			// Apply persisted theme before paint to avoid flash
			(function () {
				try {
					var theme = localStorage.getItem("theme");
					if (theme === "dark") {
						document.documentElement.classList.add("mdui-theme-dark");
					} else if (theme === "light") {
						document.documentElement.classList.add("mdui-theme-light");
					} else {
						document.documentElement.classList.add("mdui-theme-auto");
					}
				} catch (e) {
					document.documentElement.classList.add("mdui-theme-auto");
				}
			})();
		</script>
	</head>
	<body>
		<div class="blog-container">
			<main>
				<slot />
			</main>
			{showFooterNav && <FooterNav />}
			<Footer />
		</div>
		<SearchDialog />
	</body>
</html>

<script>
	// Register MDUI components (bundled by Astro)
	import "mdui/components/card.js";
	import "mdui/components/icon.js";
	import "mdui/components/button-icon.js";
	import "mdui/components/chip.js";
	import "mdui/components/list.js";
	import "mdui/components/list-item.js";
	import "mdui/components/list-subheader.js";
	import "mdui/components/text-field.js";
	import "mdui/components/button.js";
	import "mdui/components/divider.js";
	import "mdui/components/dropdown.js";
	import "mdui/components/dialog.js";
	import "mdui/components/switch.js";
	import "mdui/components/circular-progress.js";
	import "mdui/components/linear-progress.js";

	// Material Design 3 blue color scheme (default), restore persisted pick
	import { setColorScheme } from "mdui";
	try {
		const saved = localStorage.getItem("scheme");
		setColorScheme(saved || "#0b57d0");
	} catch {
		setColorScheme("#0b57d0");
	}

	// Icons
	import "@mdui/icons/home--outlined.js";
	import "@mdui/icons/archive--outlined.js";
	import "@mdui/icons/tag--outlined.js";
	import "@mdui/icons/person--outlined.js";
	import "@mdui/icons/search--outlined.js";
	import "@mdui/icons/light-mode--outlined.js";
	import "@mdui/icons/dark-mode--outlined.js";
	import "@mdui/icons/chevron-right--outlined.js";
	import "@mdui/icons/chevron-left--outlined.js";
	import "@mdui/icons/folder--outlined.js";
	import "@mdui/icons/schedule--outlined.js";
	import "@mdui/icons/event--outlined.js";
	import "@mdui/icons/error--outlined.js";
	import "@mdui/icons/close--outlined.js";
	import "@mdui/icons/history--outlined.js";
	import "@mdui/icons/edit--outlined.js";
	import "@mdui/icons/rss-feed--outlined.js";
</script>
